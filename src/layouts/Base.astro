---
/**
 * Base.astro — layout de <head> y chrome de página de la landing.
 *
 * Sin analytics de terceros en la v1 (ver docs/planes/2026-08-20-landing-inversores.md, paso 10).
 *
 * Incluye HiloRuta (barra de navegación general, fija al borde izquierdo) y Escenario (la capa
 * fija de fondo + celular, docs/planes/2026-09-22-recomposicion-ui-vertical.md §14.7 paso 11 —
 * Paso 1.5 de §5). `<main>` contiene las 5 <Seccion> directamente, scroll de documento nativo —
 * reemplaza a la mecánica "cinta" (contenedor horizontal rotado, rotation hack + script de
 * suavizado de rueda, historial completo en el git log y la memoria del proyecto): un `transform`
 * en un ancestro le crea containing block a todo lo de adentro, así que `position: fixed` (la
 * base del escenario fijo) no funcionaba ahí dentro — el bloqueo real que forzó este rediseño.
 */
import '../styles/fuentes.css';
import '../styles/tokens.css';
import '../styles/base.css';
import Preloader from '../components/Preloader.astro';
import HiloRuta from '../components/HiloRuta.astro';
import Escenario from '../components/Escenario.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  // Copy de spot (pivot 2026-09-03, sin RENAMU ni enfoque de inversión — CLAUDE.md §§1-2, §5 D5 y
  // paso 12 del plan docs/planes/2026-09-04-reescritura-index-p1-p5.md). Propuesta del plan, a
  // confirmar con Ale — no hubo respuesta al momento de implementar, se usa el criterio por defecto.
  title = 'Sur en Ruta — Explorá. Conectá. Viví.',
  description = 'La app y la red que conecta a quien viaja con los puntos, servicios y rutas de Uruguay.',
} = Astro.props;

const urlCanonica = new URL(Astro.url.pathname, Astro.site ?? 'https://surenruta.uy');
const urlImagenOG = new URL('/og-image.png', Astro.site ?? 'https://surenruta.uy');
---

<!doctype html>
<html lang="es-UY">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		{/* Marca "JS activo" antes de pintar: sin esto, las animaciones de entrada (Hero) quedan
		   como estado inicial oculto si el JS no corre. Con .js las anima; sin .js, todo visible. */}
		<script is:inline>
			document.documentElement.classList.add('js');
			/* Red de seguridad: si el preloader no dispara `entrada` (JS roto, componente sacado),
			   igual se revela el contenido a los 4,5 s. El camino normal lo pone Preloader.astro
			   al abrir la cortina, mucho antes. */
			setTimeout(function () {
				document.documentElement.classList.add('entrada');
			}, 4500);
			/* Receptor temprano de la señal `listo` del demo (iframe de app-demo). Corre antes de
			   que exista el iframe, así que el aviso nunca se pierde por una carrera con los
			   módulos del padre. Lo escuchan Preloader.astro y telefono.ts. */
			window.addEventListener('message', function (e) {
				if (e.origin !== location.origin || !e.data || e.data.fuente !== 'sur-en-ruta') return;
				if (e.data.tipo === 'listo') {
					document.documentElement.dataset.demo = 'listo';
					window.dispatchEvent(new Event('sur-en-ruta:demo-listo'));
				}
			});
		</script>

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={urlCanonica} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<!-- TODO: falta generar og-image.png 1200x630 (no hay banco de imágenes propio todavía) -->
		<meta property="og:image" content={urlImagenOG} />
		<meta property="og:url" content={urlCanonica} />
		<meta property="og:locale" content="es_UY" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<!-- TODO: falta generar og-image.png 1200x630 (mismo archivo que Open Graph) -->
		<meta name="twitter:image" content={urlImagenOG} />

		<!--
			Tiene que ser el mismo hex que --color-fondo en src/styles/tokens.css. Un <meta> no
			puede leer un custom property de CSS, así que este valor se actualiza a mano cuando
			cambie la identidad — tocarlo junto con tokens.css.
		-->
		<meta name="theme-color" content="#f1f0ee" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />

		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<Preloader />
		<a href="#contenido-principal" class="skip-link">Saltar al contenido principal</a>
		<HiloRuta />
		<Escenario />
		<main id="contenido-principal">
			<slot />
		</main>
	</body>
</html>
