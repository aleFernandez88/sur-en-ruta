---
/**
 * Base.astro — layout de <head> y chrome de página de la landing de inversores.
 *
 * Sin analytics de terceros en la v1 (ver docs/planes/2026-08-20-landing-inversores.md, paso 10).
 *
 * Incluye HiloRuta, el trazo fijo que se dibuja con el scroll (no de una sección): vive acá y no
 * en Hero.astro porque es un elemento persistente, no de una sección.
 *
 * 2026-08-25 — migración a slide horizontal: .hz-viewport/.hz-track (ver base.css) envuelven el
 * <slot/> con el truco de rotación CSS que hace que el scroll vertical real se vea como un
 * avance horizontal — ver el comentario largo en base.css para la mecánica completa. HiloRuta
 * queda AFUERA de ese wrapper (sigue siendo un elemento fijo de toda la pantalla, no rotado) y
 * su timeline pasa de `scroll(root)` a un scroll-timeline con nombre anclado a .hz-track, porque
 * la página en sí ya no scrollea — ver HiloRuta.astro.
 */
import '../styles/tokens.css';
import '../styles/base.css';
import HiloRuta from '../components/HiloRuta.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Sur en Ruta — El país entero, en una sola red',
  description = 'Sur en Ruta: sistema nacional de turismo itinerante en Uruguay. Plan de inversión para la Etapa 1: validar el sistema en 90 días.',
} = Astro.props;

const urlCanonica = new URL(Astro.url.pathname, Astro.site ?? 'https://surenruta.uy');
const urlImagenOG = new URL('/og-image.png', Astro.site ?? 'https://surenruta.uy');
---

<!doctype html>
<html lang="es-UY">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={urlCanonica} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<!-- TODO: falta generar og-image.png 1200x630 (no hay banco de imágenes propio todavía) -->
		<meta property="og:image" content={urlImagenOG} />
		<meta property="og:url" content={urlCanonica} />
		<meta property="og:locale" content="es_UY" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<!-- TODO: falta generar og-image.png 1200x630 (mismo archivo que Open Graph) -->
		<meta name="twitter:image" content={urlImagenOG} />

		<!--
			PROVISORIO: tiene que ser el mismo hex que --color-fondo en src/styles/tokens.css. Un
			<meta> no puede leer un custom property de CSS, así que este valor se actualiza a mano
			en el paso 13 (identidad definitiva) — no se olvida de tocarlo junto con tokens.css.
		-->
		<meta name="theme-color" content="#f3f1ec" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />

		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<a href="#contenido-principal" class="skip-link">Saltar al contenido principal</a>
		<HiloRuta />
		<div class="hz-viewport">
			<div class="hz-track">
				<slot />
			</div>
		</div>
	</body>
</html>
