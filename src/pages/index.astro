---
/**
 * index.astro — landing de Sur en Ruta. Ensambla las 5 pantallas fijadas por el pivot de
 * audiencia del 2026-08-26 (ver docs/planes/2026-08-26-pivot-audiencia-general.md y
 * docs/landing-contenido.md): Hero → Problema/Oportunidad → Mapa y servicios → Rutas/Pasaporte →
 * Centro Regional.
 *
 * Mecánica de transición ("cinta", ver Pantalla.astro y base.css — reemplaza a la de "hoja que
 * tapa y descubre" probada antes el mismo día): cada pantalla es una tarjeta al 82% de la
 * pantalla, salvo el Hero (`completa`), que pega fuerte a pantalla completa. Probada en
 * prototipos/efecto-cinta/index.html, portada acá el 2026-08-26.
 *
 * Solo Hero tiene contenido real todavía — las otras 4 son SlidePlaceholder mientras se recorta
 * el copy de docs/landing-contenido.md a una pantalla cada una (se van reemplazando una por una,
 * sin volver a tocar este archivo en cada paso, mismo criterio que en la migración anterior).
 */
import Base from '../layouts/Base.astro';
import Pantalla from '../components/Pantalla.astro';
import Hero from '../components/Hero.astro';
import SlidePlaceholder from '../components/SlidePlaceholder.astro';
// import Problema from '../components/Problema.astro';
// import Sistema from '../components/Sistema.astro';
// import Rutas from '../components/Rutas.astro';
// import Inversion from '../components/Inversion.astro';
---

<Base>
	<Pantalla id="hero" completa>
		<Hero />
	</Pantalla>
	<Pantalla id="problema">
		<SlidePlaceholder color="var(--color-ruta-vino)" etiqueta="2 — Problema/Oportunidad + Sello" />
	</Pantalla>
	<Pantalla id="mapa">
		<SlidePlaceholder color="var(--color-ruta-oceanica)" etiqueta="3 — Mapa y servicios" />
	</Pantalla>
	<Pantalla id="rutas">
		<SlidePlaceholder color="var(--color-ruta-rural)" etiqueta="4 — Rutas + Pasaporte" />
	</Pantalla>
	<Pantalla id="centro-regional">
		<SlidePlaceholder color="var(--color-ruta-naturaleza)" etiqueta="5 — Centro Regional" />
	</Pantalla>
</Base>
