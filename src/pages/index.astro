---
/**
 * index.astro — landing de Sur en Ruta. Ensambla el recorrido definido por el pivot de audiencia
 * del 2026-08-26 (ver docs/planes/2026-08-26-pivot-audiencia-general.md y
 * docs/landing-contenido.md): Portada (Sección 0) → 1 Problema/Oportunidad → 2 Mapa y servicios →
 * 3 Rutas/Pasaporte → 4 Centro Regional.
 *
 * 2026-08-27: se levantó la regla de "exactamente 5 pantallas, sin partir ninguna". Cada sección
 * de contenido puede ocupar 1 o más <Pantalla> de la "cinta" (se decide al implementarla) — la
 * mecánica no tiene tope de cantidad.
 *
 * 2026-08-27 (noche): se decidió seguir el mazo de Ana (10 páginas) 1:1 — ver
 * docs/landing-contenido.md. Se armará pantalla por pantalla, guiado por Ale, no todo de una vez.
 * Por ahora solo la Portada (Pantalla 0) tiene contenido real; el resto son SlidePlaceholder.
 *
 * Mecánica de transición ("cinta", ver Pantalla.astro y base.css): cada pantalla es una tarjeta
 * al 82% del viewport, salvo el Hero (`completa`), que pega fuerte a pantalla completa.
 */
import Base from '../layouts/Base.astro';
import Pantalla from '../components/Pantalla.astro';
import Hero from '../components/Hero.astro';
import Lamina from '../components/Lamina.astro';
import SlidePlaceholder from '../components/SlidePlaceholder.astro';
import Icono from '../components/Icono.astro';
import logoUrl from '../assets/logo/isotipo-original.svg?url';
import { Image } from 'astro:assets';
// PLACEHOLDER, no deployar así — trae el logo de Dometic visible y no es Uruguay. Ver
// src/assets/oportunidad/FUENTE.md. Pasada por Ale el 2026-08-28 para probar layout + parallax
// mientras se consigue la foto real ("camper en ruta costera", docs/landing-contenido.md § P.1).
import fotoOportunidad from '../assets/oportunidad/camping-placeholder.png';

/* === Animaciones de entrada de Pantalla 1 (2026-08-28) ===
 * Pedido de Ale: "mejores que fade in". Reveal enmascarado (overflow:hidden + translateY, ver
 * @keyframes texto-sube en el <style>) por LÍNEA para el wordmark grande (2 líneas cortas) y por
 * PALABRA para los párrafos (mismo espíritu que el "text splitting" de sitios premiados — ver
 * memoria del proyecto). Atado al mismo --hz-progreso que ya usa el parallax de la foto.
 *
 * OJO — tres gotchas reales encontrados en vivo, en direcciones distintas:
 * 1. La tarjeta de una pantalla `completa` NO se queda quieta en ningún momento — se desliza 1:1
 *    con el scroll TODO el tiempo, sin pausa. Solo hay un INSTANTE en que queda perfectamente
 *    centrada (getBoundingClientRect a distintos %: para Pantalla 1, 26.0% exacto), pero se
 *    mantiene SUSTANCIALMENTE visible (>60-80% del viewport) en un rango bastante más amplio,
 *    medido en vivo: ~17% a ~35% (ver ventanaScroll de <Lamina> más abajo).
 * 2. Una ventana DEMASIADO angosta (~1.3 puntos ≈ 9px de scroll real, primer intento) es MENOS
 *    que un solo tick de rueda de mouse — el usuario scrolleaba una vez y todo aparecía de golpe,
 *    sin frames intermedios. Necesita cientos de px reales (1% ≈ 61px acá) para verse progresiva.
 * 3. Una ventana que TERMINA DESPUÉS del instante de centrado (26%) hace que el usuario "llegue"
 *    a la pantalla con la entrada todavía a mitad de camino — reportado por Ale como "tengo que
 *    pasar media pantalla para ver todo, en el momento exacto solo se ve la primera letra". La
 *    secuencia entera tiene que TERMINAR antes o justo en el instante de centrado, no extenderse
 *    después — por eso arranca bien antes (15%) y termina en el centrado (25.8%), no [20,32].
 */
function rangoPalabra(inicio: number, indice: number, paso: number, duracion: number): string {
	const desde = inicio + indice * paso;
	return `${desde.toFixed(2)}% ${(desde + duracion).toFixed(2)}%`;
}

const RENAMU_RANGO = '15% 16%';
const SURENRUTA_RANGO = '15.7% 16.7%';

const BAJADA_TEXTO = 'Una red para ordenar y potenciar el turismo itinerante en Uruguay';
const BAJADA_INICIO = 16.9;
const BAJADA_PASO = 0.34;
const BAJADA_DURACION = 0.65;
// split con grupo de captura: alterna palabra/espacio/palabra/... el espacio se renderiza tal
// cual (sin animación) para no romper el ajuste de línea natural del párrafo.
const bajadaPartes = BAJADA_TEXTO.split(/(\s+)/).filter((p) => p !== '');

interface Segmento {
	texto: string;
	resaltado: boolean;
}
// Cita textual del mazo (ver docs/comparativa-mazo-vs-landing.md) — las 4 palabras ya venían
// resaltadas ahí. Se arma por segmentos (no un solo string) para poder aplicar el reveal
// palabra por palabra SIN perder el resaltado de esas 4.
const CONECTA_SEGMENTOS: Segmento[] = [
	{ texto: 'Una propuesta que conecta ', resaltado: false },
	{ texto: 'viajeros', resaltado: true },
	{ texto: ', ', resaltado: false },
	{ texto: 'territorios', resaltado: true },
	{ texto: ', ', resaltado: false },
	{ texto: 'servicios', resaltado: true },
	{ texto: ' y ', resaltado: false },
	{ texto: 'experiencias', resaltado: true },
	{ texto: '.', resaltado: false },
];
interface Palabra {
	texto: string;
	resaltado: boolean;
	esEspacio: boolean;
}
const conectaPalabras: Palabra[] = [];
for (const segmento of CONECTA_SEGMENTOS) {
	if (segmento.resaltado) {
		conectaPalabras.push({ texto: segmento.texto, resaltado: true, esEspacio: false });
		continue;
	}
	for (const parte of segmento.texto.split(/(\s+)/)) {
		if (parte === '') continue;
		conectaPalabras.push({ texto: parte, resaltado: false, esEspacio: parte.trim() === '' });
	}
}
const CONECTA_INICIO = 21.4;
const CONECTA_PASO = 0.31;
const CONECTA_DURACION = 0.55;
const ICONO_RANGO = '24.5% 25.3%';
---

<Base>
	<Pantalla id="hero" completa>
		<Hero />
	</Pantalla>
	<Pantalla id="oportunidad" completa>
		<!-- anclaCentro=25: % de --hz-progreso en que ESTA tarjeta queda perfectamente centrada,
		     MEDIDO en vivo (getBoundingClientRect a varios %: card.left = 430px a 18%, 62px a 24%
		     → pendiente −61px/punto → cruza 0 en 25.0%). NO la fórmula de "N bloques iguales" (que
		     daba 26 y quedaba corrido). La foto queda anclada al viewport entre 25−anclaRadio y
		     25%. Recalcular cuando pase a ~10 pantallas (anclaCentro y pasoCintaVw), en vivo. -->
		<Lamina indice={0} anclaCentro={25}>
			<!-- Primer elemento de Pantalla 1 (2026-08-28, guiado por Ale): el wordmark + bajada de
			     la página 1 del mazo ("RENAMU / SUR EN RUTA" + "Una red para ordenar y potenciar el
			     turismo itinerante en Uruguay") — se había sacado del Hero (Pantalla 0) pero nunca
			     se integró acá, ver docs/comparativa-mazo-vs-landing.md § Página 1. Todavía falta el
			     resto de Pantalla 1 (título LA/OPORTUNIDAD, bloques, chips, cierre, foto) — se suma
			     elemento por elemento, no todo junto (ver memoria del proyecto). -->
			<div class="marca-institucional">
				<p class="marca-renamu">
					<span class="reveal-mascara">
						<span class="reveal-interior" style={`animation-range: ${RENAMU_RANGO}`}>
							RENAMU /
						</span>
					</span>
				</p>
				<p class="marca-sur-en-ruta">
					<span class="reveal-mascara">
						<span class="reveal-interior" style={`animation-range: ${SURENRUTA_RANGO}`}>
							Sur en Ruta
						</span>
					</span>
				</p>
				<p class="marca-bajada">
					{bajadaPartes.map((parte, indice) =>
						parte.trim() === '' ? (
							parte
						) : (
							<span class="reveal-mascara">
								<span
									class="reveal-interior"
									style={`animation-range: ${rangoPalabra(BAJADA_INICIO, indice, BAJADA_PASO, BAJADA_DURACION)}`}
								>
									{parte}
								</span>
							</span>
						),
					)}
				</p>
				<!-- Frase final de la página 1 del mazo, con el ícono "comunidad" a la derecha
				     (ver docs/comparativa-mazo-vs-landing.md § Página 1 — cita textual, las 4
				     palabras ya vienen resaltadas ahí). -->
				<div class="marca-conecta-fila">
					<p class="marca-conecta">
						{(() => {
							let indicePalabra = -1;
							return conectaPalabras.map((palabra) => {
								if (palabra.esEspacio) return palabra.texto;
								indicePalabra++;
								return (
									<span class="reveal-mascara">
										<span
											class={
												palabra.resaltado
													? 'reveal-interior marca-conecta-resaltado'
													: 'reveal-interior'
											}
											style={`animation-range: ${rangoPalabra(CONECTA_INICIO, indicePalabra, CONECTA_PASO, CONECTA_DURACION)}`}
										>
											{palabra.texto}
										</span>
									</span>
								);
							});
						})()}
					</p>
					<span class="marca-conecta-icono" style={`animation-range: ${ICONO_RANGO}`}>
						<Icono nombre="comunidad" tamano={64} acento="var(--color-verde)" />
					</span>
				</div>
			</div>

			<!-- Foto con corte en curva S (2026-08-28) — llena el espacio vacío a la derecha que
			     notó Ale. Placeholder (ver import arriba), pendiente la foto real. -->
			<Image
				slot="foto"
				src={fotoOportunidad}
				alt=""
				widths={[400, 700, 1000]}
				sizes="42vw"
			/>

			<!-- Pie del footer (2026-08-28, guiado por Ale): logo en badge circular blanco + columna
			     "Sur en Ruta" / eslogan (ver Preloader.astro `ESLOGAN`) al lado — el eslogan vivía
			     suelto a la derecha, se trajo debajo del nombre. Probando la fuente de RENAMU acá. -->
			<div slot="footer" class="pie-footer">
				<div class="pie-marca">
					<span class="pie-logo">
						<img src={logoUrl} alt="" width="64" height="58" />
					</span>
					<div class="pie-texto">
						<span class="pie-nombre">Sur en Ruta</span>
						<p class="pie-eslogan">CONECTA - ORDENA - POTENCIA</p>
					</div>
				</div>
			</div>
		</Lamina>
	</Pantalla>
	<Pantalla id="mapa">
		<SlidePlaceholder color="var(--color-ruta-oceanica)" etiqueta="2 — Mapa y servicios" />
	</Pantalla>
	<Pantalla id="rutas">
		<SlidePlaceholder color="var(--color-ruta-rural)" etiqueta="3 — Rutas + Pasaporte" />
	</Pantalla>
	<Pantalla id="centro-regional">
		<SlidePlaceholder color="var(--color-ruta-naturaleza)" etiqueta="4 — Centro Regional" />
	</Pantalla>
</Base>

<style>
	/* === Marca institucional — Pantalla 1, primer elemento (2026-08-28) ===
	 * 3 piezas separadas a propósito (no un solo bloque de texto) para poder animarlas cada una
	 * por su cuenta más adelante, si hace falta — pedido explícito de Ale.
	 */
	.marca-institucional {
		display: flex;
		flex-direction: column;
		gap: var(--espacio-xs);
	}

	/* "RENAMU /" — necesita una fuente GRUESA/institucional que no es --fuente-marca (Italiana es
	 * un solo peso 400, un bold sintético del navegador se vería mal en un Didone). Se reusa
	 * --fuente-display (Archivo, ya cargada para el Hero) — peso 800 (bajado un escalón desde 900,
	 * pedido de Ale 2026-08-28) en vez de sumar una familia nueva solo para esta palabra. Tamaño
	 * casi al doble del primer intento. Color celeste (2026-08-28, swap de color con "Sur en Ruta"
	 * de abajo). */
	.marca-renamu {
		margin: 0;
		font-family: var(--fuente-display);
		font-weight: 800;
		font-size: clamp(3.5rem, 1.8rem + 6.5vw, 7.5rem);
		line-height: 1;
		color: var(--color-celeste);
	}

	/* "Sur en Ruta" — misma fuente que el título del Preloader (--fuente-marca, Italiana,
	 * mayúsculas por CSS), un toque más grande que "RENAMU". Peso 700 (bold sintético del
	 * navegador — Italiana no tiene un corte bold real, pero probado en vivo se banca bien a este
	 * tamaño) y color marino (swap con "RENAMU" de arriba) — pedido de Ale 2026-08-28. Tracking y
	 * espaciado entre palabras bajados respecto del primer intento (0.06em → 0.015em, más
	 * word-spacing negativo), quedaba demasiado abierto a este tamaño tan grande. */
	.marca-sur-en-ruta {
		margin: 0;
		font-family: var(--fuente-marca);
		font-weight: 700;
		font-size: clamp(3.75rem, 2rem + 7vw, 8.25rem);
		line-height: 1;
		text-transform: uppercase;
		letter-spacing: 0.015em;
		word-spacing: -0.15em;
		color: var(--color-marino);
	}

	/* Bajada — misma fuente que el Hero (--fuente-display, Archivo) pero peso 500, pedido de Ale.
	 * Agrandada 2026-08-28 para que el renglón ocupe ~el mismo ancho que "RENAMU /" / "SUR EN
	 * RUTA" de arriba. Tamaño fijo (pedido puntual de Ale, no clamp) — bajado de 3rem a 2.12rem. */
	.marca-bajada {
		margin: var(--espacio-md) 0 0;
		font-family: var(--fuente-display);
		font-weight: 500;
		font-size: 2.12rem;
		line-height: 1.25;
		max-width: 26ch;
		color: var(--color-tinta);
	}

	/* Frase + ícono, lado a lado — ícono a la DERECHA (pedido de Ale). */
	.marca-conecta-fila {
		display: flex;
		align-items: center;
		gap: var(--espacio-md);
		margin-top: var(--espacio-md);
	}

	/* Cuerpo de texto (--fuente-texto, no --fuente-display) — es una cita de apoyo, no un
	 * enunciado display como los de arriba. Más chica que --marca-bajada (3rem). Las 4 palabras
	 * clave ya vienen resaltadas en la cita del mazo (ver docs/comparativa-mazo-vs-landing.md) —
	 * verde/oliva es el color de "palabras resaltadas" en todo el sitio (identidad-visual.md). */
	.marca-conecta {
		margin: 0;
		font-family: var(--fuente-texto);
		font-weight: 400;
		font-size: var(--texto-lg);
		line-height: 1.4;
		max-width: 36ch;
		color: var(--color-tinta);
	}

	/* Antes era un <strong>, ahora es un <span> (el reveal por palabra necesita envolver cada
	 * palabra en su propia máscara, ver .reveal-mascara) — mismo color/peso que antes. */
	.marca-conecta-resaltado {
		font-weight: 700;
		color: var(--color-verde);
	}

	/* === Reveal de entrada, por línea o por palabra (2026-08-28) ===
	 * "Mejor que fade in" — pedido de Ale. Máscara (overflow:hidden) + el texto real adentro
	 * arrancando debajo (translateY) y subiendo a su lugar — técnica de "text splitting" de sitios
	 * premiados, no una simple opacidad. Atado al mismo --hz-progreso que ya usa el parallax de la
	 * foto (ver Lamina.astro) — cada instancia trae su propio animation-range inline (ver arriba,
	 * calculado en el frontmatter), esta clase solo define la MECÁNICA, no los tiempos. */
	/* inline-block, NO block — tiene que poder flotar en línea junto a otras palabras/espacios y
	 * ajustar de renglón con el resto del párrafo (bajada, frase "conecta"); con block, cada
	 * palabra se iba a su propia línea y rompía el párrafo entero (bug real, encontrado en vivo). */
	.reveal-mascara {
		display: inline-block;
		overflow: hidden;
		vertical-align: bottom;
	}

	.reveal-interior {
		display: inline-block;
		transform: translateY(115%);
	}

	@supports (animation-timeline: scroll(root)) {
		.reveal-interior {
			animation: texto-sube linear both;
			animation-timeline: --hz-progreso;
		}
	}

	@keyframes texto-sube {
		from {
			transform: translateY(115%);
		}
		to {
			transform: translateY(0%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.reveal-interior {
			animation: none !important;
			transform: translateY(0);
		}
	}

	/* Ícono "comunidad" — en vez de sumarse al reveal de texto (no es texto), entra con un scale
	 * con rebote — distinto de fade/slide, pedido de Ale de "algo mejor que fade in" aplica acá
	 * también. Mismo mecanismo (--hz-progreso + animation-range inline). */
	.marca-conecta-icono {
		display: inline-flex;
		transform: scale(0);
	}

	@supports (animation-timeline: scroll(root)) {
		.marca-conecta-icono {
			animation: icono-rebote linear both;
			animation-timeline: --hz-progreso;
		}
	}

	@keyframes icono-rebote {
		0% {
			transform: scale(0);
		}
		60% {
			transform: scale(1.25);
		}
		80% {
			transform: scale(0.92);
		}
		100% {
			transform: scale(1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.marca-conecta-icono {
			animation: none !important;
			transform: scale(1);
		}
	}

	/* === Pie del footer de Lamina (2026-08-28) ===
	 * La onda tiene UN período de seno completo por pantalla (ver Lamina.astro): la cresta (más
	 * aire, navy más alto) cae en x=25% del ancho. Posicionamos a mano con % en vez de flexbox de
	 * ancho completo porque necesitamos calzar CON esa geometría: todo el grupo (logo + nombre +
	 * eslogan) centrado en la cresta, ahí donde hay más aire arriba para el logo grande.
	 * El eslogan vivía suelto a la derecha (en el valle, x=75%) — Ale pidió traerlo debajo de "Sur
	 * en Ruta" en vez de dejarlo aparte.
	 */
	.pie-footer {
		position: relative;
		height: 100%;
	}

	.pie-marca {
		position: absolute;
		left: 25%;
		bottom: clamp(0.75rem, 2vh, 1.25rem);
		transform: translateX(-50%);
		display: flex;
		align-items: center;
		gap: var(--espacio-sm);
	}

	/* Badge circular blanco — el isotipo no es circular en sí (es una insignia con colina/ruta/
	 * camper), pero adentro de un círculo blanco se lee como un logo "de coin/sello", coherente
	 * con el Sello Viajero Responsable que ya es circular. object-fit:contain deja aire parejo.
	 * Al doble del primer intento (3rem → 6rem), pedido de Ale. */
	.pie-logo {
		flex-shrink: 0;
		width: 6rem;
		height: 6rem;
		border-radius: 50%;
		background: var(--color-superficie);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}

	.pie-logo img {
		width: 78%;
		height: 78%;
		object-fit: contain;
	}

	/* Columna nombre + eslogan, al lado del logo. Nudge hacia arriba (translateY negativo, pedido
	 * de Ale "subilo un poco") relativo al centrado vertical con el logo. */
	.pie-texto {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		transform: translateY(-0.35rem);
	}

	/* "Sur en Ruta" — misma fuente/peso que arriba (--fuente-marca, Italiana 700), en blanco.
	 * Agrandada casi al doble (1.15rem → 2.2rem), pedido de Ale 2026-08-28. */
	.pie-nombre {
		font-family: var(--fuente-marca);
		font-weight: 700;
		font-size: 2.2rem;
		line-height: 1;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		color: var(--color-texto-sobre-foto);
		white-space: nowrap;
	}

	/* Eslogan del mazo — probando la fuente de "RENAMU" (--fuente-display, Archivo 800). Ahora
	 * debajo de "Sur en Ruta" (antes suelto a la derecha del footer, en el valle de la onda). */
	.pie-eslogan {
		margin: 0;
		font-family: var(--fuente-display);
		font-weight: 800;
		font-size: 0.9rem;
		letter-spacing: 0.08em;
		white-space: nowrap;
		color: var(--color-texto-sobre-foto);
	}
</style>
