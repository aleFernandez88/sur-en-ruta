	.como-isotipo {
		width: clamp(9rem, 8vw + 6rem, 15rem);
		height: auto;
		flex-shrink: 0;
	}

	/* === Título de P3 — "¿Qué es" chico + título en UNA línea (2026-09-01, 2ª pasada) ===
	 * "¿Qué es" es solo el lead-in de la pregunta, no el título — mucho más chico. El título ya no
	 * son 2 `<p class="op-titulo">` en bloque (una línea cada uno, como P2): pasa a un solo `<p>`
	 * con 2 `<span>` inline, para liberar espacio vertical y agrandar los nodos/tarjetas de abajo
	 * (pedido de Ale). Tamaño bajado bastante respecto de `.op-titulo` (tope 5rem) porque ahora las
	 * 2 palabras comparten renglón. */
	.sis-titulo-eyebrow {
		margin: 0 0 var(--espacio-2xs);
		font-family: var(--fuente-texto);
		font-weight: 600;
		font-size: clamp(1rem, 0.9rem + 0.3vw, 1.2rem);
		color: var(--color-marino);
	}

	.sis-titulo-linea {
		margin: 0;
		line-height: 0.95;
	}

	/* "RENAMU /" — celeste (subrayado propio, `.op-titulo--l2::after` no aplica a un <span>
	 * inline). Mismo par tipográfico que el resto del título del sitio (Archivo 800). Color:
	 * regla de marca (2026-09-01, Ale) — "RENAMU" es SIEMPRE el celeste de `.marca-renamu` (P1,
	 * Portada), cada vez que aparece, no solo ahí. Antes era verde acá (parte del intercambio de
	 * colores RENAMU/Sur en Ruta pedido el mismo día) — Ale aclaró después que el celeste de P1 es
	 * el color de marca correcto para "RENAMU", no el verde. */
	.sis-titulo-renamu {
		position: relative;
		font-family: var(--fuente-display);
		font-weight: 800;
		font-size: clamp(2rem, 1.3rem + 3vw, 3.75rem);
		text-transform: uppercase;
		color: var(--color-celeste);
		/* Aire hacia "Sur en Ruta?" — el espacio del source solo no alcanza, la letra siguiente
		 * (Italiana, con word-spacing negativo) queda pegada. */
		margin-right: 0.3em;
	}

	.sis-titulo-renamu::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: -0.4rem;
		width: 2.75rem;
		height: 0.3rem;
		border-radius: 999px;
		background: var(--color-celeste);
	}

	/* "Sur en Ruta?" — SIEMPRE azul de la paleta (nunca verde, pedido de Ale) + tipografía de marca
	 * (--fuente-marca, Italiana, la misma que usa el wordmark de la Portada en
	 * `.marca-sur-en-ruta`) — mismo tratamiento de letter/word-spacing que allá, ese Didone necesita
	 * el ajuste o se lee demasiado abierto a este tamaño. */
	.sis-titulo-marca {
		font-family: var(--fuente-marca);
		font-weight: 700;
		font-size: clamp(2rem, 1.3rem + 3vw, 3.75rem);
		text-transform: uppercase;
		letter-spacing: 0.015em;
		word-spacing: -0.15em;
		color: var(--color-marino);
	}

	/* === Nodos de P3 (RENAMU / Sur en Ruta), 3ª pasada (2026-09-01) — estructura propia, ya NO
	 * reusa `.op-bloques/.op-bloque*` de P2 ===
	 * Ale pasó una captura de referencia del mazo (pág. 3) y pidió replicar esa estructura:
	 * badge circular RELLENO (no un aro fino con ícono chico adentro) + nombre grande en su propio
	 * renglón + descripción más chica debajo (no todo en una oración con guión) + un conector con
	 * ícono de eslabón entre los 2 nodos (no solo la divisoria punteada de P2). "Sur en Ruta"
	 * conserva su tipografía/color de marca ya decididos (Italiana, azul — nunca verde) cada vez
	 * que se nombra, acá también; "RENAMU" usa el mismo tratamiento que en el título (Archivo 800,
	 * verde). */
	/* `justify-content: center` + `.sis-nodo` sin `flex:1` (2026-09-01, pedido de Ale: "centralos
	 * mejor que se junten al ícono de unión del medio") — antes cada nodo ocupaba TODO el espacio
	 * sobrante a cada lado del conector (flex:1), quedando pegados a los bordes izq/der en vez de
	 * agrupados alrededor del nodo central. Ahora cada uno mide lo que su contenido necesita y el
	 * conjunto se centra como grupo. */
	.sis-nodos {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: clamp(1rem, 3vw, 2rem);
		width: 100%;
		margin-top: clamp(1rem, 3vh, 1.75rem);
		position: relative;
		z-index: 1;
	}

	.sis-nodo {
		display: flex;
		align-items: center;
		gap: var(--espacio-sm);
		flex: 0 1 auto;
		min-width: 0;
	}

	/* Entrada desde arriba, al mando del scroll (2026-09-01, pedido de Ale) — anima el BLOQUE
	 * entero (ícono + nombre + texto juntos), no solo el ícono; sin opacity (texto siempre nítido,
	 * misma regla que la cabecera de P2). `animation-range` va inline (`rangoSisNodo`, calculado
	 * en el frontmatter) — mismo motivo que el resto de los rangos de esta pantalla. */
	@supports (animation-timeline: scroll(root)) {
		.sis-nodo {
			transform: translateY(-3rem);
			animation: sis-nodo-entra linear both;
			animation-timeline: --hz-progreso;
		}
	}

	@keyframes sis-nodo-entra {
		from {
			transform: translateY(-3rem);
		}
		to {
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.sis-nodo {
			animation: none !important;
			transform: none;
		}
	}

	/* Badge relleno (antes: aro fino verde con ícono chico) — Ícono en blanco (currentColor), sin
	 * `acento` — sobre un fondo sólido no hace falta 2ª tinta. */
	.sis-nodo-badge {
		flex-shrink: 0;
		width: clamp(4.5rem, 4vw + 3rem, 6.5rem);
		height: clamp(4.5rem, 4vw + 3rem, 6.5rem);
		border-radius: 50%;
		display: grid;
		place-items: center;
		color: var(--color-superficie);
	}

	.sis-nodo-badge--renamu {
		background: var(--color-marino);
	}

	/* Celeste — pedido puntual de Ale 2026-09-01 para el fondo del ícono/logo de "Sur en Ruta" acá
	 * (antes verde). Puntual al badge — el TEXTO "Sur en Ruta" sigue con su regla de marca propia
	 * (navy o blanco, nunca celeste ni verde, ver `.sis-titulo-marca`/`.sis-nodo-nombre--surenruta`
	 * y [[proyecto-renamu-identidad-color]]) — este cambio no la toca. */
	.sis-nodo-badge--surenruta {
		background: var(--color-celeste);
	}

	/* `max-width` (2026-09-01, arregla el centrado que notó Ale) — sin tope, un `<p>` en un flex
	 * item sin `width` explícito se acomoda a su "max-content" (intenta una sola línea si entra):
	 * la descripción de Sur en Ruta es más larga que la de RENAMU, así que ese bloque terminaba
	 * mucho más ancho que el otro y el grupo entero (`.sis-nodos`, `justify-content: center`) se
	 * veía descentrado — no era la propiedad `center` la que fallaba, era que los 2 bloques no
	 * medían parecido. */
	.sis-nodo-texto-grupo {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		min-width: 0;
	}

	/* Tope DISTINTO por bloque (2026-09-01, pedido de Ale: "que ambos queden en 2 líneas... dale
	 * más ancho al box del segundo bloque") — un solo `max-width` compartido no alcanza porque las
	 * 2 oraciones tienen largos distintos: la de RENAMU es corta y con 32rem entraba en 1 sola
	 * línea; la de Sur en Ruta es más larga y necesita bastante más ancho para entrar en 2. Los 2
	 * valores están ajustados a mano para que cada uno corte en 2 líneas, ninguno en 1 ni en 3+. */
	.sis-nodo-texto-grupo--renamu {
		max-width: 19rem;
	}

	.sis-nodo-texto-grupo--surenruta {
		max-width: 32rem;
	}

	/* Nombre al doble de tamaño (pedido de Ale) respecto de como estaba antes inline con la
	 * descripción. */
	.sis-nodo-nombre {
		margin: 0;
		font-size: clamp(1.75rem, 1.3rem + 1.8vw, 2.75rem);
		line-height: 1;
		text-transform: uppercase;
	}

	/* Color: mismo celeste de marca que `.sis-titulo-renamu` — ver esa regla para el porqué. */
	.sis-nodo-nombre--renamu {
		font-family: var(--fuente-display);
		font-weight: 800;
		color: var(--color-celeste);
	}

	/* Mismo tratamiento que `.sis-titulo-marca` del título — "Sur en Ruta" es SIEMPRE esta
	 * tipografía/color, se nombre donde se nombre. */
	.sis-nodo-nombre--surenruta {
		font-family: var(--fuente-marca);
		font-weight: 700;
		letter-spacing: 0.015em;
		word-spacing: -0.15em;
		color: var(--color-marino);
	}

	/* Al doble de tamaño (pedido de Ale: "agrandá al doble las definiciones, no los nombres") —
	 * antes clamp(1rem, 0.9rem + 0.4vw, 1.2rem). */
	.sis-nodo-descripcion {
		margin: 0;
		font-family: var(--fuente-texto);
		font-weight: 400;
		font-size: clamp(2rem, 1.8rem + 0.8vw, 2.4rem);
		line-height: 1.25;
		color: var(--color-tinta);
	}

	/* === Conector entre los 2 nodos, rediseñado (2026-09-01, 2ª pasada) ===
	 * Ya no un ícono de eslabón en un aro chico: un NODO grande (mismo lenguaje visual que los
	 * nodos de HiloRuta y de la ruta de las 6 tarjetas de abajo — círculo marino lleno con borde
	 * claro) con 2 tramos de línea PUNTEADA ANIMADA a los costados (`stroke-dasharray` +
	 * `stroke-dashoffset` corriendo — "línea de trazos que se mueven"), representando la unión de
	 * 2 tramos de ruta en un nodo. */
	.sis-nodo-conector {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		gap: 0;
	}

	.sis-nodo-conector-linea {
		width: clamp(2rem, 4vw, 4rem);
		height: 1.25rem;
		overflow: visible;
	}

	.sis-nodo-conector-linea path {
		fill: none;
		stroke: var(--color-verde);
		stroke-width: 3.5;
		stroke-linecap: round;
		stroke-dasharray: 7 7;
		vector-effect: non-scaling-stroke;
		animation: sis-conector-flujo 1s linear infinite;
	}

	@keyframes sis-conector-flujo {
		to {
			stroke-dashoffset: -28;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.sis-nodo-conector-linea path {
			animation: none;
		}
	}

	/* Ícono `adjuntar` adentro (blanco, currentColor) + borde propio marcado (border, NO el aro
	 * separado — ese es el ::after de abajo) + `position: relative` para contener el aro. */
	.sis-nodo-conector-nodo {
		position: relative;
		flex-shrink: 0;
		width: 3.25rem;
		height: 3.25rem;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: var(--color-marino);
		border: 3px solid var(--color-superficie);
		box-shadow: 0 6px 14px -4px rgba(15, 43, 77, 0.4);
		color: var(--color-superficie);
	}

	/* Aro separado del borde por unos px (`inset` negativo) + efecto de latido (pedido de Ale) —
	 * el círculo sólido de arriba queda quieto y nítido; el que pulsa es este aro suelto. */
	.sis-nodo-conector-nodo::after {
		content: '';
		position: absolute;
		inset: -0.45rem;
		border-radius: 50%;
		border: 2.5px solid var(--color-verde);
		animation: sis-nodo-latido 1.8s ease-in-out infinite;
	}

	@keyframes sis-nodo-latido {
		0%,
		100% {
			transform: scale(1);
			opacity: 0.9;
		}
		50% {
			transform: scale(1.18);
			opacity: 0.25;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.sis-nodo-conector-nodo::after {
			animation: none;
		}
	}

	/* === Pantalla 2 · los 2 bloques (mazo pág. 2, 2026-08-31) ===
	 * Lado a lado con una divisoria punteada al medio (sistema visual del mazo). Cada bloque: ícono
	 * en círculo de trazo verde + texto con el lead-in en verde/bold. z-index 1 para quedar POR
	 * DEBAJO de la caja de la cabecera (que les pasa por encima con su parallax). */
	.op-bloques {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 1fr 1fr;
		column-gap: clamp(2rem, 5vw, 3.5rem);
		width: min(44rem, 62vw);
		margin-top: clamp(1rem, 3vh, 1.75rem);
	}

	/* Divisoria punteada vertical, centrada en el gap. */
	.op-bloques::before {
		content: '';
		position: absolute;
		top: 0.25rem;
		bottom: 0.25rem;
		left: 50%;
		border-left: 2px dotted var(--color-tinta-suave);
		opacity: 0.5;
	}

	.op-bloque {
		display: flex;
		align-items: flex-start;
		gap: var(--espacio-sm);
	}

	.op-bloque-icono {
		flex-shrink: 0;
		width: 2.9rem;
		height: 2.9rem;
		border: 1.5px solid var(--color-verde);
		border-radius: 50%;
		display: grid;
		place-items: center;
		color: var(--color-verde);
	}

	.op-bloque-texto {
		margin: 0;
		font-family: var(--fuente-texto);
		font-weight: 400;
		/* Subido un poco (Ale) pero MUY por debajo del box principal: tope ~1.22rem vs. los 5rem del
		 * título. */
		font-size: clamp(1.05rem, 0.98rem + 0.35vw, 1.22rem);
		line-height: 1.5;
		color: var(--color-tinta);
	}

	.op-bloque-texto strong {
		font-weight: 700;
		color: var(--color-verde);
	}

	/* === Pantalla 2 · los 4 chips (mazo pág. 2, 2026-08-31) ===
	 * Tarjetas blancas (--color-superficie) sobre el fondo cálido, formato apenas más vertical que
	 * horizontal (aspect-ratio 1/1.06, pedido de Ale) con ícono grande y detallado (~56px, íconos de
	 * Icono.astro) + label + reglita verde debajo. Unidos por una "ruta" de nodos (ver
	 * .op-chips-ruta). Mucho más chicas que el box del título. z-index 3 → van POR ENCIMA de la caja
	 * de la cabecera (z-index 2): su parallax pasa por DETRÁS y no esconde la entrada de los chips.
	 * Los 2 bloques (z-index 1) sí quedan por debajo de la caja. */
	/* `--op-chips-cols` (2026-09-01): P2 tiene 4 chips, P3 tiene 6 tarjetas — mismo grid, distinta
	 * cantidad de columnas. Custom property con fallback a 4 en vez de una clase modificadora nueva
	 * (P3 la pisa inline, `style="--op-chips-cols: 6"`). */
	.op-chips {
		position: relative;
		z-index: 3;
		display: grid;
		grid-template-columns: repeat(var(--op-chips-cols, 4), minmax(0, 1fr));
		gap: clamp(0.6rem, 1.4vw, 1.15rem);
		width: var(--op-chips-width, min(48rem, 66vw));
		/* aire arriba para la "ruta" que une los nodos (vive con top negativo dentro de .op-chips) */
		margin-top: calc(clamp(0.85rem, 2.5vh, 1.5rem) + 1.75rem);
	}

	/* P3 baja las tarjetas un poco más (2026-09-01, pedido de Ale: "bajá más las cards en posición
	 * para liberar más espacio arriba") — le hace lugar a los nodos ya agrandados. Solo P3
	 * (`.sis-chips`), P2 se queda con el margin-top de arriba. */
	.sis-chips {
		margin-top: calc(clamp(2rem, 5vh, 3rem) + 1.75rem);
	}

	/* P4: más aire arriba que P2/P3 — el `.pasos-nodo` es bastante más grande (2.2rem vs 0.78rem
	 * de `.op-chip-nodo`), necesita más "aire" de sobra para no quedar pegado a la cabecera. */
	.pasos-chips {
		margin-top: calc(clamp(1.75rem, 4.5vh, 2.75rem) + 2.75rem);
	}

	/* "Ruta" ondulada que une los 4 nodos — mismo lenguaje que HiloRuta (línea marino fina). */
	.op-chips-ruta {
		position: absolute;
		top: -1.75rem;
		left: 0;
		right: 0;
		height: 1.75rem;
		width: 100%;
		pointer-events: none;
		/* Fallback (sin scroll-driven): visible entera. */
		clip-path: inset(0 0 0 0);
	}

	.op-chips-ruta path {
		fill: none;
		stroke: var(--color-marino);
		stroke-width: 2;
		stroke-linecap: round;
		vector-effect: non-scaling-stroke;
	}

	/* Fondo oscuro + letras claras (2026-09-01, pedido de Ale) — antes tarjeta blanca con
	 * ícono/label en marino, igual que el resto de la P2. `--color-marino-profundo` en vez de
	 * `--color-marino`: es literalmente el tono que tokens.css documenta para "círculos de ícono
	 * macizos" — el mismo uso que acá, a otra escala. */
	.op-chip {
		position: relative;
		aspect-ratio: 1 / 1.06;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: clamp(0.5rem, 1.6vh, 0.9rem);
		padding: clamp(0.6rem, 1.5vw, 1.1rem);
		background: var(--color-marino-profundo);
		border-radius: clamp(0.9rem, 1.8vw, 1.5rem);
		box-shadow: 0 14px 28px -16px rgba(15, 43, 77, 0.3);
		text-align: center;
	}

	/* Tarjeta de P4 (mazo pág. 4) — clase propia, NO `.op-chip`: ese tiene fondo oscuro hardcodeado
	 * y solo ícono+label; acá hace falta más contenido (ícono + título en negrita + frase de
	 * apoyo) sobre fondo CLARO (el mazo las muestra así, sin cuña navy debajo como en P3). Reusa el
	 * MECANISMO (grid `.op-chips`, ruta `.op-chips-ruta`, entrada al scroll vía `op-chip-entra`),
	 * no el look. */
	.pasos-card {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: clamp(0.5rem, 1.4vh, 0.75rem);
		padding: clamp(1rem, 2.2vw, 1.6rem) clamp(0.85rem, 1.8vw, 1.25rem);
		background: var(--color-superficie);
		border-radius: clamp(0.9rem, 1.8vw, 1.5rem);
		box-shadow: 0 14px 28px -16px rgba(15, 43, 77, 0.22);
		text-align: center;
	}

	.pasos-card-icono {
		color: var(--color-marino);
	}

	.pasos-card-titulo {
		margin: 0;
		font-family: var(--fuente-texto);
		font-weight: 700;
		font-size: clamp(0.95rem, 0.85rem + 0.4vw, 1.15rem);
		line-height: 1.25;
		color: var(--color-marino);
	}

	.pasos-card-frase {
		margin: 0;
		font-family: var(--fuente-texto);
		font-weight: 400;
		font-size: clamp(0.8rem, 0.75rem + 0.2vw, 0.9rem);
		line-height: 1.35;
		color: var(--color-tinta-suave);
	}

	/* Número de la tarjeta (P3, componentes numerados del mazo pág. 3) — 2026-09-01: se movió de
	 * badge chico en la esquina (absolute) a debajo del label, centrado, al doble de tamaño
	 * (pedido de Ale: "agrandar más... pasalos debajo de las palabras al centrado") — ahora es un
	 * hijo más del flex de `.op-chip`, ya no necesita `position: absolute`. Verde de marca (no
	 * `--color-verde-vivo`) + halo blanco, mismo truco de `text-shadow` apilado que
	 * `.op-cierre-texto strong`. */
	.sis-chip-numero {
		margin-top: clamp(0.3rem, 1vh, 0.6rem);
		width: 3.5rem;
		height: 3.5rem;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		border: 2px solid var(--color-verde);
		font-family: var(--fuente-texto);
		font-weight: 700;
		font-size: 1.7rem;
		color: var(--color-verde);
		text-shadow:
			0 0 2px var(--color-superficie),
			0 0 2px var(--color-superficie),
			0 0 3px var(--color-superficie);
	}

	/* Nodo de la "ruta" — círculo marino LLENO, centrado SOBRE la línea de .op-chips-ruta (la línea
	 * a 15/28·1.75rem del top del SVG, que arranca en -1.75rem). Es un <span> hermano de los chips
	 * (no un ::before) para poder darle su propio animation-range inline. `left` va inline por nodo. */
	.op-chip-nodo {
		position: absolute;
		top: calc(-1.75rem + 15 / 28 * 1.75rem);
		width: 0.78rem;
		height: 0.78rem;
		transform: translate(-50%, -50%);
		border-radius: 50%;
		background: var(--color-marino);
		z-index: 2;
	}

	/* Nodo numerado de P4 (mismo cálculo de posición que `.op-chip-nodo` — misma línea, mismos
	 * `PASOS_RUTA_Y`/28 que `SIS_RUTA_Y`/28) pero MÁS GRANDE y con el número "01".."05" adentro: el
	 * mazo dibuja el número arriba, sobre la línea, no adentro de la tarjeta (a diferencia de P3,
	 * que puso el número dentro del chip porque el suyo era un dot simple sin contenido). Verde en
	 * vez de marino — coincide con el círculo del mazo. */
	.pasos-nodo {
		position: absolute;
		top: calc(-1.75rem + 15 / 28 * 1.75rem);
		width: 2.2rem;
		height: 2.2rem;
		display: grid;
		place-items: center;
		transform: translate(-50%, -50%);
		border-radius: 50%;
		background: var(--color-verde);
		color: var(--color-superficie);
		font-family: var(--fuente-texto);
		font-weight: 700;
		font-size: 0.85rem;
		z-index: 2;
	}

	/* === Entrada progresiva de los chips, al ritmo del scroll (2026-08-31, pedido de Ale) ===
	 * La ruta se dibuja de izq→der (`clip-path` wipe — con `preserveAspectRatio=none` un
	 * stroke-dashoffset se veía segmentado), y cada nodo + su tarjeta entran escalonados, cada uno
	 * con su `animation-range` inline (calculado en el frontmatter, ver `rangoChip`). Termina en el
	 * centrado de la P2. */
	@supports (animation-timeline: scroll(root)) {
		.op-chips-ruta {
			clip-path: inset(0 100% 0 0);
			animation: op-ruta-dibuja linear both;
			animation-timeline: --hz-progreso;
		}

		.op-chip-nodo {
			transform: translate(-50%, -50%) scale(0);
			animation: op-nodo-pop linear both;
			animation-timeline: --hz-progreso;
		}

		.op-chip {
			opacity: 0;
			transform: translateY(2rem) scale(0.9);
			animation: op-chip-entra linear both;
			animation-timeline: --hz-progreso;
		}

		/* P4 reusa LITERAL los mismos @keyframes (op-nodo-pop / op-chip-entra) — son genéricos
		 * (scale/opacity/translateY), no específicos de P2/P3, así que no hace falta duplicarlos. */
		.pasos-nodo {
			transform: translate(-50%, -50%) scale(0);
			animation: op-nodo-pop linear both;
			animation-timeline: --hz-progreso;
		}

		.pasos-card {
			opacity: 0;
			transform: translateY(2rem) scale(0.9);
			animation: op-chip-entra linear both;
			animation-timeline: --hz-progreso;
		}
	}

	@keyframes op-ruta-dibuja {
		from {
			clip-path: inset(0 100% 0 0);
		}
		to {
			clip-path: inset(0 0 0 0);
		}
	}

	@keyframes op-nodo-pop {
		0% {
			transform: translate(-50%, -50%) scale(0);
		}
		70% {
			transform: translate(-50%, -50%) scale(1.28);
		}
		100% {
			transform: translate(-50%, -50%) scale(1);
		}
	}

	@keyframes op-chip-entra {
		0% {
			opacity: 0;
			transform: translateY(2rem) scale(0.9);
		}
		70% {
			opacity: 1;
		}
		100% {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.op-chips-ruta {
			animation: none !important;
			clip-path: inset(0 0 0 0);
		}
		.op-chip-nodo {
			animation: none !important;
			transform: translate(-50%, -50%);
		}
		.op-chip {
			animation: none !important;
			opacity: 1;
			transform: none;
		}
		.pasos-nodo {
			animation: none !important;
			transform: translate(-50%, -50%);
		}
		.pasos-card {
			animation: none !important;
			opacity: 1;
			transform: none;
		}
	}

	/* Íconos/label en claro sobre la tarjeta oscura — `--color-verde-vivo` (no `--color-verde`) para
	 * el acento del ícono: es el tono que tokens.css ya reserva para "acentos SOBRE fondo oscuro
	 * (donde el oliva se empasta)", justo este caso. */
	.op-chip-icono {
		color: var(--color-texto-sobre-foto);
	}

	/* Halo blanco en el ícono de P3 (2026-09-01, pedido de Ale) — mismo motivo que el número: el
	 * acento pasó de `--color-verde-vivo` a `--color-verde` (más oscuro), así que las piezas
	 * verdes del ícono necesitan el mismo refuerzo de contraste sobre navy que ya tiene el número
	 * y las palabras del cierre. `filter: drop-shadow` (no `text-shadow`, esto es un SVG) apilado
	 * por el mismo motivo: que quede marcado, no un blur grande. Solo P3 (`.sis-chip-icono`) — el
	 * ícono de P2 sigue en `--color-verde-vivo`, ya tenía contraste de sobra. */
	.sis-chip-icono {
		filter: drop-shadow(0 0 1px var(--color-superficie)) drop-shadow(0 0 1px var(--color-superficie));
	}

	.op-chip-label {
		display: block;
		font-family: var(--fuente-texto);
		font-weight: 600;
		font-size: var(--texto-base);
		line-height: 1.2;
		color: var(--color-texto-sobre-foto);
	}

	/* Reglita bajo el label (mini versión de la del título — cada chip la tiene en el mazo).
	 * `--color-verde-vivo` es el de P2 (ya tenía contraste de sobra, se queda así). P3 lo pisa a
	 * `--color-verde` (2026-09-01, código-basura encontrado: el ícono y el número de la tarjeta ya
	 * habían pasado al verde nuevo, esta reglita se había quedado en el viejo). */
	.op-chip-label::after {
		content: '';
		display: block;
		width: 1.4rem;
		height: 0.18rem;
		margin: 0.5rem auto 0;
		border-radius: 999px;
		background: var(--color-verde-vivo);
	}

	.sis-chips .op-chip-label::after {
		background: var(--color-verde);
	}

	/* === Pantalla 2 · foto-cards de la derecha (mazo pág. 2, 2026-08-31) ===
	 * 4 cards en diagonal (borde izquierdo en `/`, mismo ángulo, corridas a la derecha para
	 * sangrar). Marco blanco (--color-superficie) por el padding. PLACEHOLDER: cada una es un
	 * gradiente + label hasta tener las 4 fotos reales (faro / viñedo / cartel / feria).
	 * Vive en .lamina__galeria (Lamina.astro), z-index 0, por detrás del texto.
	 *
	 * Sin gap ni rotación propia (corregido 2026-09-01, pedido de Ale: "no debe haber margin o
	 * espacios entre ellos"). Antes cada card tenía su PROPIO `rotate(-2deg)` — como cada una gira
	 * sobre su propio centro, dos cards del mismo alto que antes de rotar quedaban perfectamente
	 * pegadas (mismo `clip-path`, `gap: 0`) terminan con un corte en diagonal DISTINTO cada una,
	 * abriendo un hueco en la costura. La rotación (y el corrimiento `translateX`) ahora vive en el
	 * CONTENEDOR (acá abajo, `.op-galeria`): así las 4 cards giran juntas como un solo bloque
	 * rígido — la costura entre cards sigue coincidiendo exacto, y las fotos que reemplacen el
	 * gradiente (vienen en camino) no quedan deformadas (una rotación no distorsiona el contenido,
	 * a diferencia de un `skew`). */
	.op-galeria {
		height: 100%;
		display: flex;
		flex-direction: column;
		gap: 0;
		padding: clamp(0.75rem, 3vh, 2rem) 0
			calc(var(--footer-alto) + clamp(0.5rem, 1.5vh, 1rem));
		transform: translateX(6%) rotate(-2deg);
	}

	/* Sin marco blanco (2026-09-01, pedido de Ale: "siguen estando separadas con borde… quiero que
	 * estén pegadas") — el `padding: 5px` + `background: superficie` de antes armaba un marco tipo
	 * Polaroid alrededor de cada foto; entre dos cards flush ese marco se veía como una franja/borde
	 * de separación aunque el `gap` ya estuviera en 0. Ahora la foto ocupa el 100% del card, sin
	 * aire alrededor — quedan realmente pegadas. `position: relative` porque adentro `.op-galeria-foto`
	 * es `position: absolute` (ver abajo). */
	/* Hover: crece la SOLAPITA entera, no solo la foto de adentro (2026-09-01, pedido de Ale —
	 * primer intento escalaba nada más `.op-galeria-foto`; esta versión escala `.op-galeria-card`
	 * completo, foto + label juntos). Con las 4 cards apiladas sin gap, escalar una desde su centro
	 * la hace invadir un poco a sus vecinas arriba y abajo — por eso el `z-index` al hover, para que
	 * quede claramente POR ENCIMA de ellas en vez de peleando el orden de pintado.
	 *
	 * La sombra usa `filter: drop-shadow()`, NO `box-shadow` (2026-09-01, pedido de Ale: sombra más
	 * pronunciada) — `box-shadow` se pinta sobre el BORDE de la caja, y acá la caja tiene
	 * `clip-path` (las puntas curvas): el `clip-path` recorta TODO lo que se pinta del elemento,
	 * shadow incluido, así que un `box-shadow` grande quedaba invisible más allá del rectángulo
	 * (no se notaba el "despegue"). `drop-shadow` es un filtro que se aplica DESPUÉS del recorte,
	 * sobre la silueta ya clipeada — sigue el contorno diagonal real de la card y SÍ se ve por
	 * fuera. Dos capas (una ceñida + una grande y difusa) para que la sombra se sienta con cuerpo. */
	.op-galeria-card {
		position: relative;
		z-index: 0;
		flex: 1;
		min-height: 0;
		/* Puntas curvas en vez de vértices filosos (2026-09-01) — recorte compartido definido en el
		 * <svg><clipPath> del template, ver el comentario ahí. Escala junto con la card (mismo
		 * elemento), así que la forma no se deforma al crecer. */
		clip-path: url(#op-galeria-recorte);
		transform: scale(1);
		filter: drop-shadow(0 0 0 rgba(10, 20, 33, 0)) brightness(1);
		transition:
			transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
			filter 0.5s ease,
			opacity 0.5s ease;
	}

	.op-galeria-card:hover {
		z-index: 5;
		transform: scale(1.12);
		filter: drop-shadow(0 14px 16px rgba(10, 20, 33, 0.45))
			drop-shadow(0 46px 70px rgba(10, 20, 33, 0.6)) brightness(1);
	}

	/* Apaga las OTRAS 3 cards mientras hay una en hover (2026-09-01, pedido de Ale: "la sombra no
	 * se aprecia" — el problema real es que las 4 fotos, todas a full brillo y bien contrastadas
	 * entre sí, le ganan la atención a la sombra por más pronunciada que sea). Con las vecinas
	 * opacadas, la que queda en hover se lee como la única "levantada" del stack — la sombra ahora
	 * tiene ADEMÁS contraste de brillo a favor, no compite con 3 fotos a pleno color al lado.
	 * `.op-galeria:hover` se dispara con el mouse sobre CUALQUIER card (así funciona `:hover` en un
	 * contenedor); `:not(:hover)` en la card excluye a la que está siendo apuntada. */
	.op-galeria:hover .op-galeria-card:not(:hover) {
		opacity: 0.55;
		filter: drop-shadow(0 0 0 rgba(10, 20, 33, 0)) brightness(0.55) saturate(0.6);
	}

	@media (prefers-reduced-motion: reduce) {
		.op-galeria-card {
			transition: none;
		}
	}

	/* Capa de la foto — separada del label (2026-09-01) para poder cargar cada `--foto` sin que el
	 * texto se vea afectado. `position: absolute; inset: 0` = llena el card entero; ya no tiene
	 * transform propio, crece junto con `.op-galeria-card`. */
	.op-galeria-foto {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: center;
		/* Degradé oscuro abajo, encima de la foto — el text-shadow del label solo no alcanza para
		 * que se lea sobre CUALQUIER foto (depende de qué tan clara sea la zona inferior). */
		background-image: linear-gradient(to top, rgba(10, 20, 33, 0.55), rgba(10, 20, 33, 0) 60%), var(--foto);
	}

	.op-galeria-label {
		position: absolute;
		z-index: 1;
		left: 0;
		right: 0;
		bottom: 0;
		padding: 0.85rem 1.1rem 0.85rem 16%;
		color: var(--color-superficie);
		font-family: var(--fuente-texto);
		font-weight: 700;
		font-size: var(--texto-base);
		letter-spacing: 0.02em;
		text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
	}

	/* PLACEHOLDER (2026-09-01, imágenes de prueba de Ale, todavía sin asignar foto real por card —
	 * faro / viñedo / cartel / feria) — se reemplazan cuando estén las definitivas. */
	.op-galeria-card:nth-child(1) .op-galeria-foto {
