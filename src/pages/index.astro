	</div>

	<Pantalla id="hero" completa>
		<Hero />
	</Pantalla>
	<!-- Pantalla 1 · PORTADA (mazo pág. 1). Ale (2026-08-31) la cerró como portada sola: solo el
	     wordmark + bajada + frase "conecta viajeros...". El contenido de "LA OPORTUNIDAD" (pág. 2)
	     NO va acá, es la Pantalla 2 (ver abajo). -->
	<Pantalla id="portada" completa transparente>
		<Lamina indice={0} fondoRecortado>
			<!-- Wordmark + bajada + frase "conecta viajeros..." de la pág. 1 del mazo (cita textual,
			     ver docs/comparativa-mazo-vs-landing.md § Página 1). Se había sacado del Hero. -->
			<div class="marca-institucional">
				<p class="marca-renamu">
					<span class="reveal-mascara">
						<span class="reveal-interior" style={`animation-range: ${RENAMU_RANGO}`}>
							RENAMU /
						</span>
					</span>
				</p>
				<p class="marca-sur-en-ruta">
					<span class="reveal-mascara">
						<span class="reveal-interior" style={`animation-range: ${SURENRUTA_RANGO}`}>
							Sur en Ruta
						</span>
					</span>
				</p>
				<p class="marca-bajada">
					{bajadaPartes.map((parte, indice) =>
						parte.trim() === '' ? (
							parte
						) : (
							<span class="reveal-mascara">
								<span
									class="reveal-interior"
									style={`animation-range: ${rangoPalabra(BAJADA_INICIO, indice, BAJADA_PASO, BAJADA_DURACION)}`}
								>
									{parte}
								</span>
							</span>
						),
					)}
				</p>
				<!-- Frase final de la página 1 del mazo, con el ícono "comunidad" a la derecha
				     (ver docs/comparativa-mazo-vs-landing.md § Página 1 — cita textual, las 4
				     palabras ya vienen resaltadas ahí). -->
				<div class="marca-conecta-fila">
					<p class="marca-conecta">
						{(() => {
							let indicePalabra = -1;
							return conectaPalabras.map((palabra) => {
								if (palabra.esEspacio) return palabra.texto;
								indicePalabra++;
								return (
									<span class="reveal-mascara">
										<span
											class={
												palabra.resaltado
													? 'reveal-interior marca-conecta-resaltado'
													: 'reveal-interior'
											}
											style={`animation-range: ${rangoPalabra(CONECTA_INICIO, indicePalabra, CONECTA_PASO, CONECTA_DURACION)}`}
										>
											{palabra.texto}
										</span>
									</span>
								);
							});
						})()}
					</p>
					<span class="marca-conecta-icono" style={`animation-range: ${ICONO_RANGO}`}>
						<Icono nombre="comunidad" tamano={64} acento="var(--color-verde)" />
					</span>
				</div>
			</div>

			<!-- Pie del footer (2026-08-28, guiado por Ale): logo en badge circular blanco + columna
			     "Sur en Ruta" / eslogan (ver Preloader.astro `ESLOGAN`) al lado — el eslogan vivía
			     suelto a la derecha, se trajo debajo del nombre. Probando la fuente de RENAMU acá. -->
			<div slot="footer" class="pie-footer">
				<div class="pie-marca" style={`animation-range: ${PIE_MARCA_RANGO}`}>
					<span class="pie-logo">
						<img src={logoUrl} alt="" width="64" height="58" />
					</span>
					<div class="pie-texto">
						<span class="pie-nombre">Sur en Ruta</span>
						<p class="pie-eslogan">CONECTA - ORDENA - POTENCIA</p>
					</div>
				</div>
			</div>
		</Lamina>
	</Pantalla>

	<!-- Pantalla 2 · "LA OPORTUNIDAD" (mazo pág. 2). Se arma elemento por elemento, guiado por Ale.
	     Hecho: cabecera (título + subtítulo, caja con parallax) + los 2 bloques + los 4 chips con su
	     ruta de nodos. Falta: el cierre "Sin una red organizada…", la foto (camper en ruta costera)
	     con corte S y el eyebrow de puntos. Footer CONTINUO con la Pantalla 1 vía indice={1}. -->
	<Pantalla id="oportunidad" completa>
		<Lamina indice={1} distribucion="columna">
			<div class="op-cabecera" style={`animation-range: ${OP_CABECERA_RANGO}`}>
				<p class="op-titulo op-titulo--l1">LA</p>
				<p class="op-titulo op-titulo--l2">OPORTUNIDAD</p>
				<p class="op-subtitulo">{OP_SUBTITULO_TEXTO}</p>
			</div>

			<!-- Los 2 bloques del mazo (lado a lado, divisoria punteada). Copy literal, con el
			     lead-in en verde/bold (ya venía resaltado en el mazo). Todavía SIN animación propia
			     — la caja de la cabecera pasa por encima de ellos con su parallax ("caja que se
			     mueve sobre el contenido", pedido de Ale). -->
			<div class="op-bloques">
				<div class="op-bloque">
					<span class="op-bloque-icono">
						<Icono nombre="grafico-creciente" tamano={26} acento="var(--color-verde)" />
					</span>
					<p class="op-bloque-texto">
						<strong>El turismo itinerante crece</strong> porque combina libertad, flexibilidad y
						contacto con el territorio.
					</p>
				</div>
				<div class="op-bloque">
					<span class="op-bloque-icono">
						<Icono nombre="ubicacion" tamano={26} acento="var(--color-verde)" />
					</span>
					<p class="op-bloque-texto">
						<strong>La oportunidad</strong> está en ordenar la experiencia con información clara,
						servicios identificados y buenas prácticas.
					</p>
				</div>
			</div>

			<!-- Los 4 chips = VALORES del mazo (Libertad · Naturaleza · Experiencias · Economía
			     local), no elementos del sistema (confirmado con el render de la pág. 2). Tarjetas
			     blancas con ícono + label. La estructura de líneas punteadas tipo árbol que los une a
			     los 2 bloques (decorativa) se suma después. -->
			<div class="op-chips">
				<!-- Los 4 nodos van UNIDOS por una "ruta" ondulada, mismo formato que el nav lateral
				     (HiloRuta): línea marino + nodos llenos centrados en ella. Pedido de Ale — los
				     puntos no van sueltos; la bajadita nodo→chip se obvió. La línea se DIBUJA con el
				     scroll (wipe con clip-path — ver el <style>). preserveAspectRatio="none" estira la
				     línea (ok, es un trazo); los NODOS y las tarjetas son HTML para no ovalarse y para
				     poder animarlos escalonados. -->
				<svg
					class="op-chips-ruta"
					viewBox="0 0 100 28"
					preserveAspectRatio="none"
					aria-hidden="true"
					style={`animation-range: ${CHIPS_RUTA_RANGO}`}
				>
					<path
						d="M2 15C6 15 9 12 12 15C19 22 30 22 37.5 15C45 8 55 8 62.5 15C70 22 80 22 88 15C91 13 95 15 98 15"
					/>
				</svg>
				{CHIPS.map((_, k) => (
					<span
						class="op-chip-nodo"
						style={`left: ${12.5 + k * 25}%; animation-range: ${rangoChip(k, 0, 1.6)}`}
					/>
				))}
				{CHIPS.map((c, k) => (
					<div class="op-chip" style={`animation-range: ${rangoChip(k, 0.8, 2.4)}`}>
						<span class="op-chip-icono">
							<Icono nombre={c.icono} tamano={56} acento="var(--color-verde-vivo)" />
						</span>
						<span class="op-chip-label">{c.label}</span>
					</div>
				))}
			</div>

			<!-- Stack de foto-cards del mazo (faro / viñedo / cartel / feria) en diagonal, sangrando
			     por la derecha. Vive en el slot `galeria` de Lamina (fuera de .lamina__cuerpo, ver
			     Lamina.astro). PLACEHOLDER: gradiente + label hasta tener las fotos reales.
			     Recorte con puntas curvas (2026-09-01, pedido de Ale): un `clip-path: polygon()` no
			     puede redondear vértices, así que el recorte vive en un `<clipPath>` SVG con un
			     `<path>` (arcos en las 2 puntas izquierdas — las que se ven; las de la derecha
			     sangran fuera de la lámina, no hace falta redondearlas). `clipPathUnits="objectBoundingBox"`
			     = fracciones 0–1, se adapta solo al tamaño real de cada card sin JS (mismo truco que
			     el recorte de .lamina__fondo, ver Lamina.astro). Las 4 cards comparten el mismo id. -->
			<svg width="0" height="0" aria-hidden="true">
				<defs>
					<clipPath id="op-galeria-recorte" clipPathUnits="objectBoundingBox">
						<path d="M0.17,0 L1,0 L1,1 L0.06,1 Q0,1 0.0165,0.85 L0.0935,0.15 Q0.11,0 0.17,0 Z" />
					</clipPath>
				</defs>
			</svg>
			<div slot="galeria" class="op-galeria" aria-hidden="true">
				{GALERIA.map((label, k) => (
					<div class="op-galeria-card" style={`--i: ${k}`}>
						{/* Foto y label separados (2026-09-01, hover zoom): la foto es la capa que
						    escala al hover, el label queda fijo encima — si compartieran el mismo
						    elemento, el texto también se agrandaría. */}
						<span class="op-galeria-foto" aria-hidden="true" />
						<span class="op-galeria-label">{label}</span>
					</div>
				))}
			</div>

			<!-- Cierre de P2 (mazo pág. 2, "Sin una red organizada…") — sobre la onda del footer,
			     mismo efecto de "choque" que el logo del footer de p1 (comparten @keyframes
			     pie-marca-choca; ver el comentario largo ahí). Lead-in en celeste/bold (mismo
			     tratamiento que los 4 resaltados de la Portada) porque va sobre el footer navy — el
			     verde de .op-bloque-texto no tiene contraste ahí. -->
			<div slot="footer" class="pie-footer">
				<div class="op-cierre" style={`animation-range: ${OP_CIERRE_RANGO}`}>
					<span class="op-cierre-icono">
						<Icono nombre="warning" tamano={38} acento="var(--color-terracota)" />
					</span>
					<p class="op-cierre-texto">
						<strong>Sin una red organizada,</strong> la experiencia pierde claridad, seguridad y
						conexión con el destino.
					</p>
				</div>
			</div>
		</Lamina>
	</Pantalla>

	<!-- Pantalla 3 · "¿Qué es RENAMU / Sur en Ruta?" (mazo pág. 3). Se arma elemento por elemento,
	     igual que P2. Hecho: cabecera (mismo diseño que P2, pedido de Ale).
	     `diagDesde*`/`diagHasta*` (2026-09-02): la cuña de P3 y la de P4 (más abajo) apuntan a los
	     MISMOS 4 anclajes — es UNA sola recta continua de indice 2 a indice 4, cada lámina dibuja
	     solo su tramo. Antes cada una interpolaba sobre su propio ancho (0→1 local) y quedaban dos
	     pendientes distintas que solo coincidían en el punto de unión, no en el ángulo — se notaba
	     como un quiebre en la costura. Ver el comentario largo en Lamina.astro. -->
	<Pantalla id="sistema" completa>
		<Lamina
			indice={2}
			distribucion="columna"
			fondoDiagonal
			diagDesdeIndice={2}
			diagDesdeValor={95}
			diagHastaIndice={4}
			diagHastaValor={5}
		>
			<div class="op-cabecera" style={`animation-range: ${SIS_CABECERA_RANGO}`}>
				<p class="sis-titulo-eyebrow">¿Qué es</p>
				<!-- Título en UNA línea (2026-09-01, pedido de Ale, para liberar espacio vertical y
				     agrandar lo de abajo) — antes 2 `<p class="op-titulo">` (bloques, cada uno su
				     línea); ahora un solo `<p>` con 2 `<span>` inline. Colores igual que antes
				     (intercambiados: "Sur en Ruta" siempre azul/blanco, nunca verde) — el subrayado ya
				     no sale gratis de `.op-titulo--l2::after` (ese truco necesita el span en bloque),
				     así que `.sis-titulo-renamu::after` lo repite a mano. -->
				<p class="sis-titulo-linea"><span class="sis-titulo-renamu">RENAMU /</span> <span class="sis-titulo-marca">Sur en Ruta?</span></p>
			</div>

			<!-- Los 2 nodos del mazo (RENAMU / Sur en Ruta) — estructura propia `.sis-nodo*`, ya NO
			     reusa `.op-bloque*` de P2 (2026-09-01, 3ª pasada, replicando una captura de
			     referencia del mazo que pasó Ale: badge circular RELLENO + nombre grande en su
			     propio renglón + descripción más chica debajo + conector con nodo/ícono en el medio).
			     Ver el bloque de comentario largo antes de `.sis-nodos` en el <style>. -->
			<div class="sis-nodos">
				<div class="sis-nodo" style={`animation-range: ${rangoSisNodo(0)}`}>
					<span class="sis-nodo-badge sis-nodo-badge--renamu">
						<Icono nombre="institucional" tamano={44} />
					</span>
					<div class="sis-nodo-texto-grupo sis-nodo-texto-grupo--renamu">
						<p class="sis-nodo-nombre sis-nodo-nombre--renamu">RENAMU</p>
						<p class="sis-nodo-descripcion">Marco territorial e institucional.</p>
					</div>
				</div>
				<!-- Conector rediseñado (2026-09-01, 2ª pasada) — ya no el ícono de eslabón: un nodo
				     grande (mismo lenguaje visual que los nodos de HiloRuta y de la ruta de las 6
				     tarjetas de abajo) con 2 tramos de línea punteada ANIMADOS (stroke-dashoffset,
				     "se mueven") entrando desde cada lado — la unión de 2 tramos de ruta en un nodo. -->
				<span class="sis-nodo-conector" aria-hidden="true">
					<svg class="sis-nodo-conector-linea" viewBox="0 0 100 10" preserveAspectRatio="none">
						<path d="M0 5 L100 5" />
					</svg>
					<span class="sis-nodo-conector-nodo">
						<Icono nombre="adjuntar" tamano={20} />
					</span>
					<svg class="sis-nodo-conector-linea" viewBox="0 0 100 10" preserveAspectRatio="none">
						<path d="M0 5 L100 5" />
					</svg>
				</span>
				<div class="sis-nodo" style={`animation-range: ${rangoSisNodo(1)}`}>
					<span class="sis-nodo-badge sis-nodo-badge--surenruta">
						<Icono nombre="base-conectada" tamano={44} />
					</span>
					<div class="sis-nodo-texto-grupo sis-nodo-texto-grupo--surenruta">
						<p class="sis-nodo-nombre sis-nodo-nombre--surenruta">Sur en Ruta</p>
						<p class="sis-nodo-descripcion">Plataforma de conexión, comunicación y experiencia.</p>
					</div>
				</div>
			</div>

			<!-- Las 6 tarjetas numeradas (mazo pág. 3, componentes del sistema) — mismo mecanismo que
			     los 4 chips de P2 (`.op-chips`/`.op-chip-nodo`/`.op-chip`, reusados tal cual), extendido
			     a 6 paradas. Copy desde `componentes` (src/data/componentes.ts). Caen sobre la cuña
			     diagonal → fondo oscuro (mismo `.op-chip` que ya quedó oscuro hoy en P2), no hace falta
			     una variante nueva. -->
			<div class="op-chips sis-chips" style="--op-chips-cols: 6; --op-chips-width: 100%">
				<svg
					class="op-chips-ruta"
					viewBox="0 0 100 28"
					preserveAspectRatio="none"
					aria-hidden="true"
					style={`animation-range: ${SIS_CHIPS_RUTA_RANGO}`}
				>
					<path d={dSisRuta} />
				</svg>
				{SIS_CHIPS.map((_, k) => (
					<span
						class="op-chip-nodo"
						style={`left: ${SIS_RUTA_X0 + k * SIS_RUTA_SEPARACION}%; animation-range: ${rangoSisChip(k, 0, 1.6)}`}
					/>
				))}
				{SIS_CHIPS.map((c, k) => (
					<div class="op-chip" style={`animation-range: ${rangoSisChip(k, 0.8, 2.4)}`}>
						<span class="op-chip-icono sis-chip-icono">
							<Icono nombre={c.icono} tamano={112} acento="var(--color-verde)" />
						</span>
						<span class="op-chip-label">{c.label}</span>
						<span class="sis-chip-numero">{k + 1}</span>
					</div>
				))}
			</div>

			<!-- Cierre de P3 ("Un sistema que conecta…", mazo pág. 3) — mismo mecanismo que el cierre
			     de P2 (`.op-cierre`, reusado tal cual), ícono `comunidad` (el mismo que usa P1 para su
			     frase "conecta viajeros..."). 4 palabras resaltadas en vez de un lead-in solo — mismo
			     efecto celeste/bold, varios <strong> en la frase. -->
			<div slot="footer" class="pie-footer">
				<div class="op-cierre" style={`animation-range: ${SIS_CIERRE_RANGO}`}>
					<span class="op-cierre-icono">
						<Icono nombre="comunidad" tamano={34} acento="var(--color-verde)" />
					</span>
					<p class="op-cierre-texto">
						Un sistema que conecta <strong>viajeros</strong>, <strong>destinos</strong>, <strong>servicios</strong> y <strong>comunidad</strong>.
					</p>
				</div>
			</div>
		</Lamina>
	</Pantalla>
	<!-- Pantalla 4 · "Cómo funciona la red" (mazo pág. 4). Se arma elemento por elemento, igual
	     que P2/P3. Ver el plan en validated-purring-tulip.md. Hecho: isotipo + cabecera — reusa
	     `.op-titulo`/`.op-subtitulo` de P2, pero NO el diseño de caja de `.op-cabecera` tal cual
	     (2026-09-02, pedido de Ale): `.como-cabecera` la pisa a fila (logo al lado del texto, no
	     apilado arriba) y sin sombra.
	     `fondoDiagonal` (2026-09-02, mismo día, pedido de Ale: "la continuación de la misma [cuña
	     de P3] pero en P4") — 3 vueltas hasta quedar bien:
	     1er intento: invertir los extremos (30→95) hacía que P4 arrancara donde P3 termina pero
	     VOLVIERA a bajar — mismo píxel de arranque, pendiente contraria, se armaba un pico en la
	     costura (Ale: "iniciaste en el mismo pixel pero con la forma incorrecta").
	     2do intento: `diagTopeIzq={30} diagTopeDer={5}` (seguir subiendo, sin invertir) arregló la
	     dirección, pero cada lámina interpolaba sobre su PROPIO ancho (0→1 local) — P3 con pendiente
	     -0,65 y P4 con -0,25, dos rectas que coincidían en valor en la costura pero no en ángulo. Con
	     el ripple fuerte no se notaba; al bajarlo (pedido siguiente, "quitale la curva del medio")
	     quedó expuesto como una unión no fluida.
	     Ahora (`diagDesde*`/`diagHasta*`, mismos anclajes que P3 más arriba): es la MISMA recta
	     continua indice 2→4 que ya define P3, este bloque solo dibuja SU tramo (indice 3→4) — sin
	     quiebre de pendiente en la costura, sin necesitar tantear dos pares de números por separado.
	     Ver el comentario largo en Lamina.astro. -->
	<Pantalla id="como-funciona" completa>
		<Lamina
			indice={3}
			distribucion="columna"
			fondoDiagonal
			diagDesdeIndice={2}
			diagDesdeValor={95}
			diagHastaIndice={4}
			diagHastaValor={5}
		>
			<div class="op-cabecera como-cabecera" style={`animation-range: ${COMO_CABECERA_RANGO}`}>
				<img class="como-isotipo" src={logoUrl} alt="" width="183" height="167" />
				<div class="como-cabecera-texto">
					<p class="op-titulo op-titulo--l1">CÓMO</p>
					<p class="op-titulo op-titulo--l2">FUNCIONA LA RED</p>
					<p class="op-subtitulo">Una experiencia simple, organizada y conectada</p>
				</div>
			</div>

			<!-- Los 5 pasos (mazo pág. 4) — mismo mecanismo que las tarjetas de P2/P3 (ruta ondulada +
			     nodos + entrada escalonada), tarjetas nuevas `.pasos-card` (más contenido, fondo claro).
			     El número vive en el nodo de la línea, no en la tarjeta (ver comentario en frontmatter). -->
			<div class="op-chips pasos-chips" style="--op-chips-cols: 5; --op-chips-width: 100%">
				<svg
					class="op-chips-ruta"
					viewBox="0 0 100 28"
					preserveAspectRatio="none"
					aria-hidden="true"
					style={`animation-range: ${PASOS_RUTA_RANGO}`}
				>
					<path d={dPasosRuta} />
				</svg>
				{PASOS.map((_, k) => (
					<span
						class="pasos-nodo"
						style={`left: ${PASOS_RUTA_X0 + k * PASOS_RUTA_SEPARACION}%; animation-range: ${rangoPasos(k, 0, 1.6)}`}
					>
						{String(k + 1).padStart(2, '0')}
					</span>
				))}
				{PASOS.map((p, k) => (
					<div class="pasos-card" style={`animation-range: ${rangoPasos(k, 0.8, 2.4)}`}>
						<span class="pasos-card-icono">
							<Icono nombre={p.icono} tamano={44} acento="var(--color-verde)" />
						</span>
						<h3 class="pasos-card-titulo">{p.titulo}</h3>
						<p class="pasos-card-frase">{p.frase}</p>
					</div>
				))}
			</div>

			<!-- Tira de 4 fotos placeholder (mazo pág. 4) — 2026-09-02, pedido de Ale: van DEBAJO del
			     contenido (fila, en el flujo normal), no al costado como la galería de P2 — así que NO
			     usa `slot="galeria"` (ese slot es lo que arma `.lamina__galeria`, posicionado absolute
			     al borde derecho) ni las clases `.op-galeria*` (pensadas para ese stack vertical
			     diagonal). Clases propias `.pasos-fotos*`: fila simple, cards con esquinas redondeadas
			     (no el recorte en punta de P2). Sin fotos reales todavía — gradiente plano con uno de
			     los `--color-ruta-*` por card, mismo criterio que P2 antes de tener las fotos reales. -->
			<div class="pasos-fotos">
				{PASOS_GALERIA.map((label, k) => (
					<div class="pasos-foto-card">
						<span class="pasos-foto-img" aria-hidden="true" />
						<span class="pasos-foto-label">{label}</span>
					</div>
				))}
			</div>

			<!-- Cierre de P4 ("Una red que organiza el viaje y potencia los destinos.", mazo pág. 4) —
			     mismo mecanismo que P2/P3 (`.op-cierre`, reusado tal cual). Ícono `base-conectada` (no
