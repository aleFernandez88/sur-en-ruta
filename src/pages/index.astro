---
/**
 * index.astro — landing de Sur en Ruta. Sigue el mazo de Ana (`Presentacion Sur en Ruta
 * RENAMU.pdf`, 10 páginas) 1:1 — ver docs/landing-contenido.md y docs/comparativa-mazo-vs-landing.md.
 * Se arma pantalla por pantalla, guiado por Ale, no todo de una vez.
 *
 * Recorrido de la "cinta" (ver Pantalla.astro y base.css): Hero propio (Pantalla 0) → Pantalla 1
 * PORTADA (mazo pág. 1, cerrada) → Pantalla 2 "LA OPORTUNIDAD" (mazo pág. 2, en construcción) →
 * pág. 3..10 todavía como SlidePlaceholder. Cada pantalla del mazo es `<Pantalla completa>` (el
 * look full-bleed del mazo lo necesita); el Hero también.
 *
 * `N_PANTALLAS` (abajo) = total de <Pantalla>. TODAS las ventanas de animación scroll-driven se
 * calculan a partir de ese número (ver `esc()`), así sumar una pantalla del mazo es cambiar ese
 * número + agregar la parada en HiloRuta.astro (`recorrido`), sin recalibrar a mano.
 */
import Base from '../layouts/Base.astro';
import Pantalla from '../components/Pantalla.astro';
import Hero from '../components/Hero.astro';
import Lamina from '../components/Lamina.astro';
import SlidePlaceholder from '../components/SlidePlaceholder.astro';
import Icono from '../components/Icono.astro';
import logoUrl from '../assets/logo/isotipo-original.svg?url';
import { Image } from 'astro:assets';
// PLACEHOLDER, no deployar así — trae el logo de Dometic visible y no es Uruguay. Ver
// src/assets/oportunidad/FUENTE.md. Pasada por Ale el 2026-08-28 para probar layout + la foto fija
// mientras se consigue la foto real ("camper en ruta costera", docs/landing-contenido.md § P.1).
import fotoOportunidad from '../assets/oportunidad/camping-placeholder.png';

/* === Animaciones de entrada de Pantalla 1 (2026-08-28) ===
 * Pedido de Ale: "mejores que fade in". Reveal enmascarado (overflow:hidden + translateY, ver
 * @keyframes texto-sube en el <style>) por LÍNEA para el wordmark grande (2 líneas cortas) y por
 * PALABRA para los párrafos (mismo espíritu que el "text splitting" de sitios premiados — ver
 * memoria del proyecto). Atado al mismo --hz-progreso que ya usa la foto fija (.fondo-oportunidad).
 *
 * OJO — tres gotchas reales encontrados en vivo, en direcciones distintas:
 * 1. La tarjeta de una pantalla `completa` NO se queda quieta en ningún momento — se desliza 1:1
 *    con el scroll TODO el tiempo, sin pausa. Solo hay un INSTANTE en que queda perfectamente
 *    centrada (getBoundingClientRect a distintos %: para Pantalla 1, 26.0% exacto), pero se
 *    mantiene SUSTANCIALMENTE visible (>60-80% del viewport) en un rango bastante más amplio,
 *    medido en vivo: ~17% a ~35%.
 * 2. Una ventana DEMASIADO angosta (~1.3 puntos ≈ 9px de scroll real, primer intento) es MENOS
 *    que un solo tick de rueda de mouse — el usuario scrolleaba una vez y todo aparecía de golpe,
 *    sin frames intermedios. Necesita cientos de px reales (1% ≈ 61px acá) para verse progresiva.
 * 3. Una ventana que TERMINA DESPUÉS del instante de centrado (26%) hace que el usuario "llegue"
 *    a la pantalla con la entrada todavía a mitad de camino — reportado por Ale como "tengo que
 *    pasar media pantalla para ver todo, en el momento exacto solo se ve la primera letra". La
 *    secuencia entera tiene que TERMINAR antes o justo en el instante de centrado, no extenderse
 *    después — por eso arranca bien antes (15%) y termina en el centrado (25.8%), no [20,32].
 */
/* Cantidad total de <Pantalla> en la cinta (incluye el Hero). El instante en que cada bloque k
 * queda centrado es ~100·k/(N-1) % del scroll-timeline --hz-progreso, y de ahí salen TODAS las
 * ventanas de animación de abajo. Los tiempos crudos se afinaron EN VIVO con N=5 (centro de
 * Pantalla 1 medido ~26%); `esc()` los reescala al N actual. Cuando se sumen las pantallas que
 * faltan del mazo, subir este número (y agregar la parada en HiloRuta.astro `recorrido`) es lo
 * único que hay que tocar para recalibrar. */
const N_PANTALLAS = 6;
const P1_CENTRO = 100 / (N_PANTALLAS - 1); // % de --hz-progreso en que la Pantalla 1 (portada) se centra
const CENTRO_REF = 26; // centro de P1 con el que se afinaron los tiempos crudos (N=5, medido en vivo)
const K = P1_CENTRO / CENTRO_REF;
// Reescala un tiempo crudo de Pantalla 1. `pantalla` (default 1) lo corre a otra pantalla de la
// cinta: la 2 arranca CENTRO_REF más adelante en la escala cruda, etc.
const esc = (v: number, pantalla = 1): number =>
	+((v + (pantalla - 1) * CENTRO_REF) * K).toFixed(3);
const rango = (desde: number, hasta: number, pantalla = 1): string =>
	`${esc(desde, pantalla)}% ${esc(hasta, pantalla)}%`;

function rangoPalabra(
	inicio: number,
	indice: number,
	paso: number,
	duracion: number,
	pantalla = 1,
): string {
	const desde = esc(inicio + indice * paso, pantalla);
	return `${desde.toFixed(3)}% ${(desde + duracion * K).toFixed(3)}%`;
}

const RENAMU_RANGO = rango(15, 16);
const SURENRUTA_RANGO = rango(15.7, 16.7);
const FONDO_FIJO_RANGO = rango(12, 24);
const PIE_MARCA_RANGO = rango(19.5, 25);

const BAJADA_TEXTO = 'Una red para ordenar y potenciar el turismo itinerante en Uruguay';
const BAJADA_INICIO = 16.9;
const BAJADA_PASO = 0.34;
const BAJADA_DURACION = 0.65;
// split con grupo de captura: alterna palabra/espacio/palabra/... el espacio se renderiza tal
// cual (sin animación) para no romper el ajuste de línea natural del párrafo.
const bajadaPartes = BAJADA_TEXTO.split(/(\s+)/).filter((p) => p !== '');

interface Segmento {
	texto: string;
	resaltado: boolean;
}
// Cita textual del mazo (ver docs/comparativa-mazo-vs-landing.md) — las 4 palabras ya venían
// resaltadas ahí. Se arma por segmentos (no un solo string) para poder aplicar el reveal
// palabra por palabra SIN perder el resaltado de esas 4.
const CONECTA_SEGMENTOS: Segmento[] = [
	{ texto: 'Una propuesta que conecta ', resaltado: false },
	{ texto: 'viajeros', resaltado: true },
	{ texto: ', ', resaltado: false },
	{ texto: 'territorios', resaltado: true },
	{ texto: ', ', resaltado: false },
	{ texto: 'servicios', resaltado: true },
	{ texto: ' y ', resaltado: false },
	{ texto: 'experiencias', resaltado: true },
	{ texto: '.', resaltado: false },
];
interface Palabra {
	texto: string;
	resaltado: boolean;
	esEspacio: boolean;
}
const conectaPalabras: Palabra[] = [];
for (const segmento of CONECTA_SEGMENTOS) {
	if (segmento.resaltado) {
		conectaPalabras.push({ texto: segmento.texto, resaltado: true, esEspacio: false });
		continue;
	}
	for (const parte of segmento.texto.split(/(\s+)/)) {
		if (parte === '') continue;
		conectaPalabras.push({ texto: parte, resaltado: false, esEspacio: parte.trim() === '' });
	}
}
const CONECTA_INICIO = 21.4;
const CONECTA_PASO = 0.31;
const CONECTA_DURACION = 0.55;
const ICONO_RANGO = rango(24.5, 25.3);

/* === Pantalla 2 · "LA OPORTUNIDAD" (mazo pág. 2) ===
 * Entrada DISTINTA a la de la Pantalla 1 (pedido de Ale: cada pantalla elige su animación, no se
 * repite el reveal enmascarado). Acá: título + subtítulo en UNA caja (`.op-cabecera`, con fondo
 * propio) que **se desliza en vertical a la par del scroll y NUNCA se queda quieta** — sigue
 * moviéndose incluso cuando la P2 está saliendo. El texto SIEMPRE nítido (sin fade), lo que se
 * anima es la posición: la caja pasa por encima del contenido de la lámina. Atado a --hz-progreso,
 * linear. Correcciones de Ale 2026-08-31: sin transparencia, movimiento MÁS notorio, sin punto de
 * reposo. Ventana = todo el arco visible de la P2 (centro ± ~20 puntos). Falta: los 2 bloques, los
 * 4 chips (Libertad · Naturaleza · Experiencias · Economía local), el cierre, la foto y el eyebrow. */
const P2_CENTRO = P1_CENTRO * 2; // % de --hz-progreso en que la Pantalla 2 se centra
// Ventana SIMÉTRICA alrededor del centrado de la P2 → la caja pasa por translate(0,0) EXACTO en el
// punto medio (cuando la P2 está centrada) y sigue de largo hacia arriba-izquierda.
const OP_CABECERA_RANGO = `${(P2_CENTRO - 20).toFixed(2)}% ${(P2_CENTRO + 20).toFixed(2)}%`;
const OP_SUBTITULO_TEXTO = 'Una nueva forma de viajar necesita una nueva forma de organizarse';
---

<Base>
	<!-- Foto FIJA al viewport de Pantalla 1 (2026-08-28, pedido de Ale: "la foto 100% fija, que
	     todo el sitio se mueva"). Vive en la capa .fondo-fijo de Base.astro (fuera de .hz-track,
	     ver ahí el porqué). Recorte en curva S: solo se ve la mitad derecha, con la curva sobre su
	     borde izquierdo. Hace fade-in con --hz-progreso mientras Pantalla 1 entra y después queda
	     visible (no se apaga): los .hz-bloque vecinos son opacos y la tapan solos. Placeholder. -->
	<div
		slot="fondo-fijo"
		class="fondo-oportunidad"
		style={`animation-range: ${FONDO_FIJO_RANGO}`}
	>
		<Image src={fotoOportunidad} alt="" widths={[600, 1000, 1600]} sizes="55vw" />
	</div>

	<Pantalla id="hero" completa>
		<Hero />
	</Pantalla>
	<!-- Pantalla 1 · PORTADA (mazo pág. 1). Ale (2026-08-31) la cerró como portada sola: solo el
	     wordmark + bajada + frase "conecta viajeros...". El contenido de "LA OPORTUNIDAD" (pág. 2)
	     NO va acá, es la Pantalla 2 (ver abajo). -->
	<Pantalla id="portada" completa transparente>
		<Lamina indice={0} fondoRecortado>
			<!-- Wordmark + bajada + frase "conecta viajeros..." de la pág. 1 del mazo (cita textual,
			     ver docs/comparativa-mazo-vs-landing.md § Página 1). Se había sacado del Hero. -->
			<div class="marca-institucional">
				<p class="marca-renamu">
					<span class="reveal-mascara">
						<span class="reveal-interior" style={`animation-range: ${RENAMU_RANGO}`}>
							RENAMU /
						</span>
					</span>
				</p>
				<p class="marca-sur-en-ruta">
					<span class="reveal-mascara">
						<span class="reveal-interior" style={`animation-range: ${SURENRUTA_RANGO}`}>
							Sur en Ruta
						</span>
					</span>
				</p>
				<p class="marca-bajada">
					{bajadaPartes.map((parte, indice) =>
						parte.trim() === '' ? (
							parte
						) : (
							<span class="reveal-mascara">
								<span
									class="reveal-interior"
									style={`animation-range: ${rangoPalabra(BAJADA_INICIO, indice, BAJADA_PASO, BAJADA_DURACION)}`}
								>
									{parte}
								</span>
							</span>
						),
					)}
				</p>
				<!-- Frase final de la página 1 del mazo, con el ícono "comunidad" a la derecha
				     (ver docs/comparativa-mazo-vs-landing.md § Página 1 — cita textual, las 4
				     palabras ya vienen resaltadas ahí). -->
				<div class="marca-conecta-fila">
					<p class="marca-conecta">
						{(() => {
							let indicePalabra = -1;
							return conectaPalabras.map((palabra) => {
								if (palabra.esEspacio) return palabra.texto;
								indicePalabra++;
								return (
									<span class="reveal-mascara">
										<span
											class={
												palabra.resaltado
													? 'reveal-interior marca-conecta-resaltado'
													: 'reveal-interior'
											}
											style={`animation-range: ${rangoPalabra(CONECTA_INICIO, indicePalabra, CONECTA_PASO, CONECTA_DURACION)}`}
										>
											{palabra.texto}
										</span>
									</span>
								);
							});
						})()}
					</p>
					<span class="marca-conecta-icono" style={`animation-range: ${ICONO_RANGO}`}>
						<Icono nombre="comunidad" tamano={64} acento="var(--color-verde)" />
					</span>
				</div>
			</div>

			<!-- Pie del footer (2026-08-28, guiado por Ale): logo en badge circular blanco + columna
			     "Sur en Ruta" / eslogan (ver Preloader.astro `ESLOGAN`) al lado — el eslogan vivía
			     suelto a la derecha, se trajo debajo del nombre. Probando la fuente de RENAMU acá. -->
			<div slot="footer" class="pie-footer">
				<div class="pie-marca" style={`animation-range: ${PIE_MARCA_RANGO}`}>
					<span class="pie-logo">
						<img src={logoUrl} alt="" width="64" height="58" />
					</span>
					<div class="pie-texto">
						<span class="pie-nombre">Sur en Ruta</span>
						<p class="pie-eslogan">CONECTA - ORDENA - POTENCIA</p>
					</div>
				</div>
			</div>
		</Lamina>
	</Pantalla>

	<!-- Pantalla 2 · "LA OPORTUNIDAD" (mazo pág. 2). Se arma elemento por elemento, guiado por Ale.
	     Por ahora: cabecera (título bicolor + subtítulo) como UN bloque que entra desde arriba con
	     el scroll (ver .op-cabecera en el <style>, y feedback-animacion-por-pantalla en memoria).
	     Falta: los 2 bloques, los 4 chips (Libertad · Naturaleza · Experiencias · Economía local),
	     el cierre "Sin una red organizada…", la foto (camper en ruta costera) con corte S y el
	     eyebrow de puntos. Footer CONTINUO con la Pantalla 1 vía indice={1} (misma función de onda,
	     tramo siguiente — ver Lamina.astro). -->
	<Pantalla id="oportunidad" completa>
		<Lamina indice={1} distribucion="columna">
			<div class="op-cabecera" style={`animation-range: ${OP_CABECERA_RANGO}`}>
				<p class="op-titulo op-titulo--l1">LA</p>
				<p class="op-titulo op-titulo--l2">OPORTUNIDAD</p>
				<p class="op-subtitulo">{OP_SUBTITULO_TEXTO}</p>
			</div>
		</Lamina>
	</Pantalla>

	<Pantalla id="mapa">
		<SlidePlaceholder color="var(--color-ruta-oceanica)" etiqueta="3 — Mapa y servicios" />
	</Pantalla>
	<Pantalla id="rutas">
		<SlidePlaceholder color="var(--color-ruta-rural)" etiqueta="4 — Rutas + Pasaporte" />
	</Pantalla>
	<Pantalla id="centro-regional">
		<SlidePlaceholder color="var(--color-ruta-naturaleza)" etiqueta="5 — Centro Regional" />
	</Pantalla>
</Base>

<style>
	/* === Marca institucional — Pantalla 1, primer elemento (2026-08-28) ===
	 * 3 piezas separadas a propósito (no un solo bloque de texto) para poder animarlas cada una
	 * por su cuenta más adelante, si hace falta — pedido explícito de Ale.
	 */
	.marca-institucional {
		display: flex;
		flex-direction: column;
		gap: var(--espacio-xs);
	}

	/* "RENAMU /" — necesita una fuente GRUESA/institucional que no es --fuente-marca (Italiana es
	 * un solo peso 400, un bold sintético del navegador se vería mal en un Didone). Se reusa
	 * --fuente-display (Archivo, ya cargada para el Hero) — peso 800 (bajado un escalón desde 900,
	 * pedido de Ale 2026-08-28) en vez de sumar una familia nueva solo para esta palabra. Tamaño
	 * casi al doble del primer intento. Color celeste (2026-08-28, swap de color con "Sur en Ruta"
	 * de abajo). */
	.marca-renamu {
		margin: 0;
		font-family: var(--fuente-display);
		font-weight: 800;
		font-size: clamp(3.5rem, 1.8rem + 6.5vw, 7.5rem);
		line-height: 1;
		color: var(--color-celeste);
	}

	/* "Sur en Ruta" — misma fuente que el título del Preloader (--fuente-marca, Italiana,
	 * mayúsculas por CSS), un toque más grande que "RENAMU". Peso 700 (bold sintético del
	 * navegador — Italiana no tiene un corte bold real, pero probado en vivo se banca bien a este
	 * tamaño) y color marino (swap con "RENAMU" de arriba) — pedido de Ale 2026-08-28. Tracking y
	 * espaciado entre palabras bajados respecto del primer intento (0.06em → 0.015em, más
	 * word-spacing negativo), quedaba demasiado abierto a este tamaño tan grande. */
	.marca-sur-en-ruta {
		margin: 0;
		font-family: var(--fuente-marca);
		font-weight: 700;
		font-size: clamp(3.75rem, 2rem + 7vw, 8.25rem);
		line-height: 1;
		text-transform: uppercase;
		letter-spacing: 0.015em;
		word-spacing: -0.15em;
		color: var(--color-marino);
	}

	/* Bajada — misma fuente que el Hero (--fuente-display, Archivo) pero peso 500, pedido de Ale.
	 * Agrandada 2026-08-28 para que el renglón ocupe ~el mismo ancho que "RENAMU /" / "SUR EN
	 * RUTA" de arriba. Tamaño fijo (pedido puntual de Ale, no clamp) — bajado de 3rem a 2.12rem. */
	.marca-bajada {
		margin: var(--espacio-md) 0 0;
		font-family: var(--fuente-display);
		font-weight: 500;
		font-size: 2.12rem;
		line-height: 1.25;
		max-width: 26ch;
		color: var(--color-tinta);
	}

	/* Frase + ícono, lado a lado — ícono a la DERECHA (pedido de Ale). */
	.marca-conecta-fila {
		display: flex;
		align-items: center;
		gap: var(--espacio-md);
		margin-top: var(--espacio-md);
	}

	/* Cuerpo de texto (--fuente-texto, no --fuente-display) — es una cita de apoyo, no un
	 * enunciado display como los de arriba. Más chica que --marca-bajada (3rem). Las 4 palabras
	 * clave ya vienen resaltadas en la cita del mazo (ver docs/comparativa-mazo-vs-landing.md) —
	 * verde/oliva es el color de "palabras resaltadas" en todo el sitio (identidad-visual.md). */
	.marca-conecta {
		margin: 0;
		font-family: var(--fuente-texto);
		font-weight: 400;
		font-size: var(--texto-lg);
		line-height: 1.4;
		max-width: 36ch;
		color: var(--color-tinta);
	}

	/* Antes era un <strong>, ahora es un <span> (el reveal por palabra necesita envolver cada
	 * palabra en su propia máscara, ver .reveal-mascara) — mismo color/peso que antes. */
	.marca-conecta-resaltado {
		font-weight: 700;
		color: var(--color-verde);
	}

	/* === Pantalla 2 · "LA OPORTUNIDAD" (mazo pág. 2) — cabecera (2026-08-31) ===
	 * Título bicolor a 2 líneas (LA navy / OPORTUNIDAD verde), subrayado verde corto debajo, y el
	 * subtítulo. Mismo sistema visual que el mazo (título mayúsculas, 2 tintas, regla verde).
	 * ENTRADA (distinta a la P1, correcciones de Ale 2026-08-31): una CAJA con fondo propio
	 * (`--color-fondo` + sombra) que ATRAVIESA la pantalla y NUNCA se queda quieta.
	 * Referencia: el box de bertani.net es `<div data-scroll data-scroll-speed="4"
	 * data-scroll-direction="vertical">` — o sea Locomotive Scroll con **parallax VERTICAL a
	 * velocidad 4** (muy fuerte): la caja viaja > una pantalla de alto mientras la sección pasa, y
	 * está en `translateY(0)` justo cuando la sección se centra. Acá replicamos eso con un
	 * `translateY` grande (65vh → -65vh) sobre una ventana simétrica al centrado de la P2. El
	 * componente horizontal "derecha → izquierda" que se ve lo aporta SOLO el deslizamiento de la
	 * cinta (la tarjeta de la P2 ya viaja de derecha a izquierda) — la caja en sí es vertical, como
	 * bertani. Texto SIEMPRE nítido (nada de opacidad). `linear` + `--hz-progreso`. `.lamina`
	 * recorta (`overflow:hidden`) mientras la caja entra y sale de cuadro. */
	.op-cabecera {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--espacio-xs);
		/* la caja: fondo opaco que pasa por encima de lo que haya en la lámina */
		background: var(--color-fondo);
		padding: clamp(1rem, 3vh, 2rem) clamp(1.25rem, 3vw, 2.5rem) clamp(1.25rem, 3vh, 2.25rem);
		box-shadow: 0 30px 45px -28px rgba(15, 43, 77, 0.35);
		/* posición de reposo por defecto (sin scroll-driven → sin animación) */
		transform: translateY(0);
	}

	@supports (animation-timeline: scroll(root)) {
		.op-cabecera {
			animation: op-cabecera-desliza linear both;
			animation-timeline: --hz-progreso;
			will-change: transform;
		}
	}

	@keyframes op-cabecera-desliza {
		/* Parallax vertical fuerte (equivalente al data-scroll-speed="4" de bertani): la caja
		 * recorre ~1.3 pantallas de alto, entra desde abajo del cuadro y sale por arriba. Punto
		 * medio de la ventana = translateY(0), justo cuando la P2 se centra. El 65vh es el número
		 * a subir/bajar para más o menos "grosería". El horizontal lo pone la cinta, no este
		 * keyframe. */
		from {
			transform: translateY(65vh);
		}
		to {
			transform: translateY(-65vh);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.op-cabecera {
			animation: none !important;
			transform: translateY(0);
		}
	}

	.op-titulo {
		margin: 0;
		font-family: var(--fuente-display);
		font-weight: 800;
		font-size: clamp(3rem, 1.4rem + 6vw, 6.75rem);
		line-height: 0.95;
		text-transform: uppercase;
	}

	.op-titulo--l1 {
		color: var(--color-marino);
	}

	.op-titulo--l2 {
		color: var(--color-verde);
	}

	/* Regla verde corta bajo el título (sistema visual del mazo). Va como bloque después de la 2ª
	 * línea; ahora que toda la cabecera entra como un bloque (no hay reveal por palabra) puede vivir
	 * tranquila en el <p>. */
	.op-titulo--l2::after {
		content: '';
		display: block;
		width: 4.5rem;
		height: 0.4rem;
