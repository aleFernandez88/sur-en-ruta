---
/**
 * index.astro — landing de Sur en Ruta. Sigue el mazo de Ana (`Presentacion Sur en Ruta
 * RENAMU.pdf`, 10 páginas) 1:1 — ver docs/landing-contenido.md y docs/comparativa-mazo-vs-landing.md.
 * Se arma pantalla por pantalla, guiado por Ale, no todo de una vez.
 *
 * Recorrido de la "cinta" (ver Pantalla.astro y base.css): Hero propio (Pantalla 0) → Pantalla 1
 * PORTADA (mazo pág. 1, CERRADA) → Pantalla 2 "LA OPORTUNIDAD" (mazo pág. 2, CERRADA — Ale: "no
 * quiero agregar más elementos, está muy cargada") → Pantalla 3 "¿Qué es RENAMU / Sur en Ruta?"
 * (mazo pág. 3, `id="sistema"`, CERRADA 2026-09-01) → Pantalla 4 "Cómo funciona la red" (mazo
 * pág. 4, `id="como-funciona"`, en construcción 2026-09-02) → 1 SlidePlaceholder (centro-regional)
 * hasta que se mapeen las págs. 5..10 del mazo. Cada pantalla del mazo es `<Pantalla completa>`
 * (el look full-bleed del mazo lo necesita); el Hero también.
 *
 * `N_PANTALLAS` (abajo) = total de <Pantalla>. TODAS las ventanas de animación scroll-driven se
 * calculan a partir de ese número (ver `esc()`), así sumar una pantalla del mazo es cambiar ese
 * número + agregar la parada en HiloRuta.astro (`recorrido`), sin recalibrar a mano.
 */
import Base from '../layouts/Base.astro';
import Pantalla from '../components/Pantalla.astro';
import Hero from '../components/Hero.astro';
import Lamina from '../components/Lamina.astro';
import SlidePlaceholder from '../components/SlidePlaceholder.astro';
import Icono from '../components/Icono.astro';
import { componentes } from '../data/componentes.ts';
import logoUrl from '../assets/logo/isotipo-original.svg?url';
import { Image } from 'astro:assets';
// PLACEHOLDER, no deployar así — trae el logo de Dometic visible y no es Uruguay. Ver
// src/assets/oportunidad/FUENTE.md. Pasada por Ale el 2026-08-28 para probar layout + la foto fija
// mientras se consigue la foto real ("camper en ruta costera", docs/landing-contenido.md § P.1).
import fotoOportunidad from '../assets/oportunidad/camping-placeholder.png';

/* === Animaciones de entrada de Pantalla 1 (2026-08-28) ===
 * Pedido de Ale: "mejores que fade in". Reveal enmascarado (overflow:hidden + translateY, ver
 * @keyframes texto-sube en el <style>) por LÍNEA para el wordmark grande (2 líneas cortas) y por
 * PALABRA para los párrafos (mismo espíritu que el "text splitting" de sitios premiados — ver
 * memoria del proyecto). Atado al mismo --hz-progreso que ya usa la foto fija (.fondo-oportunidad).
 *
 * OJO — tres gotchas reales encontrados en vivo, en direcciones distintas:
 * 1. La tarjeta de una pantalla `completa` NO se queda quieta en ningún momento — se desliza 1:1
 *    con el scroll TODO el tiempo, sin pausa. Solo hay un INSTANTE en que queda perfectamente
 *    centrada (getBoundingClientRect a distintos %: para Pantalla 1, 26.0% exacto), pero se
 *    mantiene SUSTANCIALMENTE visible (>60-80% del viewport) en un rango bastante más amplio,
 *    medido en vivo: ~17% a ~35%.
 * 2. Una ventana DEMASIADO angosta (~1.3 puntos ≈ 9px de scroll real, primer intento) es MENOS
 *    que un solo tick de rueda de mouse — el usuario scrolleaba una vez y todo aparecía de golpe,
 *    sin frames intermedios. Necesita cientos de px reales (1% ≈ 61px acá) para verse progresiva.
 * 3. Una ventana que TERMINA DESPUÉS del instante de centrado (26%) hace que el usuario "llegue"
 *    a la pantalla con la entrada todavía a mitad de camino — reportado por Ale como "tengo que
 *    pasar media pantalla para ver todo, en el momento exacto solo se ve la primera letra". La
 *    secuencia entera tiene que TERMINAR antes o justo en el instante de centrado, no extenderse
 *    después — por eso arranca bien antes (15%) y termina en el centrado (25.8%), no [20,32].
 */
/* Cantidad total de <Pantalla> en la cinta (incluye el Hero). El instante en que cada bloque k
 * queda centrado es ~100·k/(N-1) % del scroll-timeline --hz-progreso, y de ahí salen TODAS las
 * ventanas de animación de abajo. Los tiempos crudos se afinaron EN VIVO con N=5 (centro de
 * Pantalla 1 medido ~26%); `esc()` los reescala al N actual. Cuando se sumen las pantallas que
 * faltan del mazo, subir este número (y agregar la parada en HiloRuta.astro `recorrido`) es lo
 * único que hay que tocar para recalibrar. */
const N_PANTALLAS = 6;
const P1_CENTRO = 100 / (N_PANTALLAS - 1); // % de --hz-progreso en que la Pantalla 1 (portada) se centra
const CENTRO_REF = 26; // centro de P1 con el que se afinaron los tiempos crudos (N=5, medido en vivo)
const K = P1_CENTRO / CENTRO_REF;
// Reescala un tiempo crudo de Pantalla 1. `pantalla` (default 1) lo corre a otra pantalla de la
// cinta: la 2 arranca CENTRO_REF más adelante en la escala cruda, etc.
const esc = (v: number, pantalla = 1): number =>
	+((v + (pantalla - 1) * CENTRO_REF) * K).toFixed(3);
const rango = (desde: number, hasta: number, pantalla = 1): string =>
	`${esc(desde, pantalla)}% ${esc(hasta, pantalla)}%`;

function rangoPalabra(
	inicio: number,
	indice: number,
	paso: number,
	duracion: number,
	pantalla = 1,
): string {
	const desde = esc(inicio + indice * paso, pantalla);
	return `${desde.toFixed(3)}% ${(desde + duracion * K).toFixed(3)}%`;
}

const RENAMU_RANGO = rango(15, 16);
const SURENRUTA_RANGO = rango(15.7, 16.7);
const FONDO_FIJO_RANGO = rango(12, 24);
const PIE_MARCA_RANGO = rango(19.5, 25);

const BAJADA_TEXTO = 'Una red para ordenar y potenciar el turismo itinerante en Uruguay';
const BAJADA_INICIO = 16.9;
const BAJADA_PASO = 0.34;
const BAJADA_DURACION = 0.65;
// split con grupo de captura: alterna palabra/espacio/palabra/... el espacio se renderiza tal
// cual (sin animación) para no romper el ajuste de línea natural del párrafo.
const bajadaPartes = BAJADA_TEXTO.split(/(\s+)/).filter((p) => p !== '');

interface Segmento {
	texto: string;
	resaltado: boolean;
}
// Cita textual del mazo (ver docs/comparativa-mazo-vs-landing.md) — las 4 palabras ya venían
// resaltadas ahí. Se arma por segmentos (no un solo string) para poder aplicar el reveal
// palabra por palabra SIN perder el resaltado de esas 4.
const CONECTA_SEGMENTOS: Segmento[] = [
	{ texto: 'Una propuesta que conecta ', resaltado: false },
	{ texto: 'viajeros', resaltado: true },
	{ texto: ', ', resaltado: false },
	{ texto: 'territorios', resaltado: true },
	{ texto: ', ', resaltado: false },
	{ texto: 'servicios', resaltado: true },
	{ texto: ' y ', resaltado: false },
	{ texto: 'experiencias', resaltado: true },
	{ texto: '.', resaltado: false },
];
interface Palabra {
	texto: string;
	resaltado: boolean;
	esEspacio: boolean;
}
const conectaPalabras: Palabra[] = [];
for (const segmento of CONECTA_SEGMENTOS) {
	if (segmento.resaltado) {
		conectaPalabras.push({ texto: segmento.texto, resaltado: true, esEspacio: false });
		continue;
	}
	for (const parte of segmento.texto.split(/(\s+)/)) {
		if (parte === '') continue;
		conectaPalabras.push({ texto: parte, resaltado: false, esEspacio: parte.trim() === '' });
	}
}
const CONECTA_INICIO = 21.4;
const CONECTA_PASO = 0.31;
const CONECTA_DURACION = 0.55;
const ICONO_RANGO = rango(24.5, 25.3);

/* === Pantalla 2 · "LA OPORTUNIDAD" (mazo pág. 2) ===
 * Entrada DISTINTA a la de la Pantalla 1 (pedido de Ale: cada pantalla elige su animación, no se
 * repite el reveal enmascarado). Acá: título + subtítulo en UNA caja (`.op-cabecera`, con fondo
 * propio) que se desliza en vertical a la par del scroll y NUNCA se queda quieta — sigue moviéndose
 * incluso cuando la P2 está saliendo. Texto SIEMPRE nítido (sin fade); lo único que se anima es
 * `translateY`. Atado a --hz-progreso, linear. La caja pasa por encima de los 2 bloques (los tapa
 * al deslizarse) pero por DEBAJO de los 4 chips (z-index, ver .op-chips) — así su parallax no
 * esconde la entrada escalonada de los chips.
 * Hecho: cabecera + 2 bloques + 4 chips + su ruta de nodos. Falta: el cierre, la foto y el eyebrow. */
const P2_CENTRO = P1_CENTRO * 2; // % de --hz-progreso en que la Pantalla 2 se centra
// Ventana SIMÉTRICA alrededor del centrado de la P2 → la caja pasa por translateY(0) EXACTO en el
// punto medio (cuando la P2 está centrada) y sigue de largo hacia arriba. El componente horizontal
// "der → izq" lo aporta el deslizamiento de la cinta, no este keyframe.
const OP_CABECERA_RANGO = `${(P2_CENTRO - 20).toFixed(2)}% ${(P2_CENTRO + 20).toFixed(2)}%`;
const OP_SUBTITULO_TEXTO = 'Una nueva forma de viajar necesita una nueva forma de organizarse';

// Cierre de P2 ("Sin una red organizada…", mazo pág. 2), sobre la onda del footer — mismo efecto
// de "choque" que el logo del footer de p1 (`.pie-marca` / `@keyframes pie-marca-choca`, ver más
// abajo). Mismos números crudos que PIE_MARCA_RANGO (19.5 → 25), solo que reescalados a la
// Pantalla 2 con el 3er parámetro de `rango()` — es EXACTAMENTE el mecanismo que ya existe en este
// archivo para correr una animación calibrada en p1 a una pantalla más adelante (ver `esc()`),
// así que el timing relativo (cuánto dura, cuánto antes del centrado asienta) queda igual.
const OP_CIERRE_RANGO = rango(19.5, 25, 2);

/* Entrada progresiva de los 4 chips (pedido de Ale): la ruta se "dibuja" y cada nodo + su chip
 * entran escalonados, TODO atado a --hz-progreso. Cada elemento lleva su `animation-range` inline
 * (Chrome no resuelve `animation-range` con var()).
 * Los chips van POR ENCIMA de la caja de la cabecera (z-index, ver .op-chips) — la caja hace su
 * parallax por DETRÁS, así que ya no los tapa y la entrada se aprecia. La ventana va durante la
 * aproximación de la P2 y termina en el centrado (misma lógica que el resto de las entradas). */
const CHIPS = [
	{ icono: 'libertad', label: 'Libertad' },
	{ icono: 'naturaleza', label: 'Naturaleza' },
	{ icono: 'experiencias', label: 'Experiencias' },
	{ icono: 'economia-local', label: 'Economía local' },
] as const;
const CHIPS_INICIO = P2_CENTRO - 13;
const CHIP_PASO = 1.6; // separación entre chip y chip (y entre nodo y nodo)
const rangoChip = (k: number, off: number, dur: number): string => {
	const d = CHIPS_INICIO + off + k * CHIP_PASO;
	return `${d.toFixed(2)}% ${(d + dur).toFixed(2)}%`;
};
// La ruta termina de dibujarse justo cuando aparece el último nodo (así "alcanza" a cada nodo al
// pasar por él).
const CHIPS_RUTA_RANGO = `${CHIPS_INICIO.toFixed(2)}% ${(CHIPS_INICIO + (CHIPS.length - 1) * CHIP_PASO + 1.8).toFixed(2)}%`;

// Stack de foto-cards del mazo (pág. 2), en diagonal, sangrando por la derecha. PLACEHOLDER:
// gradiente + label hasta tener las 4 fotos reales de Uruguay (faro / viñedo / cartel / feria).
const GALERIA = ['Faro', 'Viñedo', 'Cartel indicador', 'Feria local'];

// Tira de fotos del mazo pág. 4 — 4 fotos (contadas a mano sobre el render del PDF, NO 5: el
// timeline tiene 5 pasos pero la tira de abajo es independiente, son cosas distintas). Mismo
// mecanismo que `GALERIA`/`.op-galeria` de P2 (slot `galeria`), sin fotos reales todavía — PLACEHOLDER
// en gradiente plano con uno de los `--color-ruta-*` por card (mismo criterio que tuvo P2 antes de
// tener las fotos reales).
const PASOS_GALERIA = ['Servicios', 'App Sur en Ruta', 'Comercio local', 'Naturaleza que conecta'];

/* === Pantalla 3 · "¿Qué es RENAMU / Sur en Ruta?" (mazo pág. 3) ===
 * Arrancada 2026-09-01, guiada por Ale, elemento por elemento (mismo flujo que P2) — ver el plan
 * en la memoria del proyecto. Mismo mecanismo de cabecera y de tarjetas-con-ruta que P2, reusado
 * tal cual donde se pueda en vez de reinventarlo. */
const P3_CENTRO = P1_CENTRO * 3; // % de --hz-progreso en que la Pantalla 3 se centra
// Misma caja/parallax que P2 (.op-cabecera, @keyframes op-cabecera-desliza) — pedido de Ale: "para
// el título también usemos el diseño de pantalla 2". Se reusan las clases `.op-*` tal cual (no una
// copia `.sis-*`) porque el diseño es idéntico, solo cambia el rango (centrado en P3_CENTRO).
const SIS_CABECERA_RANGO = `${(P3_CENTRO - 20).toFixed(2)}% ${(P3_CENTRO + 20).toFixed(2)}%`;

// Las 6 tarjetas numeradas (mazo pág. 3) — mismo mecanismo que los 4 chips de P2 (ruta ondulada +
// nodos + entrada escalonada), extendido a 6 paradas. El copy sale de `componentes` (dato ya
// verificado contra el PDF de propuesta, secc. 4.1-4.6) — solo se usa `nombre` acá (la
// `descripcion` es del PDF, no del mazo, y es muy larga para una tarjeta chica tipo chip).
const SIS_CHIPS_ICONOS = ['area', 'puntos-amigos', 'sello', 'ruta', 'pasaporte', 'app'] as const;
const SIS_CHIPS = componentes.map((c, k) => ({ icono: SIS_CHIPS_ICONOS[k], label: c.nombre }));
const SIS_CHIPS_INICIO = P3_CENTRO - 16; // más margen que P2_CENTRO-13: son 6 paradas, no 4
const SIS_CHIP_PASO = 1.6;
const rangoSisChip = (k: number, off: number, dur: number): string => {
	const d = SIS_CHIPS_INICIO + off + k * SIS_CHIP_PASO;
	return `${d.toFixed(2)}% ${(d + dur).toFixed(2)}%`;
};
const SIS_CHIPS_RUTA_RANGO = `${SIS_CHIPS_INICIO.toFixed(2)}% ${(SIS_CHIPS_INICIO + (SIS_CHIPS.length - 1) * SIS_CHIP_PASO + 1.8).toFixed(2)}%`;

// Línea-ruta ondulada para las 6 tarjetas — mismo formato que `.op-chips-ruta` de P2 (línea +
// nodos llenos), pero generada por fórmula en vez de a mano: con 6 paradas (vs. 4 en P2) tallar la
// curva bezier punto por punto a mano era mucho más frágil. Un seno cuyo semiperíodo coincide con
// la separación entre nodos cruza la línea de base (y=15) EXACTO en cada nodo — mismo resultado
// visual (ondula entre nodo y nodo) sin ajustar puntos de control uno por uno.
const SIS_RUTA_Y = 15;
const SIS_RUTA_AMP = 7;
const SIS_RUTA_SEPARACION = 100 / SIS_CHIPS.length; // % entre nodo y nodo
const SIS_RUTA_X0 = SIS_RUTA_SEPARACION / 2; // x del primer nodo
const sisRutaY = (x: number): number =>
	SIS_RUTA_Y + SIS_RUTA_AMP * Math.sin((2 * Math.PI * (x - SIS_RUTA_X0)) / (2 * SIS_RUTA_SEPARACION));
let dSisRuta = `M 2 ${sisRutaY(2).toFixed(2)}`;
for (let i = 1; i <= 60; i++) {
	const x = 2 + (96 * i) / 60;
	dSisRuta += ` L ${x.toFixed(2)} ${sisRutaY(x).toFixed(2)}`;
}

// Entrada de los 2 nodos (RENAMU / Sur en Ruta), pedido de Ale: "que vengan desde arriba, al mando
// del scroll". Animan el BLOQUE ENTERO (ícono + nombre + texto juntos, no solo el ícono) — si el
// ícono se mueve y el texto queda quieto se leen como 2 cosas separadas en vez de "un nodo"
// entrando. Sin opacity (regla ya fijada en la cabecera de P2: "el texto nunca debe quedar
// transparente", Ale) — solo `translateY`.
// OJO: el inicio NO puede ir muy antes de P3_CENTRO — a diferencia de P2 (una sola lámina fija que
// solo hace zoom/parallax), acá la cinta todavía está deslizando ESTA lámina desde la derecha en
// ese tramo del scroll. Medido con scroll real + getBoundingClientRect: con P3_CENTRO-19 (=41%) el
// rango terminaba en ~44.6%, pero los bloques recién empiezan a asomar en pantalla ~44-46% y no
// quedan cómodamente visibles hasta ~50% — la animación completaba entera FUERA de cámara y llegaba
// ya asentada (`translateY:0`) apenas se veía, invisible para Ale.
// Segundo ajuste (Ale): que NO caigan a la vez — RENAMU primero, Sur en Ruta después (secuencial, no
// superpuesto) — y que las 2 caídas terminen justo cuando termina de entrar la ÚLTIMA tarjeta
// numerada (mismo instante que `rangoSisChip(SIS_CHIPS.length - 1, 0.8, 2.4)`, calculado abajo para
// no repetir el número mágico). Con eso el cierre de la pantalla queda: nodos + última tarjeta
// asentándose juntos.
const SIS_NODOS_DUR = 3; // duración de la caída de cada nodo
const SIS_NODOS_FIN = SIS_CHIPS_INICIO + 0.8 + (SIS_CHIPS.length - 1) * SIS_CHIP_PASO + 2.4; // = fin de la última tarjeta
const SIS_NODOS_INICIO = SIS_NODOS_FIN - 2 * SIS_NODOS_DUR; // 2 caídas seguidas, sin superponerse
const rangoSisNodo = (k: number): string => {
	const d = SIS_NODOS_INICIO + k * SIS_NODOS_DUR;
	return `${d.toFixed(2)}% ${(d + SIS_NODOS_DUR).toFixed(2)}%`;
};

// Cierre de P3 ("Un sistema que conecta…", mazo pág. 3), mismo mecanismo que el cierre de P2
// (reusa @keyframes pie-marca-choca, mismos números crudos de PIE_MARCA_RANGO reescalados —
// esta vez a la Pantalla 3 con rango(..., 3)).
const SIS_CIERRE_RANGO = rango(19.5, 25, 3);

/* === Pantalla 4 · "Cómo funciona la red" (mazo pág. 4) ===
 * Arrancada 2026-09-02, guiada por Ale, elemento por elemento (mismo flujo que P2/P3) — ver el
 * plan en C:\Users\zhuki\.claude\plans\validated-purring-tulip.md. Reusa el patrón de cabecera
 * bicolor de 2 líneas de P2 (`.op-cabecera`/`.op-titulo`, no el de P3) porque el contenido calza
 * igual (palabra corta navy + frase verde). */
const P4_CENTRO = P1_CENTRO * 4; // % de --hz-progreso en que la Pantalla 4 se centra
const COMO_CABECERA_RANGO = `${(P4_CENTRO - 20).toFixed(2)}% ${(P4_CENTRO + 20).toFixed(2)}%`;

// Los 5 pasos (mazo pág. 4) — mismo mecanismo de ruta+nodos+tarjetas escalonadas al scroll que
// P2/P3 (ver SIS_CHIPS/sisRutaY arriba), pero con tarjetas NUEVAS `.pasos-card` (ícono + título en
// negrita + frase de apoyo — más contenido que un chip simple de ícono+label) sobre fondo CLARO: el
// mazo las muestra así, y P4 no tiene una cuña navy debajo como P3, no hace falta el tratamiento
// oscuro. El número "01".."05" vive en el NODO de la línea (círculo verde grande), no en la
// tarjeta — así calza con el mazo, que lo dibuja arriba, sobre la línea, no adentro de la card.
const PASOS = [
	{
		icono: 'ubicacion',
		titulo: 'Encontrá puntos y rutas',
		frase: 'La red te muestra dónde parar y qué hay cerca.',
	},
	{
		icono: 'planificar',
		titulo: 'Planificá tu recorrido',
		frase: 'Cada punto informa servicios, horarios y condiciones.',
	},
	{
		icono: 'servicios',
		titulo: 'Accedé a servicios y experiencias',
		frase: 'El viaje se vuelve más fácil, seguro y memorable.',
	},
	{
		icono: 'sello',
		titulo: 'Sumá sellos y beneficios',
		frase: 'Cada parada se transforma en una experiencia con historia.',
	},
	{
		icono: 'naturaleza',
		titulo: 'Viajá de forma responsable',
		frase: 'Las buenas prácticas fortalecen el cuidado y la convivencia.',
	},
] as const;
const PASOS_INICIO = P4_CENTRO - 16;
const PASOS_PASO = 1.6;
const rangoPasos = (k: number, off: number, dur: number): string => {
	const d = PASOS_INICIO + off + k * PASOS_PASO;
	return `${d.toFixed(2)}% ${(d + dur).toFixed(2)}%`;
};
const PASOS_RUTA_RANGO = `${PASOS_INICIO.toFixed(2)}% ${(PASOS_INICIO + (PASOS.length - 1) * PASOS_PASO + 1.8).toFixed(2)}%`;

// Línea ondulada — misma fórmula que P3 (sisRutaY), adaptada a 5 paradas.
const PASOS_RUTA_Y = 15;
const PASOS_RUTA_AMP = 7;
const PASOS_RUTA_SEPARACION = 100 / PASOS.length;
const PASOS_RUTA_X0 = PASOS_RUTA_SEPARACION / 2;
const pasosRutaY = (x: number): number =>
	PASOS_RUTA_Y +
	PASOS_RUTA_AMP * Math.sin((2 * Math.PI * (x - PASOS_RUTA_X0)) / (2 * PASOS_RUTA_SEPARACION));
let dPasosRuta = `M 2 ${pasosRutaY(2).toFixed(2)}`;
for (let i = 1; i <= 60; i++) {
	const x = 2 + (96 * i) / 60;
	dPasosRuta += ` L ${x.toFixed(2)} ${pasosRutaY(x).toFixed(2)}`;
}

// Cierre de P4 ("Una red que organiza el viaje y potencia los destinos.", mazo pág. 4) — mismo
// mecanismo que P2/P3.
const COMO_CIERRE_RANGO = rango(19.5, 25, 4);
---

<Base>
	<!-- Foto FIJA al viewport de Pantalla 1 (2026-08-28, pedido de Ale: "la foto 100% fija, que
	     todo el sitio se mueva"). Vive en la capa .fondo-fijo de Base.astro (fuera de .hz-track,
	     ver ahí el porqué). Recorte en curva S: solo se ve la mitad derecha, con la curva sobre su
	     borde izquierdo. Hace fade-in con --hz-progreso mientras Pantalla 1 entra y después queda
	     visible (no se apaga): los .hz-bloque vecinos son opacos y la tapan solos. Placeholder. -->
	<div
