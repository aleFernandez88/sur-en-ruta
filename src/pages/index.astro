	.marca-conecta-resaltado {
		font-weight: 700;
		color: var(--color-verde);
	}

	/* === Pantalla 2 · "LA OPORTUNIDAD" (mazo pág. 2) — cabecera (2026-08-31) ===
	 * Título bicolor a 2 líneas (LA navy / OPORTUNIDAD verde), subrayado verde corto debajo, y el
	 * subtítulo. Mismo sistema visual que el mazo (título mayúsculas, 2 tintas, regla verde).
	 * ENTRADA (distinta a la P1, correcciones de Ale 2026-08-31): una CAJA con fondo propio
	 * (`--color-fondo` + sombra) que ATRAVIESA la pantalla y NUNCA se queda quieta.
	 * Referencia: el box de bertani.net es `<div data-scroll data-scroll-speed="4"
	 * data-scroll-direction="vertical">` — o sea Locomotive Scroll con **parallax VERTICAL a
	 * velocidad 4** (muy fuerte): la caja viaja > una pantalla de alto mientras la sección pasa, y
	 * está en `translateY(0)` justo cuando la sección se centra. Acá replicamos eso con un
	 * `translateY` grande (65vh → -65vh) sobre una ventana simétrica al centrado de la P2. El
	 * componente horizontal "derecha → izquierda" que se ve lo aporta SOLO el deslizamiento de la
	 * cinta (la tarjeta de la P2 ya viaja de derecha a izquierda) — la caja en sí es vertical, como
	 * bertani. Texto SIEMPRE nítido (nada de opacidad). `linear` + `--hz-progreso`. `.lamina`
	 * recorta (`overflow:hidden`) mientras la caja entra y sale de cuadro. */
	.op-cabecera {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--espacio-xs);
		/* la caja: fondo opaco que pasa POR ENCIMA de los 2 bloques (z-index) mientras hace su
		 * parallax — "una caja que se mueve sobre el contenido" (Ale). */
		position: relative;
		z-index: 2;
		background: var(--color-fondo);
		padding: clamp(0.75rem, 2vh, 1.4rem) clamp(1.25rem, 3vw, 2.25rem) clamp(0.9rem, 2vh, 1.5rem);
		box-shadow: 0 30px 45px -28px rgba(15, 43, 77, 0.35);
		/* posición de reposo por defecto (sin scroll-driven → sin animación) */
		transform: translateY(0);
	}

	@supports (animation-timeline: scroll(root)) {
		.op-cabecera {
			animation: op-cabecera-desliza linear both;
			animation-timeline: --hz-progreso;
			will-change: transform;
		}
	}

	@keyframes op-cabecera-desliza {
		/* Parallax vertical: la caja entra desde abajo y sale por arriba, pasando por translateY(0)
		 * justo cuando la P2 se centra (punto medio de la ventana). Bajado de 65vh a 22vh
		 * (2026-08-31) y de 22vh a 6vh (2026-09-01): con 22vh la caja seguía tapando la primera
		 * línea de los 2 bloques durante buena parte del tramo de ENTRADA (medido con scroll fino:
		 * de ~25% a ~37% del progreso de la cinta, bien después de que la caja ya estaba asentada
		 * horizontalmente) — mucho más que un "roce", el texto quedaba ilegible varios scrolls
		 * seguidos. Con 6vh el recorrido vertical (12vh en total) se resuelve antes de que la caja
		 * termine de entrar horizontalmente, así que en la práctica ya no llega a taparlo. Sigue
		 * habiendo parallax (la caja se mueve, no queda estática) — solo que menos dramático. */
		from {
			transform: translateY(6vh);
		}
		to {
			transform: translateY(-6vh);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.op-cabecera {
			animation: none !important;
			transform: translateY(0);
		}
	}

	.op-titulo {
		margin: 0;
		font-family: var(--fuente-display);
