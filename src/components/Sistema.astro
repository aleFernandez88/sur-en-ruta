---
/**
 * Sistema.astro — Sección 3. RENAMU ordena el territorio, Sur en Ruta lo conecta.
 *
 * Copy real cargado el 2026-08-24. Los 6 componentes salen de src/data/componentes.ts (cargados
 * el 2026-08-21) y los 4 niveles de punto de src/data/niveles-punto.ts — ambos verificados contra
 * el documento de propuesta original (secc. 3, 4.1-4.6 y 11.2).
 *
 * Pendiente, fuera de este paso: iconografía SVG propia por componente (hoy un placeholder
 * discreto) y el revelado escalonado al entrar en viewport, que es comportamiento (paso 12).
 */
import { componentes } from '../data/componentes';
import { nivelesPunto } from '../data/niveles-punto';
---

<section id="sistema" aria-labelledby="sistema-titulo">
	<h2 id="sistema-titulo">RENAMU ordena el territorio. Sur en Ruta lo conecta.</h2>

	<div class="sistema-diagrama">
		<div class="capa">
			<strong>RENAMU</strong>
			<p>Marco institucional y territorial: articula con intendencias y municipios.</p>
		</div>
		<div class="capa">
			<strong>Sur en Ruta</strong>
			<p>Plataforma de conexión, comunicación y activación comercial sobre ese marco.</p>
		</div>
	</div>

	<ul class="sistema-componentes">
		{componentes.map((componente) => (
			<li class="tarjeta-componente">
				{/* TODO: iconografía SVG propia por componente */}
				<span class="icono-placeholder" aria-hidden="true"></span>
				<strong>{componente.nombre}</strong>
				<span>{componente.descripcion}</span>
			</li>
		))}
	</ul>

	<div class="sistema-niveles">
		<h3>La escalera de los 4 niveles de punto</h3>
		<ol class="escalera">
			{nivelesPunto.map((nivel) => (
				<li class="escalon" style={`--n: ${nivel.orden}`}>
					<span class="escalon-nombre">{nivel.nombre}</span>
				</li>
			))}
		</ol>
		<blockquote>
			"La inversión principal del proyecto no está solamente en infraestructura física, sino en
			crear un sistema ordenado."
		</blockquote>
	</div>
</section>

<style>
	section {
		padding: var(--espacio-2xl) var(--espacio-md);
		display: grid;
		gap: var(--espacio-lg);
	}

	h2 {
		font-size: var(--texto-2xl);
		max-width: 24ch;
	}

	.sistema-diagrama {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--espacio-sm);
	}

	.capa {
		padding: var(--espacio-md);
		background-color: var(--color-superficie);
		border-radius: var(--radio-md);
		text-align: center;
		display: grid;
		gap: var(--espacio-2xs);
	}

	.capa p {
		margin: 0;
		font-size: var(--texto-sm);
	}

	.sistema-componentes {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: var(--espacio-sm);
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.tarjeta-componente {
		padding: var(--espacio-md);
		background-color: var(--color-superficie);
		border-radius: var(--radio-md);
		display: grid;
		gap: var(--espacio-xs);
	}

	.tarjeta-componente span:last-child {
		font-size: var(--texto-sm);
	}

	.icono-placeholder {
		display: block;
		width: 2rem;
		height: 2rem;
		border-radius: var(--radio-sm);
		border: 2px dashed var(--color-tinta);
	}

	.escalera {
		display: grid;
		grid-auto-flow: column;
		gap: var(--espacio-xs);
		list-style: none;
		padding: 0;
		margin: var(--espacio-sm) 0;
	}

	.escalon {
		padding: var(--espacio-sm);
		background-color: var(--color-acento);
		color: var(--color-fondo);
		border-radius: var(--radio-sm);
		align-self: end;
		/* Altura ascendente ilustrativa: se afina cuando exista el gráfico real de la sección. */
		height: calc(3rem + var(--n) * 1rem);
		display: flex;
		align-items: flex-end;
	}

	.escalon-nombre {
		font-size: var(--texto-sm);
		font-weight: 700;
	}

	blockquote {
		margin: 0;
		font-style: italic;
		border-left: 3px solid var(--color-acento);
		padding-left: var(--espacio-sm);
	}
</style>
