---
/**
 * HiloRuta.astro — barra de navegación general del sitio, fija al borde IZQUIERDO de toda la
 * pantalla (rediseño 2026-08-28, reemplaza a la versión anterior: barra horizontal arriba, con
 * asfalto/línea central/cartelitos numerados — ver la memoria del proyecto para ese historial,
 * `--color-asfalto`/`--color-linea-central`/`--color-cartel-*` quedan sin uso en tokens.css).
 *
 * Pedido de Ale (2026-08-28), inspirado en el sidebar de bertani.net + el motivo real del footer
 * de la página 4 del mazo de Ana (línea punteada ondulada con nodos, ver
 * `docs/landing-contenido.md` § "Sistema visual del mazo"):
 *   - Arriba: ícono de menú (3 líneas), togglea un panel con el nombre de cada parada.
 *   - Abajo: UNA sola línea vertical con un par de ondas suaves (no recta), uniendo nodos — un
 *     nodo por parada (pantalla) del recorrido.
 *   - Colores: la línea/nodos arrancan en marino oscuro (`--color-marino`) y se van "pintando" de
 *     celeste (`--color-celeste`, referencia bandera uruguaya) a medida que avanza el scroll.
 *
 * Técnica de "pintado" (misma familia que el dibujado de la versión anterior, ver esa memoria):
 * DOS copias superpuestas de la misma curva+nodos — una marino, SIEMPRE dibujada entera (capa de
 * base, "todavía no recorrido"); otra celeste, adentro de un `<g mask="...">` cuyo trazo de
 * máscara se revela con el scroll (misma técnica pathLength=1 + stroke-dasharray/dashoffset +
 * `animation-timeline: --hz-progreso`, con `timeline-scope` ya declarado en `body`, ver
 * base.css). La celeste tapa a la marino a medida que el scroll "la alcanza" — no hace falta
 * lógica aparte por nodo, el mismo trazo de máscara cubre línea Y nodos porque ambos viven dentro
 * del mismo `<g>` enmascarado.
 *
 * Nodos posicionados con `offset-path` + `offset-distance` sobre la curva (misma técnica que la
 * versión anterior) — a propósito SIN `offset-anchor` explícito: cada `<circle>`/`<a>` tiene su
 * geometría centrada en el origen local (cx=0, cy=0), así el anchor por defecto ya cae bien. Fijar
 * `offset-anchor: center` a mano en un elemento contenedor (`<g>`/`<a>`) rompió el posicionamiento
 * en la versión anterior (ver memoria del proyecto, gotcha v8) — no repetir eso acá.
 *
 * Posiciones de paradas APROXIMADAS, no exactas — mismo criterio que la versión anterior: calcar
 * la posición real de cada sección en el scroll necesitaría JS midiendo layout, fuera de alcance
 * a propósito. La `distancia` (y el instante en que el nodo "llega") se reparte pareja según el
 * instante de centrado de cada bloque de la cinta: k/(N-1). Cuando se sumen las pantallas que
 * faltan del mazo (ver `docs/landing-contenido.md`), agregar la entrada acá y subir `N_PANTALLAS`
 * en `index.astro` — nada más.
 */

interface Parada {
	numero: number;
	nombre: string;
	id: string;
	distancia: number; // % a lo largo de la curva (posición VISUAL del nodo, repartida parejo)
	llegada: number; // % de --hz-progreso donde su pantalla se centra (cuándo se pinta/pulsa el nodo)
}

// Orden = orden de las <Pantalla> del mazo en index.astro. El Hero (Pantalla 0) NO está: es una
// portada sin contenido, no un destino navegable, y la barra recién aparece al entrar a la
// Pantalla 1 (ver .hilo-ruta-barra en el <style>). El primer nodo/parada es la Portada.
const recorrido: { nombre: string; id: string }[] = [
	{ nombre: 'Portada', id: 'portada' },
	{ nombre: 'La Oportunidad', id: 'oportunidad' },
	{ nombre: 'Mapa y servicios', id: 'mapa' },
	{ nombre: 'Rutas + Pasaporte', id: 'rutas' },
	{ nombre: 'Centro Regional', id: 'centro-regional' },
];

const paradas: Parada[] = recorrido.map((p, k, arr) => {
	// `distancia` = posición VISUAL del nodo en la curva, repartida parejo de ~8% a 97% (usa casi
	// toda la barra, sin que quede corrida hacia abajo).
	const distancia = Math.round(8 + (k / (arr.length - 1)) * 89);
	// `llegada` = % de --hz-progreso donde ESTA pantalla queda centrada (su mejor posición visual):
	// es el bloque k+1 de la cinta de N bloques (N = arr.length + 1, con el Hero) → k+1 / (N-1).
	// El pintado del "caminito" y el pulso del nodo se acomodan a esto (ver keyframes generados).
	const llegada = Math.round(((k + 1) / arr.length) * 100);
	return { numero: k + 1, nombre: p.nombre, id: p.id, distancia, llegada };
});

// El pintado celeste NO es lineal: tiene que llegar al nodo k (posición visual `distancia`) justo
// cuando su pantalla se centra (`llegada`). Se generan los keyframes con un stop por parada — su %
// es el `llegada` y el `stroke-dashoffset` es `1 - distancia/100` (fracción de curva pintada). Va
// en un <style is:global set:html> porque un <style> normal de Astro no se puede templatear.
const paintKeyframes = `@keyframes hilo-ruta-pintar {
  0% { stroke-dashoffset: 1; }
  ${paradas
		.map((p) => `${p.llegada}% { stroke-dashoffset: ${(1 - p.distancia / 100).toFixed(4)}; }`)
		.join('\n  ')}
}`;

// Ventana de "llegada" de cada nodo (el latido + anillo, ver estilos más abajo): rango angosto
// del scroll-timeline compartido (--hz-progreso) centrado en la distancia exacta del nodo. No
// hace falta clampear a [0,100] — el nodo más cercano a cada borde (3% / 97%) ya deja margen.
const VENTANA = 1.5;

// Entrada del menú (2026-08-28, pedido de Ale): cada LÍNEA arranca con un pequeño desfase
// sucesivo (arriba→abajo), y DENTRO de cada línea, cada LETRA arranca con su propio desfase más
// chico (izquierda→derecha) — se calcula acá, en build time (el contenido es estático), no con
// JS en el cliente: cada letra ya sale con su `animation-delay` puesto.
const LINE_STAGGER_MS = 90;
const LETTER_STAGGER_MS = 20;
// Duración de la animación de cada letra/número (entrada Y salida, ver @keyframes
// hilo-ruta-menu-entra) — un solo lugar para el valor: se pasa al CSS vía define:vars y el
// script de más abajo lo repite a mano (los <script> de Astro no tienen acceso directo al
// frontmatter) para calcular cuánto esperar antes de cerrar el fondo del todo.
const DURACION_LETRA_MS = 520;

// Curva vertical, un par de ondas suaves (2 ciclos completos) alrededor del eje central x=32.
// El viewBox/d de acá abajo son el valor de ARRANQUE (SSR, sin JS) sobre una referencia de 900 —
// el script al final del componente los recalcula contra el alto REAL del contenedor apenas
// carga (y en cada resize): sin eso, los nodos (círculos) salen ovalados, no redondos, porque
// `preserveAspectRatio="none"` estira ancho y alto por separado, y el alto real del viewport casi
// nunca coincide exacto con la referencia de 900 (ver comentario del script).
const ALTO_REFERENCIA = 900;
function generarCurva(alto: number): string {
	const BASE = 32;
	const AMP = 16;
	const seg = alto / 4;
	const o1 = seg / 3;
	const o2 = (2 * seg) / 3;
	const y1 = seg;
	const y2 = seg * 2;
	const y3 = seg * 3;
	const y4 = seg * 4;
	return (
		`M${BASE},0 ` +
		`C${BASE - AMP},${o1.toFixed(2)} ${BASE - AMP},${o2.toFixed(2)} ${BASE},${y1.toFixed(2)} ` +
		`S${BASE + AMP},${(y1 + o2).toFixed(2)} ${BASE},${y2.toFixed(2)} ` +
		`S${BASE - AMP},${(y2 + o2).toFixed(2)} ${BASE},${y3.toFixed(2)} ` +
		`S${BASE + AMP},${(y3 + o2).toFixed(2)} ${BASE},${y4.toFixed(2)}`
	);
}
const curva = generarCurva(ALTO_REFERENCIA);
// CSS `path()` exige un <string> citado — Astro serializa `define:vars` sin comillas.
const curvaOffsetPath = `"${curva}"`;

// OJO — --curva-offset-path NO va en `define:vars` (ver más abajo, esto costó un bug real): Astro
// copia cada variable de `define:vars` como estilo inline en TODOS los elementos que ya traen un
// atributo `style` propio (no solo en la raíz del componente). Como el script de acá abajo
// actualiza esta variable al cargar (para que los nodos calcen con la curva real, no la de
// referencia de 900), esa copia duplicada en cada `<circle>` quedaba pisando el valor nuevo con
// el viejo — solo el nodo más cercano al arranque de la curva (offset-distance chico) coincidía,
// porque ahí la curva vieja y la nueva casi no difieren. Se resuelve declarando esta variable a
// mano SOLO en el wrapper `.hilo-ruta` (una única fuente de verdad) y refiriéndola por CSS
// (`offset-path: path(var(--curva-offset-path))` en el `<style>` de abajo, no inline por nodo) —
// así los descendientes la heredan de verdad, y actualizarla en el wrapper alcanza para todos.

// El sitio carga ya "parado" en la parada 0 (Hero, la primera pantalla, visible sin scrollear),
// así que ese tramo tiene que verse ya pintado de celeste desde el arranque — mismo cálculo que
// la versión anterior (ver memoria del proyecto).
// El sitio carga en el Hero (Pantalla 0), ANTES de la primera parada — nada pintado todavía. (Antes
// arrancaba "parado" en la parada 0, con esa fracción ya pintada; ya no, el Hero no es parada.)
const dashoffsetInicial = 1;
const duracionLetra = `${DURACION_LETRA_MS}ms`;

// La barra entra deslizándose desde la izquierda antes de que la Pantalla 1 (Portada) se centre.
// La P1 es el bloque 1 de la cinta de N bloques (N = recorrido.length + 1, el Hero); se centra en
// ~100·1/(N-1) % de --hz-progreso. La ventana termina unos puntos antes de ese centro.
const p1Centro = 100 / recorrido.length;
const barraApareceRango = `${Math.max(2, Math.round(p1Centro - 15))}% ${Math.round(p1Centro - 7)}%`;
---

<div class="hilo-ruta" style={`--curva-offset-path: ${curvaOffsetPath}`}>
	{/* .hilo-ruta-barra es lo VISIBLE (fondo navy + botón + línea de ruta) y lo que se desliza desde
	    la izquierda al entrar a la Pantalla 1 — está oculta durante el Hero (ver <style>). El menú
	    de pantalla completa (.hilo-ruta-menu) queda FUERA de este wrapper a propósito: un `transform`
	    en un ancestro le crearía un containing block y su `position: fixed; inset: 0` dejaría de
	    tomar el viewport. */}
	<div class="hilo-ruta-barra" style={`animation-range: ${barraApareceRango}`}>
	<button
		type="button"
		class="hilo-ruta-menu-boton"
		aria-expanded="false"
		aria-controls="hilo-ruta-menu"
		aria-label="Abrir menú de secciones"
	>
		<span class="hilo-ruta-menu-linea"></span>
		<span class="hilo-ruta-menu-linea"></span>
		<span class="hilo-ruta-menu-linea"></span>
	</button>

	<svg
		class="hilo-ruta-svg"
		viewBox={`0 0 64 ${ALTO_REFERENCIA}`}
		preserveAspectRatio="none"
		xmlns="http://www.w3.org/2000/svg"
	>
		<defs>
			<path id="hilo-ruta-curva" d={curva} pathLength="1" fill="none"></path>
			<mask
				id="hilo-ruta-mascara"
				maskUnits="userSpaceOnUse"
				x="0"
				y="0"
				width="64"
				height={ALTO_REFERENCIA}
			>
				<use href="#hilo-ruta-curva" class="hilo-ruta-mascara-trazo"></use>
			</mask>
		</defs>

		<!-- Capa de base: marino, SIEMPRE dibujada entera ("todavía no recorrido"). -->
		<use href="#hilo-ruta-curva" class="hilo-ruta-linea-base" aria-hidden="true"></use>
		{paradas.map((parada) => (
			<circle
				class="hilo-ruta-nodo-base"
				r="7"
				aria-hidden="true"
				style={`offset-distance: ${parada.distancia}%`}
			></circle>
		))}

		<!-- Capa de progreso: celeste, revelada por scroll a través de la máscara. Cada nodo trae
		     además su propio anillo (aparece + el nodo "late" una vez al llegar, ver @keyframes
		     hilo-ruta-latido/hilo-ruta-anillo) acotado a una ventana angosta alrededor de `llegada`
		     (cuándo su pantalla se centra), vía --nodo-desde/--nodo-hasta. -->
		<g mask="url(#hilo-ruta-mascara)" aria-hidden="true">
			<use href="#hilo-ruta-curva" class="hilo-ruta-linea-progreso"></use>
			{paradas.map((parada) => (
				<>
					<circle
						class="hilo-ruta-nodo-anillo"
						r="11"
						style={`offset-distance: ${parada.distancia}%; --nodo-desde: ${parada.llegada - VENTANA}%; --nodo-hasta: ${parada.llegada + VENTANA}%`}
					></circle>
					<circle
						class="hilo-ruta-nodo-progreso"
						r="7"
						style={`offset-distance: ${parada.distancia}%; --nodo-desde: ${parada.llegada - VENTANA}%; --nodo-hasta: ${parada.llegada + VENTANA}%`}
					></circle>
				</>
			))}
		</g>

		<!-- Links de navegación reales, encima de todo, con área de click más grande que el nodo
		     visual — misma <svg>, así se superponen exacto sin trucos de stacking aparte. -->
		{paradas.map((parada) => (
			<a
				href={`#${parada.id}`}
				class="hilo-ruta-parada-link"
				style={`offset-distance: ${parada.distancia}%`}
				aria-label={`Ir a ${parada.nombre}`}
			>
				<circle r="14" fill="transparent"></circle>
			</a>
		))}
	</svg>
	</div>

	<nav id="hilo-ruta-menu" class="hilo-ruta-menu" aria-hidden="true">
		<ul>
			{paradas.map((parada, indice) => {
				const delayLinea = indice * LINE_STAGGER_MS;
				const letras = parada.nombre.split('');
				const delayNumero = delayLinea + letras.length * LETTER_STAGGER_MS;
				return (
					<li>
						<a href={`#${parada.id}`}>
							{/* aria-label lleva el nombre completo — las letras sueltas de abajo son
							    puramente visuales (aria-hidden), si no un lector de pantalla las
							    leería una por una. */}
							<span class="hilo-ruta-menu-nombre" aria-hidden="true">
								{letras.map((letra, j) => (
									<span
										class="hilo-ruta-menu-letra"
										style={`animation-delay: ${delayLinea + j * LETTER_STAGGER_MS}ms`}
									>
										{letra === ' ' ? ' ' : letra}
									</span>
								))}
							</span>
							<span
								class="hilo-ruta-menu-numero"
								aria-hidden="true"
								style={`animation-delay: ${delayNumero}ms`}
							>
								{String(parada.numero).padStart(2, '0')}
							</span>
							<span class="hilo-ruta-menu-solo-lectura">{parada.numero}. {parada.nombre}</span>
						</a>
					</li>
				);
			})}
		</ul>
	</nav>
</div>

<style define:vars={{ dashoffsetInicial, duracionLetra }}>
	/* Wrapper SOLO de posición — sin fondo ni transform (un transform acá le rompería el
	 * `position: fixed` al menú de pantalla completa que vive adentro). Lo visible y lo que se
	 * desliza es .hilo-ruta-barra. */
	.hilo-ruta {
		position: fixed;
		top: 0;
		left: 0;
		bottom: 0;
		width: var(--ancho-hilo-ruta);
		z-index: 60;
	}

	/* La barra visible: fondo azul casi negro (2026-08-31, Ale — deja de ser transparente). La
	 * línea de ruta, los nodos y el ícono de menú van en el claro cálido del fondo de las pantallas
	 * (--color-fondo) para leerse sobre este navy; el "progreso ya recorrido" sigue en celeste.
	 * ENTRA deslizándose desde la izquierda al acercarse la Pantalla 1 (pedido de Ale): oculta
	 * durante el Hero, aparece `justo antes` de que la P1 se centre. Ventana inline en el markup
	 * (depende de cuántas pantallas hay). */
	.hilo-ruta-barra {
		width: 100%;
		height: 100%;
		background: var(--color-marino-noche);
		display: flex;
		flex-direction: column;
		align-items: center;
		/* fallback sin scroll-driven: visible */
		transform: translateX(0);
	}

	@supports (animation-timeline: scroll(root)) {
		.hilo-ruta-barra {
			animation: hilo-ruta-barra-aparece linear both;
			animation-timeline: --hz-progreso;
		}
	}

	@keyframes hilo-ruta-barra-aparece {
		from {
			transform: translateX(-100%);
		}
		to {
			transform: translateX(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hilo-ruta-barra {
			animation: none !important;
			transform: translateX(0);
		}
	}

	/* --curva-offset-path se declara a mano en el wrapper (ver el div de arriba), no vía
	 * `define:vars` — el JS de más abajo la actualiza en runtime y necesita UNA sola fuente de
	 * verdad heredada, no una copia por elemento (ver el comentario largo en el frontmatter). Acá
	 * se referencia por CSS (no inline) para que cada nodo/link la herede de verdad. */
	.hilo-ruta-nodo-base,
	.hilo-ruta-nodo-progreso,
	.hilo-ruta-nodo-anillo,
	.hilo-ruta-parada-link {
		offset-path: path(var(--curva-offset-path));
	}

	/* === Ícono de menú (3 líneas → X al abrir) ===
	 * Más grande que la v1 (32px → 44px, líneas 22px → 30px) — pedido de Ale. z-index propio y por
	 * encima del panel (70) para que el botón siga siendo clickeable (para cerrar) aun con el
	 * panel de pantalla completa abierto encima del resto de la barra. */
	.hilo-ruta-menu-boton {
		position: relative;
		z-index: 80;
		flex-shrink: 0;
		margin-top: var(--espacio-lg);
		width: 44px;
		height: 44px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 7px;
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
		pointer-events: auto;
	}

	.hilo-ruta-menu-linea {
		width: 30px;
		height: 3px;
		border-radius: 1.5px;
		background: var(--color-fondo);
		transition:
			transform 280ms cubic-bezier(0.65, 0, 0.35, 1),
			opacity 180ms ease,
			background-color 200ms ease;
	}

	/* Al abrir el menú (panel navy a pantalla completa) las líneas pasan a celeste — estado activo,
	 * y contrasta mejor que el claro contra el navy del panel. */
	.hilo-ruta-menu-boton[aria-expanded='true'] .hilo-ruta-menu-linea {
		background: var(--color-celeste);
	}

	/* Morphing a X: la de arriba baja y rota, la del medio desaparece, la de abajo sube y rota. */
	.hilo-ruta-menu-boton[aria-expanded='true'] .hilo-ruta-menu-linea:nth-child(1) {
		transform: translateY(10px) rotate(45deg);
	}

	.hilo-ruta-menu-boton[aria-expanded='true'] .hilo-ruta-menu-linea:nth-child(2) {
		opacity: 0;
	}

	.hilo-ruta-menu-boton[aria-expanded='true'] .hilo-ruta-menu-linea:nth-child(3) {
		transform: translateY(-10px) rotate(-45deg);
	}

	/* === Línea + nodos === */
	.hilo-ruta-svg {
		flex: 1;
		width: 100%;
		display: block;
		/* El <svg> en sí no captura clicks (así se ve "a través" hacia el contenido de atrás donde
		 * no hay nada dibujado) — cada elemento interactivo recupera pointer-events por su cuenta. */
		pointer-events: none;
	}

	/* El path maestro (#hilo-ruta-curva) es solo geometría: sin stroke/fill propio, no se ve. OJO:
	 * no ponerle `visibility:hidden` — un <use> clona el id completo, esa regla apagaría también
	 * los <use> que lo pintan (gotcha ya documentado en la versión anterior). */

	.hilo-ruta-linea-base {
		/* Claro cálido sobre el navy de la barra (2026-08-31, Ale) — "todavía no recorrido". */
		stroke: var(--color-fondo);
		stroke-width: 3;
		stroke-linecap: round;
		fill: none;
	}

	.hilo-ruta-linea-progreso {
		stroke: var(--color-celeste);
		stroke-width: 3;
		stroke-linecap: round;
		fill: none;
		/* De trazos, no sólida — pedido de Ale 2026-08-28. OJO: el <path> maestro que este <use>
		 * clona tiene pathLength="1" (para el dashoffset del "pintado", ver .hilo-ruta-mascara-
		 * trazo más abajo), así que CUALQUIER stroke-dasharray acá se normaliza a esa escala — hay
		 * que pensar en fracciones de 1, no en píxeles (mismo gotcha ya documentado en la versión
		 * horizontal de este componente, ver memoria del proyecto). 0.014/0.01 ≈ trazo de 12-13px
		 * con hueco de 9px sobre esta curva. */
		stroke-dasharray: 0.014 0.01;
		/* Sombra sutil doble: da la sensación de que el tramo ya recorrido es más GRUESO que la
		 * ruta apagada, sin cambiar el stroke-width real (que tiene que seguir calzando con el
		 * trazo de la máscara). */
		filter:
			drop-shadow(0 0 2px color-mix(in srgb, var(--color-celeste) 75%, transparent))
			drop-shadow(0 0 5px color-mix(in srgb, var(--color-celeste) 45%, transparent));
	}

	.hilo-ruta-nodo-base,
	.hilo-ruta-nodo-progreso {
		/* Relleno = fondo de la barra (navy casi negro) → el nodo se lee como un anillo hueco,
		 * igual que antes cuando la barra era transparente sobre el claro. */
		fill: var(--color-marino-noche);
		stroke-width: 3;
	}

	.hilo-ruta-nodo-base {
		/* Mismo claro que la línea base (2026-08-31, Ale). */
		stroke: var(--color-fondo);
	}

	.hilo-ruta-nodo-progreso {
		stroke: var(--color-celeste);
		transform-box: fill-box;
		transform-origin: center;
		/* Estado de reposo fuera de @supports/sin scroll-timeline: ya "llegado", un poco más
		 * grande — ver @keyframes hilo-ruta-latido, que arranca desde scale(1) y decanta acá. */
		transform: scale(1.08);
	}

	/* Anillo que aparece alrededor del nodo al llegar — separado del nodo por 2px de aire (radio
	 * 11 contra el radio visual del nodo, ~8.5 con su stroke). Sin relleno, solo contorno. */
	.hilo-ruta-nodo-anillo {
		fill: none;
		stroke: var(--color-celeste);
		stroke-width: 1.5;
		transform-box: fill-box;
		transform-origin: center;
		opacity: 1;
	}

	/* Trazo de la máscara: ancho de sobra para tapar, en cualquier punto de la curva, tanto la
	 * línea (3) como el nodo completo (radio 7 + su stroke) — simétrico a cada lado del centro,
	 * por eso el valor es el doble del radio visual más margen, no la suma de las dos capas. */
	.hilo-ruta-mascara-trazo {
		fill: none;
		stroke: #fff;
		stroke-width: 24;
		stroke-linecap: round;
		stroke-dasharray: 1;
		/* Fallback sin soporte de scroll-timeline: máscara abierta del todo, todo el recorrido ya
		 * "pintado" de celeste — mismo criterio que la versión anterior (mostrar el estado final
		 * completo, nunca vacío ni a medio dibujar). */
		stroke-dashoffset: 0;
	}

	@supports (animation-timeline: scroll(root)) {
		.hilo-ruta-mascara-trazo {
			stroke-dashoffset: var(--dashoffsetInicial);
			animation: hilo-ruta-pintar linear both;
			animation-timeline: --hz-progreso;
		}

		/* Antes de su ventana, el nodo/anillo tienen que arrancar en su estado "todavía no
		 * llegué" (nodo tamaño normal, anillo invisible) — sin esto, el transform:scale(1.08) /
		 * opacity:1 de reposo (arriba) se vería ANTES de tiempo, ya que esas reglas no dependen
		 * del scroll. `animation-fill-mode: both` (parte de "both" en el shorthand) ya cubre el
		 * extremo final; el inicial lo fija el propio 0% del keyframe una vez que la animación
		 * está activa — pero mientras el scroll no entró en el rango, el navegador todavía no
		 * aplicó ningún frame, así que hace falta el estado "before" explícito acá. */
		.hilo-ruta-nodo-progreso {
			transform: scale(1);
			animation: hilo-ruta-latido linear both;
			animation-timeline: --hz-progreso;
			animation-range: var(--nodo-desde) var(--nodo-hasta);
		}

		.hilo-ruta-nodo-anillo {
			opacity: 0;
			animation: hilo-ruta-anillo linear both;
			animation-timeline: --hz-progreso;
			animation-range: var(--nodo-desde) var(--nodo-hasta);
		}
	}

	/* @keyframes hilo-ruta-pintar — generado en el frontmatter (piecewise, un stop por parada, así
	 * el celeste llega a cada nodo cuando su pantalla se centra) e inyectado en un <style is:global>
	 * más abajo. */

	/* Latido pronunciado, una sola vez, al llegar al nodo: sube fuerte, rebota corto y decanta
	 * en un tamaño de reposo apenas más grande (1.08) — no un crecimiento monótono. */
	@keyframes hilo-ruta-latido {
		0% {
			transform: scale(1);
		}
		35% {
			transform: scale(1.4);
		}
		55% {
			transform: scale(0.92);
		}
		75% {
			transform: scale(1.15);
		}
		100% {
			transform: scale(1.08);
		}
	}

	@keyframes hilo-ruta-anillo {
		0% {
			opacity: 0;
			transform: scale(0.6);
		}
		45% {
			opacity: 1;
		}
		100% {
			opacity: 1;
			transform: scale(1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hilo-ruta-mascara-trazo {
			animation: none !important;
			stroke-dashoffset: 0;
		}

		.hilo-ruta-nodo-progreso,
		.hilo-ruta-nodo-anillo {
			animation: none !important;
		}

		.hilo-ruta-nodo-progreso {
			transform: scale(1.08);
		}

		.hilo-ruta-nodo-anillo {
			opacity: 1;
		}
	}

	/* Los links son la única parte de los dos <svg> con pointer-events activo. */
	.hilo-ruta-parada-link {
		pointer-events: auto;
		cursor: pointer;
	}

	/* === Panel del menú — pantalla completa, estilo bertani.net (pedido de Ale 2026-08-28) ===
	 * Antes era un panelito angosto a la derecha del ícono; ahora toma TODO el viewport (fixed,
	 * inset:0) con el marino de marca de fondo y los links a tamaño grande. Se togglea con una
	 * clase (no el atributo `hidden`) porque `hidden` no puede transicionar — `visibility` +
	 * `opacity` sí, con el `transition-delay` en `visibility` para que el panel deje de capturar
	 * clicks/tab recién cuando la transición de salida terminó, no de golpe. */
	.hilo-ruta-menu {
		position: fixed;
		inset: 0;
		z-index: 70;
		display: flex;
		align-items: center;
		justify-content: flex-start;
		padding-left: calc(var(--ancho-hilo-ruta) + clamp(2rem, 8vw, 6rem));
		background: var(--color-marino);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition:
			opacity 320ms ease,
			visibility 0s linear 320ms;
	}

	.hilo-ruta-menu--abierta {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		transition: opacity 320ms ease;
	}

	.hilo-ruta-menu ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--espacio-md);
		width: min(90vw, 40rem);
	}

	/* Fila justificada: nombre a la izquierda, número al lado derecho — pedido de Ale 2026-08-28
	 * (antes el número iba primero, chico, a la izquierda). Línea de renglón MUY fina debajo de
	 * cada link, separada del texto por el padding. */
	.hilo-ruta-menu a {
		position: relative;
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--espacio-md);
		padding: var(--espacio-xs) 0 var(--espacio-sm);
		border-bottom: 1px solid color-mix(in srgb, var(--color-texto-sobre-foto) 22%, transparent);
		color: var(--color-texto-sobre-foto);
		text-decoration: none;
	}

	/* Texto real para lectores de pantalla — las letras/número sueltos de arriba son aria-hidden
	 * (puramente visuales, la animación letra por letra los separa en spans individuales, que un
	 * lector de pantalla leería mal). Oculto visualmente, no de la lectura. */
	.hilo-ruta-menu-solo-lectura {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	.hilo-ruta-menu-nombre {
		/* Space Grotesk 300 (Light) — pedido de Ale 2026-08-28: una grotesca FINA que complemente a
		 * Archivo (--fuente-display, el Hero) sin ser la misma familia. Reemplaza a Lora acá (Lora
		 * sigue siendo --fuente-titular para el resto del sitio, esto es un uso puntual). */
		font-family: var(--fuente-fina);
		font-weight: 300;
		font-size: clamp(1.75rem, 1.1rem + 3.2vw, 3.75rem);
		line-height: 1.15;
	}

	/* Cada letra es su propia caja (inline-block, hace falta para poder animarle transform) —
	 * generadas en build time en el frontmatter (el contenido es estático), cada una con su propio
	 * animation-delay ya calculado: línea N arranca con LINE_STAGGER_MS·N, y dentro de la línea,
	 * la letra J arranca LETTER_STAGGER_MS·J después — cascada arriba→abajo entre líneas,
	 * izquierda→derecha dentro de cada una. */
	.hilo-ruta-menu-letra {
		display: inline-block;
		opacity: 0;
		transform: translateY(-10px);
	}

	.hilo-ruta-menu-numero {
		font-family: var(--fuente-texto);
		font-weight: 600;
		/* Agrandado — pedido de Ale 2026-08-28 (antes var(--texto-base), quedaba chico al lado del
		 * nombre). Todavía notablemente menor que el nombre, para que siga leyéndose como índice. */
		font-size: clamp(1.5rem, 1rem + 2.5vw, 2.75rem);
		color: var(--color-celeste);
		flex-shrink: 0;
		opacity: 0;
		transform: translateY(-10px);
	}

	.hilo-ruta-menu a:hover .hilo-ruta-menu-nombre,
	.hilo-ruta-menu a:focus-visible .hilo-ruta-menu-nombre {
		color: var(--color-celeste);
	}

	.hilo-ruta-menu a:hover,
	.hilo-ruta-menu a:focus-visible {
		border-bottom-color: var(--color-celeste);
	}

	/* La animación se activa recién con la clase --abierta: si se declarara siempre, el navegador
	 * la reproduciría una sola vez al cargar la página (con el panel todavía cerrado) y no
	 * quedaría nada para reproducir cuando el menú realmente se abre. */
	.hilo-ruta-menu--abierta .hilo-ruta-menu-letra,
	.hilo-ruta-menu--abierta .hilo-ruta-menu-numero {
		animation: hilo-ruta-menu-entra var(--duracionLetra) cubic-bezier(0.16, 1, 0.3, 1) both;
	}

	/* Cierre — pedido de Ale 2026-08-28: al cerrar, las letras hacen la MISMA animación pero al
	 * revés (mismos delays — así la letra que entró primero también empieza a irse primero) y el
	 * fondo/box recién se cierra cuando termina esa secuencia. Esta clase la agrega el script
	 * ANTES de sacar --abierta (ver más abajo). El fondo (.hilo-ruta-menu--abierta, sin
	 * transition-delay propio) se mantiene opaco mientras tanto porque --abierta sigue puesta.
	 *
	 * OJO — un @keyframes PROPIO (`hilo-ruta-menu-sale`), NO `animation-direction: reverse` sobre
	 * el mismo `hilo-ruta-menu-entra`: se probó con `reverse` primero y no se veía nada al cerrar.
	 * La animación de entrada ya había TERMINADO (fill:both la deja en su estado final) — cuando
	 * solo cambia el sub-valor `animation-direction` de una animación que el navegador sigue
	 * considerando "la misma" (mismo animation-name), no hay garantía de que la reinicie desde el
	 * principio; en la práctica se quedaba en el estado final sin reproducir nada. Con un
	 * animation-name DISTINTO, el navegador sí reconoce una animación nueva y la reproduce desde
	 * cero — se llega exactamente al mismo lugar (los keyframes son el espejo de los de entrada). */
	.hilo-ruta-menu--cerrando .hilo-ruta-menu-letra,
	.hilo-ruta-menu--cerrando .hilo-ruta-menu-numero {
		animation: hilo-ruta-menu-sale var(--duracionLetra) cubic-bezier(0.16, 1, 0.3, 1) both;
	}

	/* "Efecto smooth" (pedido de Ale) — el blur se suma a opacity+translateY, como un enfoque
	 * suave entrando (o desenfocándose al salir). */
	@keyframes hilo-ruta-menu-entra {
		from {
			opacity: 0;
			transform: translateY(-10px);
			filter: blur(6px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
			filter: blur(0);
		}
	}

	@keyframes hilo-ruta-menu-sale {
		from {
			opacity: 1;
			transform: translateY(0);
			filter: blur(0);
		}
		to {
			opacity: 0;
			transform: translateY(-10px);
			filter: blur(6px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hilo-ruta-menu,
		.hilo-ruta-menu-linea {
			transition: none !important;
		}

		.hilo-ruta-menu-letra,
		.hilo-ruta-menu-numero {
			animation: none !important;
			opacity: 1;
			transform: none;
		}
	}
</style>

{/* Keyframes del pintado — generados (piecewise) en el frontmatter: un stop por parada, con su %
   = `llegada` (cuándo su pantalla se centra) y el dashoffset = `1 - distancia/100`. Va global +
   set:html porque un <style> normal de Astro no se templatea; el nombre es único, no colisiona. */}
<style is:global set:html={paintKeyframes}></style>

<script>
	// Redondez real de los nodos: el <svg> usa preserveAspectRatio="none" a propósito (necesita
	// estirar ANCHO y ALTO por separado — ver comentario del frontmatter), pero eso significa que
	// 1 unidad de viewBox no mide lo mismo en X que en Y salvo que el viewBox tenga EXACTAMENTE la
	// proporción del contenedor real. La referencia fija (900 de alto) casi nunca coincide con el
	// alto real del viewport → los <circle> (que sí son geometría "redonda" en unidades locales,
	// donde X e Y valen lo mismo) salen ovalados. Se corrige midiendo el alto real ya renderizado y
	// regenerando el viewBox + la curva (misma fórmula, alto real) para que 1 unidad = 1px en las
	// dos direcciones — recién ahí un <circle r="7"> es un círculo de verdad.
	function generarCurva(alto: number): string {
		const BASE = 32;
		const AMP = 16;
		const seg = alto / 4;
		const o1 = seg / 3;
		const o2 = (2 * seg) / 3;
		const y1 = seg;
		const y2 = seg * 2;
		const y3 = seg * 3;
		const y4 = seg * 4;
		return (
			`M${BASE},0 ` +
			`C${BASE - AMP},${o1.toFixed(2)} ${BASE - AMP},${o2.toFixed(2)} ${BASE},${y1.toFixed(2)} ` +
			`S${BASE + AMP},${(y1 + o2).toFixed(2)} ${BASE},${y2.toFixed(2)} ` +
			`S${BASE - AMP},${(y2 + o2).toFixed(2)} ${BASE},${y3.toFixed(2)} ` +
			`S${BASE + AMP},${(y3 + o2).toFixed(2)} ${BASE},${y4.toFixed(2)}`
		);
	}

	function ajustarCurva() {
		const wrapper = document.querySelector<HTMLElement>('.hilo-ruta');
		const svg = document.querySelector<SVGSVGElement>('.hilo-ruta-svg');
		const pathEl = document.querySelector<SVGPathElement>('#hilo-ruta-curva');
		const mascara = document.querySelector<SVGMaskElement>('#hilo-ruta-mascara');
		if (!wrapper || !svg || !pathEl || !mascara) return;

		const alto = Math.round(svg.getBoundingClientRect().height);
		if (alto <= 0) return;

		svg.setAttribute('viewBox', `0 0 64 ${alto}`);
		mascara.setAttribute('height', String(alto));
		const d = generarCurva(alto);
		pathEl.setAttribute('d', d);
		// offset-path de nodos/links lee este custom property (heredado, ver <style> de arriba) —
		// hay que actualizarlo junto con el 'd' de arriba para que sigan glueados a la curva real,
		// no a la de referencia (900). Una sola declaración en el wrapper, no una copia por nodo.
		wrapper.style.setProperty('--curva-offset-path', `"${d}"`);
	}

	ajustarCurva();

	let temporizadorResize: ReturnType<typeof setTimeout> | undefined;
	window.addEventListener('resize', () => {
		clearTimeout(temporizadorResize);
		temporizadorResize = setTimeout(ajustarCurva, 150);
	});

	// Navegación real (click, no solo indicador de progreso) — mismo motivo que la versión
	// anterior: el destino vive dentro de .hz-track, rotado -90° por el truco de slide horizontal
	// (ver base.css), así que el scroll-hasta-el-ancla nativo del navegador no calcula bien el
	// scroll necesario. Se resuelve leyendo `offsetTop` del slide destino DENTRO de .hz-track (esa
	// posición SÍ es correcta, es el espacio local sin rotar) y llevando el scroll ahí a mano.
	// `behavior:'instant'` a propósito — 'smooth' se queda clavado en 0 sobre este elemento
	// transformado (gotcha ya documentado, ver memoria del proyecto).
	const track = document.querySelector<HTMLElement>('.hz-track');
	const boton = document.querySelector<HTMLButtonElement>('.hilo-ruta-menu-boton');
	const menu = document.querySelector<HTMLElement>('#hilo-ruta-menu');

	// El panel ahora es pantalla completa (ver <style>): se togglea con clases, no con el atributo
	// `hidden` — `hidden` fuerza display:none de golpe, sin dejar animar la transición de
	// opacity/transform. `aria-hidden` refleja el estado para lectores de pantalla.
	const CLASE_ABIERTA = 'hilo-ruta-menu--abierta';
	// Cierre en dos tiempos (pedido de Ale 2026-08-28): al cerrar, las letras hacen la MISMA
	// animación de entrada pero al revés (ver CSS, .hilo-ruta-menu--cerrando) y el fondo recién se
	// apaga cuando esa secuencia termina — no de un fade abrupto. Esta clase se agrega ANTES de
	// sacar --abierta; --abierta se saca recién al final del timeout de abajo.
	const CLASE_CERRANDO = 'hilo-ruta-menu--cerrando';
	// Debe coincidir con --duracionLetra (ver define:vars arriba) — un <script> de Astro no tiene
	// acceso directo al frontmatter, así que se repite el valor a mano acá.
	const DURACION_LETRA_MS = 520;

	const estaAbierto = () => menu?.classList.contains(CLASE_ABIERTA) ?? false;

	// Cuánto esperar antes de cerrar el fondo del todo: el delay más largo entre todas las
	// letras/números (el último en aparecer, que en el cierre es también el último en
	// desaparecer, ya que --cerrando solo invierte la animación, no el orden de los delays) más
	// la duración de su propia animación.
	function calcularEsperaCierre(): number {
		// Con reduced-motion la animación letra por letra está apagada del todo (ver <style>,
		// bloque @media) — esperar igual sería un cierre artificialmente lento sin nada que
		// justifique la espera.
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return 0;

		let maxDelayMs = 0;
		document
			.querySelectorAll<HTMLElement>('.hilo-ruta-menu-letra, .hilo-ruta-menu-numero')
			.forEach((elemento) => {
				const valor = getComputedStyle(elemento).animationDelay;
				const numero = parseFloat(valor) || 0;
				const ms = valor.trim().endsWith('ms') ? numero : numero * 1000;
				if (ms > maxDelayMs) maxDelayMs = ms;
			});
		return maxDelayMs + DURACION_LETRA_MS;
	}

	let temporizadorCierre: ReturnType<typeof setTimeout> | undefined;

	const cerrarMenu = () => {
		if (!menu || !boton || !estaAbierto()) return;
		clearTimeout(temporizadorCierre);
		menu.classList.add(CLASE_CERRANDO);
		menu.setAttribute('aria-hidden', 'true');
		boton.setAttribute('aria-expanded', 'false');

		temporizadorCierre = setTimeout(() => {
			menu.classList.remove(CLASE_ABIERTA, CLASE_CERRANDO);
		}, calcularEsperaCierre());
	};

	boton?.addEventListener('click', () => {
		if (!menu || !boton) return;

		if (estaAbierto()) {
			cerrarMenu();
			return;
		}

		// Reabrir a mitad de un cierre en curso: cancelar el timeout pendiente y arrancar limpio.
		clearTimeout(temporizadorCierre);
		menu.classList.remove(CLASE_CERRANDO);
		menu.classList.add(CLASE_ABIERTA);
		menu.setAttribute('aria-hidden', 'false');
		boton.setAttribute('aria-expanded', 'true');
	});

	document.addEventListener('keydown', (evento) => {
		if (evento.key === 'Escape') cerrarMenu();
	});

	document
		.querySelectorAll<HTMLAnchorElement>('.hilo-ruta-parada-link, .hilo-ruta-menu a')
		.forEach((enlace) => {
			enlace.addEventListener('click', (evento) => {
				const id = enlace.getAttribute('href')?.slice(1);
				const destino = id && document.getElementById(id);
				if (!track || !destino) return;

				evento.preventDefault();
				track.scrollTo({ top: destino.offsetTop, behavior: 'instant' });
				cerrarMenu();
			});
		});
</script>
