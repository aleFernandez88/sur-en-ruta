---
/**
 * Telefono.astro — el celular con la app adentro. Componente clave del fallback de la Opción 3
 * "Demo viva" (docs/planes/2026-09-22-recomposicion-ui-vertical.md §14.7 paso 9 — Paso 1.3 parcial
 * de §5): nada más del sitio sabe si adentro hay un `<iframe>` vivo o una `<img>` estática — esa
 * indirección es lo que vuelve el fallback N3 (§14.1, si el iframe falla del todo en iOS) un
 * cambio de prop, no un rediseño.
 *
 * Visual (marco + glow + piso) portado literal de `public/app-demo/showcase.html:93-131` — los
 * mismos valores ya probados en el render y en la prueba T1-T6 de `prototipos/pruebas/iframe-3d/`
 * (paso 2 del plan).
 *
 * === Quién anima qué (división de responsabilidades con Escenario.astro) ===
 * Este componente es DELIBERADAMENTE mudo respecto del scroll: no tiene ningún
 * `animation-timeline` propio. `Escenario.astro` (paso 10) es quien mueve el celular por la
 * página — envuelve la salida de este componente en `.escenario__telefono` (translate+scale,
 * atado a `scroll(root)`, una sola animación continua para las 5 secciones, §3.2 opción C) y
 * aplica la rotación 3D de P1 con un selector aparte hacia `.telefono__marco` (acá abajo) — NUNCA
 * comparten la misma propiedad `transform` en el mismo elemento (dos timelines escribiendo
 * `transform` en el mismo nodo con `fill:both` es la trampa documentada en §3.2 opción B: la
 * última de la lista gana también fuera de su rango).
 *
 * === Accesibilidad (§14.3) ===
 * El celular es decorativo — todo el contenido informativo vive FUERA del iframe, en el copy de
 * las secciones. El wrapper (`Escenario.astro`) lleva `aria-hidden="true"` + `pointer-events:none`
 * sobre TODA la capa; acá, el propio `<iframe>` además lleva `tabindex="-1"` (`aria-hidden` NO
 * saca del orden de tabulación por sí solo — es el error clásico), `scrolling="no"` y
 * `loading="eager"` (está visible desde el primer frame, nunca hace falta lazy-load).
 *
 * `?embed=1`: activa el modo embebido del lado de `public/app-demo/index.html` (sin preloader
 * propio, `inert`, aviso de `listo` al padre) — ESE MODO TODAVÍA NO EXISTE, es el paso 13 (Bloque
 * D). Hoy el parámetro no hace nada del lado del demo (query string ignorada) — se deja puesto
 * para no tener que volver a tocar este componente cuando exista.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	modo?: 'vivo' | 'imagen';
	/** Requerida en modo 'imagen' (astro:assets) — no aplica en modo 'vivo'. */
	src?: ImageMetadata;
}

const { modo = 'vivo', src } = Astro.props;

if (modo === 'imagen' && !src) {
	throw new Error('Telefono.astro: el modo "imagen" necesita la prop `src`.');
}

const base = import.meta.env.BASE_URL;
const srcVivo = `${base}app-demo/index.html?embed=1`;
---

<div class="telefono">
	<div class="telefono__glow"></div>
	<div class="telefono__glow telefono__glow--b"></div>
	<div class="telefono__piso"></div>
	<div class="telefono__marco">
		<div class="telefono__cuerpo">
			<div class="telefono__pantalla">
				{
					modo === 'vivo' ? (
						<iframe
							class="telefono__iframe"
							src={srcVivo}
							title="Vista conceptual de la app Sur en Ruta"
							tabindex="-1"
							scrolling="no"
							loading="eager"
						/>
					) : (
						src && <Image class="telefono__imagen" src={src} alt="" width={390} height={844} />
					)
				}
			</div>
		</div>
	</div>
</div>

<style>
	/* Portado literal de public/app-demo/showcase.html:45-140 (mismos valores, ver comentario del
	 * frontmatter) — sin el `#vignette` ni el `#glare` de la escena de filmación, que no aplican
	 * acá (esos viven en el fondo de cada sección, no en el celular). */
	.telefono {
		position: relative;
		width: 100%;
		height: 100%;
		display: grid;
		place-items: center;
	}

	.telefono__glow {
		position: absolute;
		width: 82%;
		aspect-ratio: 1;
		left: 50%;
		top: 40%;
		transform: translate(-50%, -50%);
		background: radial-gradient(
			circle,
			rgba(108, 172, 228, 0.32) 0%,
			rgba(108, 172, 228, 0.12) 33%,
			transparent 66%
		);
		filter: blur(26px);
	}

	.telefono__glow--b {
		background: radial-gradient(circle, rgba(90, 107, 46, 0.2) 0%, transparent 60%);
		width: 60%;
		top: 58%;
	}

	.telefono__piso {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 46%;
		height: 9%;
		background: radial-gradient(ellipse, rgba(0, 0, 0, 0.55) 0%, transparent 70%);
		filter: blur(14px);
		transform: translate(-50%, 620%);
	}

	/* .telefono__marco es el único elemento al que Escenario.astro le aplica la rotación 3D de P1
	 * (selector desde afuera, ver el comentario grande del frontmatter) — por eso necesita
	 * `transform-style: preserve-3d` acá, no en .telefono. */
	.telefono__marco {
		position: relative;
		/* 56% del alto del escenario, con tope (`--telefono-alto-max`, tokens.css): en un monitor de
		 * 1440px de alto el celular crecía a 806px y perdía proporción con el texto. */
		height: min(56%, var(--telefono-alto-max));
		aspect-ratio: 9 / 17;
		transform-style: preserve-3d;
		will-change: transform;
	}

	.telefono__cuerpo {
		position: absolute;
		inset: 0;
		border-radius: 13.5% / 6.2%;
		background: linear-gradient(135deg, #3a4048 0%, #10131a 38%, #2c313a 62%, #0c0f15 100%);
		padding: 1.7%;
		box-shadow:
			inset 0 0 0 1.5px rgba(255, 255, 255, 0.1),
			inset 0 2px 6px rgba(255, 255, 255, 0.16),
			inset 0 -3px 8px rgba(0, 0, 0, 0.5);
	}

	.telefono__pantalla {
		position: absolute;
		inset: 1.7%;
		border-radius: 11.5% / 5.4%;
		overflow: hidden;
		background: #f1f0ee;
		box-shadow: inset 0 0 0 2px #05080d;
	}

	/* El iframe/imagen se renderiza SIEMPRE a 390px de ancho lógico (el ancho para el que está
	 * diseñado el mockup, ver showcase.html) y se escala para calzar — así el layout no depende
	 * del tamaño del celular en el escenario. `--fit` lo setea el ResizeObserver de Escenario.astro. */
	.telefono__iframe,
	.telefono__imagen {
		width: 390px;
		height: 844px;
		border: 0;
		display: block;
		object-fit: cover;
		transform-origin: top left;
		transform: scale(var(--fit, 1));
	}
</style>
