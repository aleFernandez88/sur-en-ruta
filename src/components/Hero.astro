---
/**
 * Hero.astro — Sección 0 · Portada. Introducción sin datos.
 *
 * Rol tras la renumeración del 2026-08-27 (ver docs/landing-contenido.md): es la portada del
 * recorrido, cero información (esa arranca en la Sección 1). `<Pantalla completa>` en index.astro.
 *
 * 2026-08-27 (tarde): Ale la dejó al mínimo — se sacaron el eyebrow "RENAMU · Sur en Ruta" y el
 * titular grande en Lora. Queda SOLO la frase de encuadre, con el texto "El país entero, / en una
 * sola red" (que antes era el titular), en 2 líneas a tamaño display (Archivo 400, ~5rem),
 * con entrada escalonada fade-up. La señal de "seguí" pasó a ser una flecha grande dentro de un
 * círculo, a media altura sobre el borde derecho, sin texto (la "cinta" avanza en horizontal).
 *
 * Visual: foto de fondo a pantalla completa (`astro:assets` → AVIF/WebP + srcset) con Ken Burns.
 *
 * OJO — `src/assets/hero/ruta-placeholder.jpg` es una MUESTRA PROVISORIA, no la foto final
 * (licencia sin verificar, el relieve del fondo no es de Uruguay, sin camper en cuadro). Ver
 * `src/assets/hero/FUENTE.md`. No deployar así.
 *
 * Identidad de color/tipografía: 2026-08-27, ver docs/decisiones/identidad-visual.md.
 */
import { Image } from 'astro:assets';
import heroFoto from '../assets/hero/ruta-placeholder.jpg';
---

<section class="hero" aria-labelledby="hero-titulo">
	<Image
		src={heroFoto}
		alt=""
		class="hero-foto"
		widths={[640, 1024, 1600, 1920]}
		sizes="100vw"
		loading="eager"
		fetchpriority="high"
	/>
	<div class="hero-overlay" aria-hidden="true"></div>

	<div class="hero-contenido">
		<h1 id="hero-titulo" class="hero-frase">
			<span class="hero-linea hero-entra">El país entero,</span>
			<span class="hero-linea hero-entra">en una sola red</span>
		</h1>
	</div>

	<div class="hero-sena" aria-hidden="true">
		<svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor"
			stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
			<path d="M5 12h14M13 6l6 6-6 6" />
		</svg>
	</div>
</section>

<style>
	.hero {
		position: relative;
		height: 100%;
		display: grid;
		align-content: end;
		overflow: hidden;
	}

	.hero-foto {
		position: absolute;
		inset: 0;
		z-index: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 72%;
		/* Ken Burns: zoom continuo. prefers-reduced-motion lo apaga a nivel global (base.css).
		 * 15s / escala 1.08 — 2026-08-27, Ale bajó el tiempo de 28s a 15s para probar más ritmo. */
		animation: hero-zoom 15s ease-in-out infinite alternate;
	}

	@keyframes hero-zoom {
		from {
			transform: scale(1);
		}
		to {
			transform: scale(1.08);
		}
	}

	/* Velo de contraste: más cargado abajo-izquierda (donde cae el texto), casi limpio arriba-
	 * derecha (deja respirar la foto). color-mix sobre los tokens de marca, no rgba suelto. */
	.hero-overlay {
		position: absolute;
		inset: 0;
		z-index: 1;
		background:
			linear-gradient(
				72deg,
				color-mix(in srgb, var(--color-marino-profundo) 82%, transparent) 0%,
				color-mix(in srgb, var(--color-marino-profundo) 38%, transparent) 40%,
				transparent 68%
			),
			linear-gradient(
				0deg,
				color-mix(in srgb, var(--color-velo-foto) 42%, transparent) 0%,
				transparent 50%
			);
	}

	.hero-contenido {
		position: relative;
		z-index: 2;
		align-self: end;
		/* Ancho generoso para que la frase entre en exactamente 2 líneas al tamaño display. */
		max-width: min(94vw, 62rem);
		/* padding-left incluye --ancho-hilo-ruta: HiloRuta (barra lateral fija, ver
		 * src/components/HiloRuta.astro) se superpone al borde izquierdo de toda pantalla
		 * `completa` — sin este margen extra, en viewports angostos (6vw < ancho de la barra) el
		 * texto queda parcialmente tapado. */
		padding: 0 clamp(1.5rem, 6vw, 5rem) clamp(3.5rem, 12vh, 7rem)
			calc(var(--ancho-hilo-ruta) + clamp(1.5rem, 6vw, 5rem));
		color: var(--color-texto-sobre-foto);
	}

	.hero-frase {
		margin: 0;
		font-weight: 400;
	}

	/* La frase de encuadre — única pieza de texto de la Portada, a tamaño display. En 2 líneas
	 * fijas (cada <span> es una), cada una anima por separado. */
	.hero-linea {
		display: block;
		font-family: var(--fuente-display);
		font-weight: 500;
		font-size: clamp(2.5rem, 1.2rem + 4.5vw, 5rem);
		line-height: 1.04;
		letter-spacing: -0.02em;
		/* Cada <span> es una línea fija: no debe wrappear. */
		white-space: nowrap;
	}

	/* === Entrada escalonada ===
	 * fade-up por línea, disparado cuando se abre la cortina del preloader (:root.entrada, lo
	 * pone Preloader.astro). Mientras tanto queda "pausada" mostrando el estado inicial. Sin JS
	 * (:root sin .js) no hay animación: todo visible. prefers-reduced-motion: idem. */
	@keyframes hero-entra {
		from {
			opacity: 0;
			transform: translateY(1.4rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	:global(:root.js) .hero-entra {
		animation: hero-entra 0.72s cubic-bezier(0.2, 0.7, 0.2, 1) both paused;
	}

	:global(:root.entrada) .hero-entra {
		animation-play-state: running;
	}

	:global(:root.js) .hero-linea:nth-child(1).hero-entra {
		animation-delay: 0ms;
	}
	:global(:root.js) .hero-linea:nth-child(2).hero-entra {
		animation-delay: 150ms;
	}

	@media (prefers-reduced-motion: reduce) {
		:global(:root.js) .hero-entra {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}

	/* Señal de "seguí": flecha grande dentro de un círculo, a media altura sobre el borde
	 * derecho. Apunta a la derecha porque la "cinta" avanza en horizontal. Sin texto. */
	.hero-sena {
		position: absolute;
		z-index: 2;
		right: clamp(1.25rem, 4vw, 3rem);
		top: 50%;
		transform: translateY(-50%);
		display: grid;
		place-items: center;
		width: clamp(4.25rem, 6.5vw, 5.5rem);
		aspect-ratio: 1;
		border-radius: 50%;
		border: 1.5px solid color-mix(in srgb, var(--color-texto-sobre-foto) 60%, transparent);
		background: color-mix(in srgb, var(--color-marino-profundo) 22%, transparent);
		backdrop-filter: blur(3px);
		color: var(--color-texto-sobre-foto);
	}

	.hero-sena svg {
		width: 45%;
		height: 45%;
		animation: hero-sena-nudge 2.4s ease-in-out infinite;
	}

	@keyframes hero-sena-nudge {
		0%,
		100% {
			transform: translateX(0);
		}
		50% {
			transform: translateX(3px);
		}
	}
</style>
