---
/**
 * Hero.astro — Sección 1. Hook.
 *
 * Copy real cargado el 2026-08-24 desde docs/landing-inversores-contenido.md, verificado a su vez
 * contra el documento de propuesta original (secc. 1 y 9). El titular y la bajada vienen de la
 * exploración visual del 13/08 (ver docs/fuentes/README.md), que el plan pide reutilizar tal cual.
 *
 * Pendiente, fuera de este paso: el SVG real del mapa (paso 9 del plan) reemplaza a
 * MapaPlaceholder cuando exista (ver src/assets/mapa/FUENTE.md).
 *
 * OJO — no confundir con HiloRuta: esa es la barra de progreso fija arriba de toda la pantalla
 * (vive en Base.astro, persiste en las 5 secciones, ligada al scroll de toda la página). El
 * MapaPlaceholder de acá abajo es la ilustración grande y propia del Hero, sección 1 nomás.
 */
import MapaPlaceholder from './MapaPlaceholder.astro';

const datosAncla = [
	'Piloto: Maldonado · 90 días',
	'Un punto de servicio cada 90 km',
	'6 componentes de sistema',
];
---

<section id="hero" class="hero" aria-labelledby="hero-titulo">
	<div class="hero-visual">
		<!-- TODO: silueta de Uruguay animada con stroke-dashoffset (ver src/assets/mapa/FUENTE.md) -->
		<MapaPlaceholder etiqueta="silueta de Uruguay animada" />
	</div>

	<div class="hero-contenido">
		<p class="hero-eyebrow">Proyecto RENAMU</p>
		<h1 id="hero-titulo">El país entero, en una sola red.</h1>
		<p class="hero-bajada">
			Paradas habilitadas, comercios adheridos y rutas temáticas para el turismo itinerante
			uruguayo.
		</p>

		<ul class="hero-datos-ancla">
			{datosAncla.map((dato) => <li>{dato}</li>)}
		</ul>

		<div class="hero-ctas">
			<a href="#inversion" class="cta cta-primario">Ver el plan de inversión</a>
			<a href="mailto:" class="cta cta-secundario">Solicitar el dossier</a>
		</div>
	</div>
</section>

<style>
	.hero {
		min-height: 100vh;
		display: grid;
		align-content: center;
		gap: var(--espacio-xl);
		padding: var(--espacio-xl) var(--espacio-md);
	}

	.hero-eyebrow {
		margin: 0 0 var(--espacio-xs);
		font-size: var(--texto-sm);
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-acento);
	}

	h1 {
		font-size: var(--texto-3xl);
	}

	.hero-bajada {
		font-size: var(--texto-lg);
		max-width: 40ch;
	}

	.hero-datos-ancla {
		display: flex;
		flex-wrap: wrap;
		gap: var(--espacio-md);
		list-style: none;
		padding: 0;
		margin: var(--espacio-md) 0;
	}

	.hero-datos-ancla li {
		padding: var(--espacio-xs) var(--espacio-sm);
		background-color: var(--color-superficie);
		border-radius: var(--radio-full);
		font-size: var(--texto-sm);
		font-weight: 600;
	}

	.hero-ctas {
		display: flex;
		flex-wrap: wrap;
		gap: var(--espacio-sm);
	}

	.cta {
		display: inline-block;
		padding: var(--espacio-xs) var(--espacio-md);
		border-radius: var(--radio-md);
		text-decoration: none;
		font-weight: 700;
	}

	.cta-primario {
		background-color: var(--color-acento);
		color: var(--color-fondo);
	}

	.cta-secundario {
		border: 2px solid var(--color-tinta);
		color: var(--color-tinta);
	}
</style>
