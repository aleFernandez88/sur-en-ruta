---
/**
 * P2QueHace.astro — P2 · ¿Qué hace? (`que-hace`), 2ª de las 5 secciones del escenario vertical.
 * Datos en `src/data/beneficios.ts` (copy literal del mazo).
 *
 * === Gesto propio: «Órbita, el valor da la vuelta» ===
 * Un anillo con tres medallones (viajero → comercios → territorios) y una estela amarilla que gira
 * en sentido horario: el valor del paso del viajero vuelve a todos. Sin tarjetas rectangulares.
 * Entrada atada al scroll (timeline `--que-hace`, igual que el resto de las secciones): el anillo
 * llega girando, cada medallón recorre la órbita hasta su lugar y los textos suben. La estela
 * entra con fade y después gira por tiempo (único loop de la pantalla).
 *
 * === Geometría ===
 * Todo se deriva de tres variables en `.p2-contenido`: `--r` (diámetro del anillo, limitado por
 * ancho y por ALTO de ventana), `--rx` y `--ry` (esquina del anillo). Los medallones se ubican en
 * % del anillo y los bloques de texto en múltiplos de `--r`, así que toda la composición escala
 * junta y no hay `top` fijos que choquen con el titular en pantallas bajas. El celular queda
 * de fondo (chrome fijo): la composición no le reserva lugar.
 *
 * Restricciones de escenario.ts: nada de `calc()`+`var()` dentro de `@keyframes` (los de acá son
 * literales) y `animation-range` nunca con `var()`.
 */
import Seccion from '../Seccion.astro';
import Icono from '../Icono.astro';
import { beneficios } from '../../data/beneficios.ts';

// Íconos propios (Icono.astro), uno por beneficiario: viajeros / economía local / base conectada.
const ICON = ['viajeros', 'economia-local', 'base-conectada'] as const;

// Posición de cada medallón sobre el anillo (centro, en % del anillo): −90°, 30° y 150°, sentido horario.
const POSICION = [
	{ x: 50, y: 0 },
	{ x: 93.3, y: 75 },
	{ x: 6.7, y: 75 },
];
---

<Seccion id="que-hace">
	<div class="p2 seccion__caja">
		<div class="p2-contenido">
			<h2 class="p2-titular">
				<span class="p2-t1">Una <span class="realce p2-realce">red</span> que</span>
				<span class="p2-t2">Beneficia a todos</span>
			</h2>

			<div class="p2-orbita">
				<div class="p2-anillo" aria-hidden="true"></div>
				<div class="p2-estela" aria-hidden="true"></div>
				{
					POSICION.map((p, i) => (
						<div class={`p2-orb p2-orb--${i}`} aria-hidden="true">
							<span class="p2-medallon" style={`left: ${p.x}%; top: ${p.y}%`}>
								<Icono nombre={ICON[i]} tamano={32} acento="var(--color-celeste)" />
							</span>
						</div>
					))
				}
				<div class="p2-cierre-caja">
				<p class="p2-cierre">
					La red transforma el paso del viajero en
					<span class="realce p2-realce">valor</span>
					para todos
				</p>
				</div>
			</div>

			<ul class="p2-bloques">
				{
					beneficios.map((bloque, i) => (
						<li class={`p2-bloque p2-bloque--${i}`}>
							<span class="p2-mini" aria-hidden="true">
								<Icono nombre={ICON[i]} tamano={32} acento="var(--color-celeste)" />
							</span>
							<h3 class="p2-bloque-titulo">{bloque.titulo}</h3>
							<ul class="p2-chips">
								{bloque.items.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</Seccion>

<style>
	/* === Base (mobile, flujo normal) === */
	/* Fondo: solo un halo translúcido detrás del anillo, sobre el azul sólido del escenario. Nunca un fondo
	 * opaco a pantalla completa: taparía el celular, que es el chrome fijo y debe verse siempre. */
	.p2::before {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: radial-gradient(circle at 50% 36%, color-mix(in srgb, var(--color-celeste) 38%, transparent) 0%, transparent 52%);
	}

	.p2-contenido {
		position: relative;
		--r: min(240px, 62vw);
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 0;
		padding-top: 1.25rem;
	}

	.p2-titular {
		margin: 0;
		display: flex;
		flex-direction: column;
		font-family: var(--fuente-display);
		color: var(--color-texto-sobre-foto);
		text-transform: uppercase;
	}

	.p2-t1 {
		font-size: 24px;
		font-weight: 200;
		line-height: 1.2;
		text-transform: none;
	}

	.p2-t2 {
		font-size: 29px;
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}

	/* «red» y «valor»: palabra clave de P1 (global .realce); acá un poco más grande que el texto fino. */
	.p2-realce {
		font-size: 1.14em;
	}

	.p2-orbita {
		position: relative;
		width: var(--r);
		height: var(--r);
		margin: 2.4rem auto 2rem;
	}

	.p2-anillo {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		border: 2px solid rgba(255, 255, 255, 0.3);
	}

	/* Estela: aro fino con cola amarilla que gira en sentido horario. */
	.p2-estela {
		position: absolute;
		inset: -3px;
		border-radius: 50%;
		background: conic-gradient(from 0deg, transparent 0 62%, var(--color-verde-primavera) 100%);
		-webkit-mask: radial-gradient(closest-side, transparent 96.5%, #000 97.5% 100%, transparent 100%);
		mask: radial-gradient(closest-side, transparent 96.5%, #000 97.5% 100%, transparent 100%);
		animation: p2-gira 6s linear infinite;
		pointer-events: none;
	}

	.p2-orb {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.p2-medallon {
		position: absolute;
		width: 25%;
		aspect-ratio: 1;
		transform: translate(-50%, -50%);
		display: grid;
		place-items: center;
		border-radius: 50%;
		background: color-mix(in srgb, var(--color-marino-noche) 60%, transparent);
		border: 2px solid #fff;
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
		color: #fff;
	}

	.p2-medallon :global(svg) {
		width: 56%;
		height: 56%;
	}

	.p2-cierre-caja {
		position: absolute;
		inset: 0;
		display: grid;
		place-content: center;
		padding: 0 19%;
		pointer-events: none;
	}

	.p2-cierre {
		margin: 0;
		text-align: center;
		text-wrap: balance;
		font-family: var(--fuente-texto);
		font-size: 15px;
		font-weight: 200;
		line-height: 1.25;
		color: var(--color-texto-sobre-foto);
	}

	/* Leyenda (mobile): una fila por beneficiario, ítems en una sola línea separados por « · ». */
	.p2-bloques {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.p2-bloque {
		display: grid;
		grid-template-columns: 32px minmax(0, 1fr);
		column-gap: 12px;
		align-items: center;
		color: var(--color-texto-sobre-foto);
	}

	.p2-mini {
		grid-row: 1 / span 2;
		align-self: start;
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: color-mix(in srgb, var(--color-marino-noche) 60%, transparent);
		border: 2px solid #fff;
		color: #fff;
	}

	.p2-mini :global(svg) {
		width: 18px;
		height: 18px;
	}

	.p2-bloque-titulo {
		margin: 0;
		font-family: var(--fuente-display);
		font-size: 16px;
		font-weight: 800;
		line-height: 1.2;
	}

	.p2-chips {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		font-family: var(--fuente-texto);
		font-size: 14px;
		line-height: 1.35;
		color: rgba(255, 255, 255, 0.85);
	}

	.p2-chips li:not(:last-child)::after {
		content: '·';
		margin-inline: 0.4em;
	}

	/* === Escritorio: composición absoluta (referencia 1536×695) === */
	@media (width >= 900px) {
		.p2-contenido {
			--r: min(50svh, 400px, 25vw);
			--ts: min(280px, 17vw);
			--rx: calc(2.6vw + var(--ts) + var(--r) * 0.1 + 8px);
			--ry: 32svh;
			position: absolute;
			inset: 0;
			display: block;
			padding: 0;
		}

		.p2::before {
			background: radial-gradient(circle at 36% 62%, color-mix(in srgb, var(--color-celeste) 38%, transparent) 0%, transparent 52%);
		}

		.p2-titular {
			position: absolute;
			left: 6.25vw;
			top: clamp(24px, 7.5svh, 52px);
		}

		.p2-t1 {
			font-size: clamp(20px, 5.4svh, 38px);
		}

		.p2-t2 {
			font-size: clamp(36px, min(10.5svh, 4.6vw), 72px);
		}

		.p2-orbita {
			position: absolute;
			left: var(--rx);
			top: var(--ry);
			margin: 0;
		}

		.p2-medallon {
			width: 24%;
		}

		.p2-cierre-caja {
			padding: 0 17.5%;
		}

		.p2-cierre {
			font-size: clamp(14px, calc(var(--r) * 0.0575), 23px);
		}

		.p2-bloques {
			display: block;
		}

		.p2-bloque {
			position: absolute;
			display: block;
		}

		.p2-mini {
			display: none;
		}

		.p2-bloque-titulo {
			font-size: clamp(16px, 1.45vw, 22px);
			margin-bottom: 0.55rem;
		}

		.p2-chips {
			gap: 8px;
			font-size: clamp(12px, 1vw, 15px);
			font-weight: 500;
			line-height: 1.25;
			color: #fff;
		}

		.p2-chips li {
			padding: 0.45em 0.9em;
			border-radius: 999px;
			background: rgba(255, 255, 255, 0.12);
			border: 1.5px solid rgba(255, 255, 255, 0.55);
		}

		.p2-chips li:not(:last-child)::after {
			content: none;
		}

		/* Viajero: a la derecha de su medallón (arriba). */
		.p2-bloque--0 {
			left: calc(var(--rx) + var(--r) * 0.67);
			top: calc(var(--ry) - var(--r) * 0.085);
			width: 420px;
		}

		/* Comercios: a la derecha de su medallón (abajo a la derecha). */
		.p2-bloque--1 {
			left: calc(var(--rx) + var(--r) * 1.1);
			top: calc(var(--ry) + var(--r) * 0.62);
			width: 290px;
		}

		/* Territorios: a la izquierda de su medallón, alineado a la derecha. */
		.p2-bloque--2 {
			left: 2.6vw;
			top: calc(var(--ry) + var(--r) * 0.62);
			width: var(--ts);
			text-align: right;
		}

		.p2-bloque--2 .p2-chips {
			justify-content: flex-end;
		}
	}

	/* Alto bajo: comercios y territorios quedan solo con su título; el viajero conserva los chips. */
	@media (width >= 900px) and (height < 560px) {
		.p2-bloque--1 .p2-chips,
		.p2-bloque--2 .p2-chips {
			display: none;
		}
	}

	/* === Animación de entrada (atada al scroll de la sección) === */
	@keyframes p2-sube {
		from {
			opacity: 0;
			transform: translateY(18px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@keyframes p2-anillo-entra {
		from {
			opacity: 0;
			transform: scale(0.55) rotate(-90deg);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@keyframes p2-orbita-entra {
		from {
			opacity: 0;
			transform: rotate(-150deg);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@keyframes p2-fade {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@keyframes p2-gira {
		to {
			transform: rotate(360deg);
		}
	}

	@supports (animation-timeline: scroll(root)) {
		.p2::before {
			animation: p2-fade linear both;
			animation-timeline: --que-hace;
			animation-range: contain 0% contain 6%;
		}

		.p2-titular,
		.p2-cierre,
		.p2-bloque {
			animation: p2-sube cubic-bezier(0.2, 0.8, 0.2, 1) both;
			animation-timeline: --que-hace;
		}
		.p2-titular {
			animation-range: contain 0% contain 6%;
		}
		.p2-cierre {
			animation-range: contain 24% contain 34%;
		}
		.p2-bloque--0 {
			animation-range: contain 28% contain 38%;
		}
		.p2-bloque--1 {
			animation-range: contain 31% contain 41%;
		}
		.p2-bloque--2 {
			animation-range: contain 34% contain 44%;
		}

		.p2-anillo {
			animation: p2-anillo-entra cubic-bezier(0.2, 0.8, 0.2, 1) both;
			animation-timeline: --que-hace;
			animation-range: contain 2% contain 14%;
		}

		.p2-orb {
			animation: p2-orbita-entra cubic-bezier(0.2, 0.8, 0.2, 1) both;
			animation-timeline: --que-hace;
		}
		.p2-orb--0 {
			animation-range: contain 6% contain 20%;
		}
		.p2-orb--1 {
			animation-range: contain 10% contain 24%;
		}
		.p2-orb--2 {
			animation-range: contain 14% contain 28%;
		}

		/* Estela: fade atado al scroll + giro por tiempo (timeline `auto`). */
		.p2-estela {
			animation: p2-fade linear both, p2-gira 6s linear infinite;
			animation-timeline: --que-hace, auto;
			animation-range: contain 22% contain 32%, normal;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.p2-titular,
		.p2-cierre,
		.p2-bloque,
		.p2-anillo,
		.p2-orb {
			animation: none !important;
			opacity: 1;
			transform: none;
		}
		.p2-estela {
			animation: none !important;
			opacity: 1;
		}
	}
</style>
