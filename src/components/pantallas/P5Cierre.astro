---
/**
 * P5Cierre.astro — P5 · Cierre / CTA (`cierre`), última de las 5 secciones del escenario vertical.
 * Rediseño 2026-11-02 (fusión "la ruta llega a destino" + "el celular protagonista"). Contenido en
 * `src/data/cierre.ts`.
 *
 * === Composición ===
 * - El celular fijo (centrado, ver `TELEFONO.cierre` en escenario.ts) es el destino: una RUTA se
 *   dibuja con el scroll desde el borde izquierdo del marco hasta el borde del celular y remata en
 *   un pin.
 * - Sobre la pantalla del celular se arma el LOGO (isotipo + nombre) con el gesto de P1 — vive en
 *   `Telefono.astro` (`.telefono__bienvenida`) y lo enciende la clase `:root.en-cierre` que pone el
 *   script de abajo cuando la sección ya está casi a la vista. El nombre de la marca aparece SOLO
 *   ahí: ni el titular ni este componente lo repiten.
 * - A la derecha del celular: kicker «Muy pronto», titular y CTA de WhatsApp.
 *
 * === Sin meseta (L=100) → rango `entry`, no `contain` ===
 * "cierre" mide 100svh: no hay tramo pineado, la sección entra y el documento termina. Los gestos
 * van sobre `animation-range: entry …` del `view-timeline: --cierre`.
 *
 * === CTA ===
 * Mientras `whatsapp.numero` sea `null` no se renderiza el botón en build (solo un hueco punteado
 * bajo `astro dev`). Ver `cierre.ts`.
 */
import Seccion from '../Seccion.astro';
import { kicker, titular, apoyo, whatsapp, enlaceWhatsApp, encuestas } from '../../data/cierre.ts';
import logoWhatsApp from '../../assets/whatsapp.svg?raw';
import qrExtranjeros from '../../assets/qr/extranjeros.svg?raw';
import qrUruguayos from '../../assets/qr/uruguayos.svg?raw';
import qrEstablecimientos from '../../assets/qr/establecimientos.svg?raw';

const qr: Record<string, string> = {
	extranjeros: qrExtranjeros,
	uruguayos: qrUruguayos,
	establecimientos: qrEstablecimientos,
};

const href = enlaceWhatsApp();
---

<Seccion id="cierre">
	<div class="p5 seccion__caja">
		<!-- Ruta que llega al celular (solo escritorio). Ancho = del borde del marco al borde del celular. -->
		<div class="p5-ruta" aria-hidden="true">
			<svg viewBox="0 0 100 100" preserveAspectRatio="none">
				<path
					class="p5-ruta__base"
					d="M 0 88 C 30 88, 38 50, 100 50"
					pathLength="1"
					vector-effect="non-scaling-stroke"></path>
			</svg>
			<svg class="p5-ruta__trazo" viewBox="0 0 100 100" preserveAspectRatio="none">
				<path d="M 0 88 C 30 88, 38 50, 100 50" vector-effect="non-scaling-stroke"></path>
			</svg>
			<span class="p5-ruta__pin"></span>
		</div>

		<div class="p5-mensaje">
			<div class="p5-cabeza">
				<p class="p5-kicker">{kicker}</p>
				<h2 class="p5-titular">{titular}</h2>
			</div>
			<section class="p5-encuestas" aria-labelledby="p5-encuestas-titulo">
				<h3 class="p5-encuestas__titulo" id="p5-encuestas-titulo">{encuestas.titulo}</h3>
				<p class="p5-encuestas__bajada">{encuestas.bajada}</p>
				<p class="p5-encuestas__instruccion">
					<svg class="p5-encuestas__icono p5-encuestas__icono--qr" viewBox="0 0 24 24" aria-hidden="true">
						<path d="M3 8V5a2 2 0 0 1 2-2h3M16 3h3a2 2 0 0 1 2 2v3M21 16v3a2 2 0 0 1-2 2h-3M8 21H5a2 2 0 0 1-2-2v-3" />
						<rect x="7.5" y="7.5" width="3.5" height="3.5" rx=".6" />
						<rect x="13" y="7.5" width="3.5" height="3.5" rx=".6" />
						<rect x="7.5" y="13" width="3.5" height="3.5" rx=".6" />
						<path d="M13.5 15h3M15 13.5v3" />
					</svg>
					<span class="p5-solo-escritorio">{encuestas.instruccion}</span>
					<span class="p5-solo-movil">{encuestas.instruccionMovil}</span>
					<svg class="p5-encuestas__icono" viewBox="0 0 24 24" aria-hidden="true">
						<path d="M9 11V5a1.6 1.6 0 0 1 3.2 0v5.2m0 0V9.4a1.6 1.6 0 0 1 3.2 0v1.2m0 0v-.2a1.6 1.6 0 0 1 3.2 0V15a6 6 0 0 1-6 6h-1.2a6 6 0 0 1-4.7-2.3L4.4 15.6a1.7 1.7 0 0 1 2.6-2.1L9 15.5" />
					</svg>
				</p>
				<ul class="p5-encuestas__lista">
					{
						encuestas.formularios.map((f) => (
							<li>
								<a class="p5-encuesta" href={f.url} target="_blank" rel="noopener">
									<span class="p5-encuesta__qr" aria-hidden="true" set:html={qr[f.id]} />
									<span class="p5-encuesta__etiqueta">{f.etiqueta}</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
			<div class="p5-accion">
				{
					href ? (
						<>
							<a class="p5-wsp" href={href} target="_blank" rel="noopener" aria-label={whatsapp.texto}>
								<span class="p5-wsp__texto">{whatsapp.texto}</span>
								<svg class="p5-wsp__flecha" viewBox="0 0 60 24" aria-hidden="true">
									<path d="M2 14 C 18 4, 34 4, 54 12" />
									<path d="M45 5 L 55 12.5 L 44 18" />
								</svg>
								<span class="p5-wsp__logo" aria-hidden="true" set:html={logoWhatsApp} />
							</a>
							<p class="p5-apoyo">{apoyo}</p>
						</>
					) : (
						<>
							{import.meta.env.DEV && <p class="p5-hueco">[Botón de WhatsApp — falta el número]</p>}
							<p class="p5-apoyo">{apoyo}</p>
						</>
					)
				}
			</div>
		</div>
	</div>
</Seccion>

<script>
	// Enciende el logo sobre el celular cuando la ruta LLEGA a destino (casi al final del tramo
	// pineado de P5). Al volver hacia arriba se apaga y las piezas vuelven a su lugar de partida.
	// Sin scroll-driven (Firefox: la sección mide ~100vh y no hay tramo pineado) el progreso no
	// existe: se enciende apenas la sección está casi a la vista.
	const seccion = document.getElementById('cierre');
	if (seccion) {
		const raiz = document.documentElement;
		let pendiente = false;
		const evaluar = () => {
			pendiente = false;
			const r = seccion.getBoundingClientRect();
			const meseta = r.height - window.innerHeight;
			const llego =
				meseta > 8
					? -r.top / meseta >= 0.92
					: r.top < window.innerHeight * 0.4 && r.bottom > window.innerHeight * 0.6;
			raiz.classList.toggle('en-cierre', llego);
		};
		const pedir = () => {
			if (!pendiente) {
				pendiente = true;
				requestAnimationFrame(evaluar);
			}
		};
		addEventListener('scroll', pedir, { passive: true });
		addEventListener('resize', pedir);
		evaluar();
	}
</script>

<style>
	/* Ancho del celular de P5: alto base 56svh × escala 1.04, relación 9/17 → ≈ 31svh; mitad ≈ 15.5svh.
	 * Cota izquierda del bloque derecho y borde derecho de la ruta salen de acá. */
	.p5 {
		--p5-medio-celular: 15.5svh;
		align-content: center;
	}

	/* Marco de composición (como P1–P4, ver `--marco-max` en tokens.css). */
	@media (width >= 900px) {
		.p5 {
			padding-inline: max(
				clamp(1.25rem, 4vw, 4rem),
				calc((100% - var(--marco-max)) / 2 + clamp(1.25rem, 4vw, 4rem))
			);
		}
	}

	/* === Mensaje (a la derecha del celular) === */
	.p5-mensaje {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--espacio-md);
		margin-inline-start: auto;
		width: calc(50% - var(--p5-medio-celular) - 2rem);
		max-width: 30rem;
	}

	@media (width < 900px) {
		.p5 {
			align-content: start;
		}
		.p5-mensaje {
			width: auto;
			max-width: none;
			margin-inline: 0;
			align-items: center;
			text-align: center;
			gap: 0.65rem;
		}
	}

	/* Kicker + titular: en escritorio van a la IZQUIERDA del celular (fuera del flujo, para no saturar
	 * la columna derecha), en la parte alta, por encima de la ruta. En móvil siguen en la columna. */
	.p5-cabeza {
		display: flex;
		flex-direction: column;
		gap: var(--espacio-md);
		align-items: inherit;
	}

	@media (width >= 900px) {
		.p5-cabeza {
			position: absolute;
			z-index: 1;
			top: 11%;
			inset-inline-start: max(
				clamp(1.25rem, 4vw, 4rem),
				calc((100% - var(--marco-max)) / 2 + clamp(1.25rem, 4vw, 4rem))
			);
			width: calc(50% - var(--p5-medio-celular) - 2rem - max(clamp(1.25rem, 4vw, 4rem), calc((100% - var(--marco-max)) / 2 + clamp(1.25rem, 4vw, 4rem))));
			align-items: flex-start;
		}
	}

	.p5-kicker {
		margin: 0;
		font-family: var(--fuente-display);
		font-weight: 800;
		font-size: var(--texto-sm);
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--color-verde-vivo);
	}

	.p5-titular {
		margin: 0;
		font-family: var(--fuente-display);
		font-weight: 800;
		font-size: clamp(2.25rem, 1.6rem + 3.2vw, 4rem);
		line-height: 1.05;
		color: #fff;
		text-shadow: 0 1px 16px color-mix(in srgb, var(--color-marino-noche) 70%, transparent);
	}

	@media (width < 900px) {
		.p5-titular {
			font-size: clamp(1.65rem, 1.1rem + 3.5vw, 2.5rem);
		}
	}

	.p5-accion {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--espacio-xs);
	}

	@media (width < 900px) {
		.p5-accion {
			align-items: center;
		}
	}

	/* WhatsApp: logo y texto sueltos (sin botón), con una flecha que va del texto al logo. */
	.p5-wsp {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		color: #fff;
		text-decoration: none;
	}

	.p5-wsp__texto {
		font-family: var(--fuente-texto);
		font-weight: 600;
		font-size: var(--texto-base);
	}

	.p5-wsp__flecha {
		width: 3rem;
		height: auto;
		flex: none;
		fill: none;
		stroke: var(--color-celeste);
		stroke-width: 2.5;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition: translate 180ms ease;
	}

	.p5-wsp__logo {
		display: block;
		width: 2.75rem;
		height: 2.75rem;
		flex: none;
		color: #25d366;
		transition: scale 180ms ease;
	}

	.p5-wsp__logo :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.p5-wsp:hover .p5-wsp__logo,
	.p5-wsp:focus-visible .p5-wsp__logo {
		scale: 1.12;
	}

	.p5-wsp:hover .p5-wsp__flecha,
	.p5-wsp:focus-visible .p5-wsp__flecha {
		translate: 4px 0;
	}

	.p5-apoyo {
		margin: 0;
		font-family: var(--fuente-texto);
		font-size: var(--texto-sm);
		color: rgb(255 255 255 / 0.7);
	}

	/* Hueco de desarrollo — solo bajo `astro dev`: nunca llega a `dist/`. */
	.p5-hueco {
		margin: 0;
		padding: 0.6rem 1.1rem;
		border: 1.5px dashed rgb(255 255 255 / 0.7);
		border-radius: var(--radio-md);
		font-family: var(--fuente-texto);
		font-size: var(--texto-sm);
		color: rgb(255 255 255 / 0.7);
	}

	/* === Encuestas: tarjetas con QR clickeable (en móvil, solo botones) === */
	.p5-encuestas {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		width: 100%;
	}

	.p5-encuestas__titulo {
		margin: 0;
		font-family: var(--fuente-display);
		font-weight: 800;
		font-size: clamp(1.35rem, 1.1rem + 0.9vw, 1.75rem);
		line-height: 1.15;
		color: var(--color-celeste);
	}

	.p5-encuestas__bajada {
		margin: 0;
		font-family: var(--fuente-texto);
		font-size: var(--texto-sm);
		line-height: 1.4;
		color: rgb(255 255 255 / 0.78);
	}

	.p5-encuestas__instruccion {
		margin: 0;
		font-family: var(--fuente-texto);
		font-weight: 600;
		font-size: var(--texto-sm);
		color: var(--color-verde-vivo);
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.p5-encuestas__icono {
		width: 1.35rem;
		height: 1.35rem;
		flex: none;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.p5-solo-movil {
		display: none;
	}

	.p5-encuestas__lista {
		list-style: none;
		margin: 0.35rem 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.75rem;
	}

	.p5-encuesta {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		padding: 0.4rem 0.25rem;
		color: #fff;
		text-decoration: none;
		text-align: center;
		transition:
			transform 180ms ease,
			box-shadow 180ms ease;
	}

	.p5-encuesta:hover,
	.p5-encuesta:focus-visible {
		transform: translateY(-3px);
	}

	.p5-encuesta:hover .p5-encuesta__qr,
	.p5-encuesta:focus-visible .p5-encuesta__qr {
		filter: drop-shadow(0 0 8px color-mix(in srgb, var(--color-celeste) 70%, transparent));
	}

	.p5-encuesta__qr {
		display: block;
		width: 100%;
		max-width: 5.75rem;
		aspect-ratio: 1;
		color: var(--color-celeste);
		transition: filter 180ms ease;
	}

	.p5-encuesta__qr :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.p5-encuesta__etiqueta {
		font-family: var(--fuente-texto);
		font-weight: 700;
		font-size: var(--texto-xs);
		line-height: 1.2;
	}

	/* Móvil: nadie escanea un QR desde el mismo teléfono → tres botones con el enlace. */
	@media (width < 900px) {
		.p5-encuestas {
			align-items: center;
		}
		.p5-encuestas__icono--qr,
		.p5-solo-escritorio {
			display: none;
		}
		.p5-solo-movil {
			display: inline;
		}
		.p5-encuestas__lista {
			grid-template-columns: 1fr;
			width: min(100%, 20rem);
			gap: 0.5rem;
		}
		.p5-encuesta {
			padding: 0.7rem 1rem;
			border: 1.5px solid var(--color-celeste);
			border-radius: var(--radio-full);
		}
		.p5-encuesta__qr {
			display: none;
		}
		.p5-encuesta__etiqueta {
			font-size: var(--texto-sm);
		}
	}

	/* === Ruta que llega al celular (solo escritorio) === */
	.p5-ruta {
		display: none;
	}

	@media (width >= 900px) {
		.p5-ruta {
			display: block;
			position: absolute;
			z-index: 0;
			top: 0;
			bottom: 0;
			inset-inline-start: max(0px, calc((100% - var(--marco-max)) / 2));
			inset-inline-end: calc(50% + var(--p5-medio-celular));
			pointer-events: none;
		}
	}

	.p5-ruta svg {
		/* base punteada y trazo comparten caja; el trazo se REVELA de izquierda a derecha (clip-path) */
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	.p5-ruta path {
		fill: none;
		stroke-linecap: butt;
		stroke-width: 5;
		/* Trazos de ruta. En px de pantalla (non-scaling-stroke), igual en la base y en el trazo para que calcen. */
		stroke-dasharray: 54 28;
	}

	.p5-ruta__base {
		stroke: rgb(255 255 255 / 0.14);
	}

	.p5-ruta__trazo path {
		stroke: var(--color-celeste);
	}

	/* Pin al final de la ruta: en el borde del celular, a media altura (y = 50% del trazo). */
	.p5-ruta__pin {
		position: absolute;
		inset-inline-end: 0;
		top: 50%;
		width: 1.1rem;
		height: 1.1rem;
		translate: 50% -50%;
		border-radius: 50%;
		background: var(--color-bandera-amarillo);
		box-shadow:
			0 0 0 4px color-mix(in srgb, var(--color-bandera-amarillo) 30%, transparent),
			0 0 22px color-mix(in srgb, var(--color-bandera-amarillo) 60%, transparent);
	}

	/* === Gesto de P5 ===
	 * Entrada (la sección sube al viewport, ~100svh de scroll): los elementos CAEN en su lugar y la
	 * ruta avanza hasta la mitad. Después, con P5 quieta (50svh de tramo pineado, `cierre: 150` en
	 * escenario.ts), la ruta termina de llegar al celular, cae el pin y se arma el logo (script).
	 * La ruta es UNA sola animación sobre `entry 0% → contain 100%`; entry ocupa 100/150 = 66,7% del
	 * rango, ahí el trazo está a la mitad. Si cambia `cierre` en escenario.ts, recalcular ese 66.7%
	 * y los de abajo. */
	@keyframes p5-ruta-dibuja {
		from {
			clip-path: inset(-10% 100% -10% 0);
		}
		66.7% {
			clip-path: inset(-10% 50% -10% 0);
		}
		to {
			clip-path: inset(-10% 0% -10% 0);
		}
	}

	/* El pin cae desde arriba sobre el destino y rebota (último 25% del tramo pineado). */
	@keyframes p5-pin-cae {
		0%,
		50% {
			opacity: 0;
			translate: 50% -650%;
		}
		52% {
			opacity: 1;
		}
		75% {
			translate: 50% -50%;
		}
		87% {
			translate: 50% -170%;
		}
		100% {
			opacity: 1;
			translate: 50% -50%;
		}
	}

	@keyframes p5-cae {
		from {
			opacity: 0;
			transform: translateY(-3.5rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@supports (animation-timeline: scroll(root)) {
		.p5-ruta__trazo {
			animation: p5-ruta-dibuja linear both;
			animation-timeline: --cierre;
			animation-range: entry 0% contain 100%;
		}
		.p5-ruta__pin {
			translate: 50% -50%;
			animation: p5-pin-cae linear both;
			animation-timeline: --cierre;
			animation-range: contain 0% contain 100%;
		}
		.p5-kicker,
		.p5-titular,
		.p5-encuestas,
		.p5-accion {
			animation: p5-cae cubic-bezier(0.2, 0.7, 0.2, 1) both;
			animation-timeline: --cierre;
		}
		.p5-kicker {
			animation-range: entry 5% entry 40%;
		}
		.p5-titular {
			animation-range: entry 25% entry 65%;
		}
		.p5-encuestas {
			animation-range: entry 40% entry 80%;
		}
		.p5-accion {
			animation-range: entry 55% entry 95%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.p5-ruta__trazo,
		.p5-ruta__pin,
		.p5-kicker,
		.p5-titular,
		.p5-encuestas,
		.p5-accion {
			animation: none !important;
			opacity: 1;
			transform: none;
		}
	}
</style>
