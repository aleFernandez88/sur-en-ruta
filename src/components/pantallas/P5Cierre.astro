---
/**
 * P5Cierre.astro — P5 · Cierre / CTA (`cierre`), última de las 5 secciones del escenario vertical.
 * Reescrita sobre `<Seccion>` en Bloque E, E11 (docs/planes/2026-09-23-bloque-e-secciones-chrome.md
 * §5). Contenido en `src/data/cierre.ts`.
 *
 * === Sin meseta (L=100) → rango `entry`, no `contain` ===
 * A diferencia de las otras 4 secciones, "cierre" mide exactamente 100svh (`PRESUPUESTO_SVH`,
 * escenario.ts): no hay tramo pineado, la sección entra y el documento termina. Todos los gestos
 * van sobre `animation-range: entry …` del propio `view-timeline: --cierre` (la fase en la que la
 * sección está ENTRANDO al viewport), no `contain` (que acá mediría 0).
 *
 * === Barrido del titular — reimplementado para cumplir la restricción 4 (H de este bloque) ===
 * La versión "cinta" animaba `background-position` con un keyframe fijo (sin variable). Acá se
 * anima un `@property --p5-barrido` (`<percentage>`) registrado, y la declaración usa
 * `background-position: var(--p5-barrido) 0` — la variable va en la DECLARACIÓN, nunca dentro de
 * un `@keyframes` (restricción 3 de escenario.ts).
 *
 * === CTA bloqueado (D1) ===
 * `cierre.ts` tiene `cta: null`. En dev se ve un hueco marcado con borde punteado; en build no se
 * renderiza nada — nunca llega a producción un botón sin acción.
 */
import Seccion from '../Seccion.astro';
import logoUrl from '../../assets/logo/isotipo-original.svg?url';
import { titular, cta } from '../../data/cierre.ts';
---

<Seccion id="cierre">
	<div class="p5 seccion__caja">
		<div class="p5-contenido">
			<div class="p5-marca">
				<img class="p5-isotipo" src={logoUrl} alt="" width="96" height="88" />
				<p class="p5-nombre">Sur en Ruta</p>
			</div>

			<div class="p5-mensaje">
				<h2 class="p5-titular">{titular}</h2>
				<div class="p5-accion">
					{
						cta ? (
							<>
								<a class="p5-boton" href={cta.href}>
									{cta.texto}
								</a>
								{cta.apoyo && <p class="p5-apoyo">{cta.apoyo}</p>}
							</>
						) : import.meta.env.DEV ? (
							<p class="p5-hueco">[CTA — a definir (D1)]</p>
						) : null
					}
				</div>
			</div>
		</div>
	</div>
</Seccion>

<style>
	@property --p5-barrido {
		syntax: '<percentage>';
		inherits: false;
		initial-value: 140%;
	}

	.p5 {
		align-content: center;
	}

	.p5-contenido {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: var(--espacio-lg);
		width: 100%;
	}

	/* Deja libre el ancho del celular (x 0, centrado) — cada columna se achica en función del
	 * ancho disponible menos una reserva aproximada del celular (18svh). */
	.p5-marca,
	.p5-mensaje {
		max-width: calc(100vw / 2 - 18svh);
	}

	@media (width < 900px) {
		.p5 {
			align-content: start;
		}
		.p5-contenido {
			flex-direction: column;
			align-items: center;
			text-align: center;
			/* AJUSTE DEL EJECUTOR sobre el plan (E11), con evidencia: en 369×698 el hueco de CTA
			 * (`astro dev`) quedaba superpuesto con `.telefono__marco` (confirmado con
			 * elementFromPoint, overlap real, casi cero margen). Gap más chico. */
			gap: 0.65rem;
		}
		.p5-marca,
		.p5-mensaje {
			max-width: none;
		}
	}

	.p5-marca {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--espacio-xs);
	}

	@media (width < 900px) {
		.p5-marca {
			align-items: center;
		}
	}

	.p5-isotipo {
		width: clamp(4.5rem, 4vw + 3.5rem, 7rem);
		height: auto;
	}

	@media (width < 900px) {
		.p5-isotipo {
			width: clamp(3rem, 8vw + 1.5rem, 4.5rem);
		}
	}

	.p5-nombre {
		margin: 0;
		font-family: var(--fuente-marca);
		font-size: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
		color: var(--color-marino);
	}

	@media (width < 900px) {
		.p5-nombre {
			font-size: clamp(1.75rem, 1rem + 4vw, 2.75rem);
		}
	}

	.p5-mensaje {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--espacio-md);
	}

	@media (width < 900px) {
		.p5-mensaje {
			align-items: center;
		}
	}

	.p5-titular {
		margin: 0;
		font-family: var(--fuente-display);
		font-weight: 800;
		font-size: clamp(2.25rem, 1.6rem + 3.2vw, 4.25rem);
		line-height: 1.05;
		max-width: 22ch;
		/* Estado final / fallback (sin scroll-driven, o prefers-reduced-motion): color sólido, sin
		 * background-clip — restricción 1 de escenario.ts. */
		color: var(--color-marino);
	}

	@media (width < 900px) {
		.p5-titular {
			font-size: clamp(1.65rem, 1.1rem + 3.5vw, 2.5rem);
		}
	}

	.p5-accion {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--espacio-xs);
	}

	@media (width < 900px) {
		.p5-accion {
			align-items: center;
		}
	}

	.p5-boton {
		display: inline-flex;
		align-items: center;
		padding: 0.85rem 1.75rem;
		border-radius: var(--radio-full);
		background: var(--color-verde);
		color: var(--color-texto-sobre-foto);
		font-family: var(--fuente-texto);
		font-weight: 700;
		font-size: var(--texto-base);
		text-decoration: none;
	}

	.p5-apoyo {
		margin: 0;
		font-family: var(--fuente-texto);
		font-size: var(--texto-sm);
		color: var(--color-tinta-suave);
	}

	/* Hueco de desarrollo — solo bajo `astro dev` (ver frontmatter): nunca llega a `dist/`. */
	.p5-hueco {
		margin: 0;
		padding: 0.6rem 1.1rem;
		border: 1.5px dashed var(--color-tinta-suave);
		border-radius: var(--radio-md);
		font-family: var(--fuente-texto);
		font-size: var(--texto-sm);
		color: var(--color-tinta-suave);
	}

	/* === "El bloque llega" — único zoom-out de toda la cinta === */
	@keyframes p5-contenido-asienta {
		from {
			transform: scale(1.1);
		}
		to {
			transform: scale(1);
		}
	}

	@supports (animation-timeline: scroll(root)) {
		.p5-contenido {
			transform: scale(1.1);
			animation: p5-contenido-asienta linear both;
			animation-timeline: --cierre;
			animation-range: entry 0% entry 80%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.p5-contenido {
			animation: none !important;
			transform: none;
		}
	}

	/* === "El titular se enciende" — barrido de color, único gradient-text del sitio === */
	@keyframes p5-titular-enciende {
		from {
			--p5-barrido: 140%;
		}
		to {
			--p5-barrido: 0%;
		}
	}

	@supports (animation-timeline: scroll(root)) {
		.p5-titular {
			background-image: linear-gradient(
				100deg,
				var(--color-marino) 0%,
				var(--color-marino) 35%,
				var(--color-verde) 50%,
				var(--color-marino) 65%,
				var(--color-marino) 100%
			);
			background-size: 260% 100%;
			background-position: var(--p5-barrido) 0;
			-webkit-background-clip: text;
			background-clip: text;
			color: transparent;
			animation: p5-titular-enciende linear both;
			animation-timeline: --cierre;
			animation-range: entry 20% entry 90%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.p5-titular {
			animation: none !important;
			background-image: none;
			-webkit-background-clip: unset;
			background-clip: unset;
			color: var(--color-marino);
		}
	}

	/* === El isotipo "choca" — mismo gesto ya aprobado de la vieja Pantalla 1 === */
	@keyframes p5-isotipo-choca {
		0% {
			transform: translateY(125%);
		}
		48% {
			transform: translateY(0%);
		}
		58% {
			transform: translateY(-20%) scaleY(1.12);
		}
		72% {
			transform: translateY(7%) scaleY(0.84);
		}
		84% {
			transform: translateY(-6%) scaleY(1.06);
		}
		93% {
			transform: translateY(2%) scaleY(0.98);
		}
		100% {
			transform: translateY(0%) scaleY(1);
		}
	}

	@supports (animation-timeline: scroll(root)) {
		.p5-isotipo {
			transform-origin: bottom center;
			animation: p5-isotipo-choca linear both;
			animation-timeline: --cierre;
			animation-range: entry 70% entry 100%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.p5-isotipo {
			animation: none !important;
			transform: none;
		}
	}
</style>
