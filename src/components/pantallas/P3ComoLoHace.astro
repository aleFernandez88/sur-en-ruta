---
/**
 * P3ComoLoHace.astro — P3 · ¿Cómo lo hace? (`como-lo-hace`), 3ª de las 5 secciones del escenario
 * vertical. Reescrita sobre `<Seccion>` en Bloque E, E9
 * (docs/planes/2026-09-23-bloque-e-secciones-chrome.md §5). Copy literal de
 * `docs/landing-contenido.md` § P3 (deck `pag-07-herramientas.png` + `pag-04-como-funciona.png`).
 *
 * === Dos beats superpuestos en la misma caja ===
 * Beat A (`contain 0% → 44%`, herramientas) y Beat B (`contain 44% → 100%`, los 5 pasos) ocupan el
 * MISMO `grid-area: 1/1` — se cruzan (Beat A sale con fade+translate entre 44%-52% mientras Beat B
 * ya está ahí), igual patrón de superposición que usa P4 para sus 6 rutas.
 *
 * === Beat A rediseñado (2026-11-02): ilustraciones, no cards ===
 * Las 4 herramientas se muestran UNA A LA VEZ, cada una como objeto ilustrado propio (App = el
 * celular fijo, con una flecha; Pasaporte, Sello y Señalética = SVG en `../ilustraciones/`), atadas al
 * scroll: cada lámina entra/sale en su tramo de `RANGOS` y sus ilustraciones animan con el MISMO
 * `animation-range`. Opción "C" del tablero de ideas aprobado por Ale.
 *
 * === Contenido a la derecha (celular en x −25%) ===
 * `margin-left: 40vw` en desktop dentro de `.seccion__caja` — el celular de esta sección queda
 * centro-izquierda (`escenario.ts`, `TELEFONO['como-lo-hace'].escritorio.x = -25`). En mobile el
 * contenido va arriba, sin margen.
 *
 * === Numerales 01-05 ===
 * Antes vivían en nodos SEPARADOS sobre una ruta ondulada SVG (posicionados en `left:%`,
 * sincronizados a mano con la tarjeta de abajo). Ahora cada numeral es HIJO de su propia tarjeta:
 * "viajan con la fila", no se animan aparte (E9 del plan). Se borra la ruta ondulada SVG y sus
 * nodos con *pop*.
 *
 * === Qué se borra respecto de la versión "cinta" ===
 * el shell de pantalla/lámina de la cinta (y su cuña diagonal — D-F: en la Opción 3 solo se
 * rescata la onda, banda de E12), la ruta ondulada SVG, los nodos con *pop* sueltos, los imports
 * del módulo de la cinta y toda la variable de progreso horizontal.
 */
import Seccion from '../Seccion.astro';
import Icono from '../Icono.astro';
import IlusPasaporte from '../ilustraciones/IlusPasaporte.astro';
import IlusSello from '../ilustraciones/IlusSello.astro';
import IlusSenaletica from '../ilustraciones/IlusSenaletica.astro';
import { herramientas } from '../../data/herramientas.ts';
import { conMarca } from '../../lib/marca.ts';
import { pasos } from '../../data/pasos.ts';

// Tramo de scroll (rango `contain`, relativo al pin de ESTA sección) de cada herramienta del Beat A,
// en el orden de `herramientas`: App · Pasaporte · Sello · Señalética. Los cruces entre láminas
// ocurren en VENTANAS IGUALES de 4% (8–12, 20–24, 32–36): la que sale y la que entra comparten
// exactamente el mismo tramo, así no hay bache de opacidad. Los porcentajes de los @keyframes de
// abajo (p3-slide-*, p3-chip-*) y de las ilustraciones salen de estos rangos: si se cambian acá,
// hay que recalcularlos. Literales: `animation-range` nunca con var() (restricción 4 de escenario.ts).
// La última queda hasta que sale el beat completo (44%→52%).
const RANGOS = [
	'contain 0% contain 12%',
	'contain 8% contain 24%',
	'contain 20% contain 36%',
	'contain 32% contain 44%',
];
const POS = ['primero', 'medio', 'medio', 'ultimo'];
// Click en un chip (% del tramo pineado): se salta DIRECTO a la entrada de la lámina (INICIO: ya
// completa, sin vecinas, con sus animaciones propias en 0) y desde ahí avanza hasta DESTINO
// (animaciones terminadas, antes de que empiece su salida). Nunca recorre láminas intermedias.
const INICIO = [3, 12, 24, 36];
const DESTINO = [4, 19, 31.5, 41];
const COLORES = ['var(--color-celeste)', 'var(--color-bandera-amarillo)', 'var(--color-verde-vivo)', '#ffffff'];
const CORTOS = ['App', 'Pasaporte', 'Sello', 'Señalética'];

// Nombre de la herramienta con el nombre de la MARCA como en el logo (`.marca`, ver marca.ts). En la
// App, la palabra «App» pasa a un peso liviano para que el protagonista sea «SUR EN RUTA».
const nombreHtml = (nombre: string) =>
	conMarca(nombre).replace(/^App /, '<span class="p3-app">App</span> ');
---

<Seccion id="como-lo-hace">
	<div class="p3 seccion__caja">
		<div class="p3-caja">
			<!-- Beat A — 4 herramientas, una a la vez, como ilustraciones -->
			<div class="p3-beat-a">
				<h2 class="p3-titular">Herramientas que <span class="realce">conectan</span> la experiencia</h2>
				<p class="p3-idea">Con herramientas que trabajan juntas.</p>
				<div class="p3-escena">
					{
						herramientas.map((h, i) => (
							<div
								class={`p3-slide p3-slide--${POS[i]}${h.icono === 'sello' ? ' p3-slide--sello' : ''}`}
								style={`--c: ${COLORES[i]}; animation-range: ${RANGOS[i]}`}
							>
								<div class="p3-slide-obj">
									{h.icono === 'app' && (
										<svg class="p3-flecha" viewBox="0 0 120 120" aria-hidden="true">
											<path d="M104 60 H22 M46 34 L20 60 L46 86" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
									)}
									{h.icono === 'pasaporte' && <IlusPasaporte rango={RANGOS[i]} />}
									{h.icono === 'sello' && <IlusSello rango={RANGOS[i]} />}
									{h.icono === 'senaletica' && <IlusSenaletica rango={RANGOS[i]} />}
								</div>
								<div class="p3-slide-texto">
									<p class="p3-slide-nombre" set:html={nombreHtml(h.nombre)} />
									<p class="p3-slide-que">{h.que}</p>
									{h.icono !== 'app' && <span class="p3-rotulo">Vista conceptual</span>}
								</div>
							</div>
						))
					}
				</div>
				<div class="p3-chips" role="group" aria-label="Herramientas">
					{
						CORTOS.map((c, i) => (
							<button
								type="button"
								class={`p3-chip p3-chip--${POS[i]}`}
								data-inicio={INICIO[i]}
				data-destino={DESTINO[i]}
								aria-label={`Ver ${herramientas[i].nombre}`}
								style={`--c: ${COLORES[i]}; animation-range: ${RANGOS[i]}`}
							>
								{c}
							</button>
						))
					}
				</div>
				<p class="p3-beat-a-cierre">Tecnología, comunidad y comunicación al servicio del viaje.</p>
			</div>

			<!-- Beat B — 5 pasos -->
			<div class="p3-beat-b">
				<p class="p3-subtitulo">Una experiencia simple, organizada y conectada.</p>
				<div class="p3-carril">
					<div class="p3-carril-fila">
						{
							pasos.map((p, k) => (
								<div class="p3-paso">
									<span class="p3-paso-numeral" aria-hidden="true">
										{String(k + 1).padStart(2, '0')}
									</span>
									<span class="p3-paso-icono">
										<Icono nombre={p.icono} tamano={34} acento="var(--color-verde)" />
									</span>
									<h3 class="p3-paso-titulo">{p.titulo}</h3>
									<p class="p3-paso-frase">{p.frase}</p>
								</div>
							))
						}
					</div>
				</div>
				<p class="p3-beat-b-cierre">
					Una red que <strong>organiza el viaje</strong> y <strong>potencia los destinos</strong>.
				</p>
			</div>
		</div>
	</div>
</Seccion>

<style>
	.p3 {
		align-content: center;
	}

	.p3-caja {
		display: grid;
		margin-left: 40vw;
	}

	@media (width < 900px) {
		.p3 {
			align-content: start;
		}
		.p3-caja {
			margin-left: 0;
		}
	}

	.p3-beat-a,
	.p3-beat-b {
		grid-area: 1 / 1;
		display: flex;
		flex-direction: column;
		gap: var(--espacio-sm);
	}

	/* Beat B está después en el DOM (= encima): sin esto taparía los chips del Beat A. */
	.p3-beat-b {
		pointer-events: none;
	}

	/* === Beat A — 4 herramientas, UNA A LA VEZ === */
	.p3-titular {
		margin: 0;
		font-family: var(--fuente-display);
		font-weight: 200;
		font-size: clamp(2rem, 1.2rem + 3vw, 3.8rem);
		line-height: 1.05;
		max-width: 22ch;
		color: var(--color-texto-sobre-foto);
	}

	.p3-titular .realce {
		font-weight: 800;
	}

	.p3-idea {
		margin: 0;
		font-family: var(--fuente-texto);
		font-weight: 600;
		font-size: var(--texto-base);
		color: var(--color-verde-vivo);
	}

	/* Las 4 láminas comparten celda (grid-area 1/1): una sola se ve a la vez. */
	.p3-escena {
		display: grid;
		margin-block: clamp(0.5rem, 2svh, 1.25rem);
		/* fundido al cambiar de herramienta con un chip (ver el script del final) */
		transition: opacity 0.16s ease;
	}

	.p3-slide {
		grid-area: 1 / 1;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: center;
		gap: clamp(1rem, 2.6vw, 2.4rem);
	}

	.p3-slide-obj {
		display: grid;
		place-items: center;
		min-width: 0;
	}

	/* Alto fijo + ancho automático por la proporción del viewBox. */
	.p3-slide-obj :global(svg) {
		height: min(40svh, 26vw);
		width: auto;
		overflow: visible;
		filter: drop-shadow(0 12px 18px rgb(0 0 0 / 0.45));
	}

	.p3-slide-obj .p3-flecha {
		height: min(16svh, 11vw);
		color: var(--c);
		filter: none;
	}

	.p3-slide-texto {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		min-width: 0;
	}

	.p3-slide-nombre {
		margin: 0;
		font-family: var(--fuente-display);
		font-weight: 800;
		font-size: clamp(1.6rem, 1rem + 1.9vw, 2.9rem);
		line-height: 1.02;
		color: var(--c);
	}

	/* «App»: peso liviano, baja el peso visual frente al nombre de la marca. */
	.p3-slide-nombre :global(.p3-app) {
		font-weight: 300;
	}

	/* El nombre de la marca SIEMPRE como el logo: blanco, Italiana, MAYÚSCULAS con 0,06em (.marca,
	 * base.css). Italiana es una Didone fina y se ve más chica que Archivo a igual tamaño: 1,18em. */
	.p3-slide-nombre :global(.marca) {
		color: #ffffff;
		font-size: 1.18em;
	}

	.p3-slide-que {
		margin: 0;
		font-family: var(--fuente-texto);
		font-size: clamp(1rem, 0.9rem + 0.45vw, 1.3rem);
		line-height: 1.3;
		max-width: 26ch;
		color: rgb(255 255 255 / 0.9);
	}

	.p3-rotulo {
		font-family: var(--fuente-texto);
		font-size: 0.68rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgb(255 255 255 / 0.55);
	}

	/* Selector de herramientas: 4 pastillas SIEMPRE bien visibles; la activa (atada al scroll) se
	 * enciende con relleno sólido, halo y un poco más de tamaño. Click = scroll hasta esa lámina. */
	.p3-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		padding: 0.35rem 0.3rem;
	}

	.p3-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.42rem 1rem;
		border-radius: 999px;
		font-family: var(--fuente-display);
		font-weight: 700;
		font-size: 0.88rem;
		line-height: 1.2;
		color: #ffffff;
		border: 1px solid color-mix(in srgb, var(--c) 80%, transparent);
		background-color: color-mix(in srgb, var(--c) 18%, transparent);
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}

	.p3-chip::before {
		content: '';
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background: var(--c);
		box-shadow: 0 0 0 2px rgb(8 26 49 / 0.85);
	}

	.p3-chip:hover {
		filter: brightness(1.25);
	}

	.p3-chip:focus-visible {
		outline: 2px solid var(--color-bandera-amarillo);
		outline-offset: 3px;
	}

	/* Sello: 40% más chico que el resto de las ilustraciones (pedido de Ale, 2026-11-02). */
	.p3-slide--sello .p3-slide-obj :global(svg) {
		height: min(24svh, 15.6vw);
	}

	.p3-beat-a-cierre {
		margin: 0;
		font-family: var(--fuente-texto);
		font-size: var(--texto-sm);
		color: color-mix(in srgb, var(--color-texto-sobre-foto) 80%, transparent);
	}

	/* === Mobile: Beat A más compacto — con evidencia (390×844/369×698): el contenido va arriba y el
	 * celular ocupa la mitad de abajo; todo tiene que caber sin tocar `.telefono__marco`. */
	@media (width < 900px) {
		.p3-beat-a,
		.p3-beat-b {
			gap: 0.6rem;
		}
		.p3-titular {
			font-size: clamp(1.6rem, 1.1rem + 2.5vw, 2.5rem);
		}
		.p3-slide {
			gap: 1rem;
		}
		.p3-slide-obj :global(svg) {
			height: min(21svh, 38vw);
		}
		.p3-slide--sello .p3-slide-obj :global(svg) {
			height: min(12.6svh, 22.8vw);
		}
		.p3-slide-obj .p3-flecha {
			height: min(10svh, 18vw);
			/* el celular está ABAJO en mobile: la flecha apunta hacia abajo */
			transform: rotate(-90deg);
		}
		.p3-slide-nombre {
			font-size: clamp(1.3rem, 1rem + 1.6vw, 1.8rem);
		}
		.p3-slide-que {
			font-size: 0.95rem;
		}
		.p3-chips {
			gap: 0.45rem;
		}
		.p3-chip {
			font-size: 0.76rem;
			padding: 0.32rem 0.7rem;
			gap: 0.4rem;
		}
	}

	/* Láminas: el cruce (4% de scroll) coincide con el de la vecina. Primera: 0–12% (sale 8–12 = 66,7–100%).
	 * Medias: 16% de largo (entra 0–25%, sale 75–100%). Última: 12% (entra 0–33,3%). */
	@keyframes p3-slide-primero {
		0%,
		66.67% {
			opacity: 1;
			transform: none;
		}
		100% {
			opacity: 0;
			transform: translateY(-1.5rem);
		}
	}

	@keyframes p3-slide-medio {
		0% {
			opacity: 0;
			transform: translateY(1.5rem);
		}
		25%,
		75% {
			opacity: 1;
			transform: none;
		}
		100% {
			opacity: 0;
			transform: translateY(-1.5rem);
		}
	}

	@keyframes p3-slide-ultimo {
		0% {
			opacity: 0;
			transform: translateY(1.5rem);
		}
		33.33%,
		100% {
			opacity: 1;
			transform: none;
		}
	}

	@keyframes p3-chip-primero {
		0%,
		66.67% {
			transform: scale(1.1);
			background-color: var(--c);
			color: #081a31;
			box-shadow:
				0 0 0 4px color-mix(in srgb, var(--c) 35%, transparent),
				0 0 22px color-mix(in srgb, var(--c) 55%, transparent);
		}
		100% {
			transform: scale(1);
			background-color: color-mix(in srgb, var(--c) 18%, transparent);
			color: #ffffff;
			box-shadow:
				0 0 0 0 transparent,
				0 0 0 0 transparent;
		}
	}

	@keyframes p3-chip-medio {
		0% {
			transform: scale(1);
			background-color: color-mix(in srgb, var(--c) 18%, transparent);
			color: #ffffff;
			box-shadow:
				0 0 0 0 transparent,
				0 0 0 0 transparent;
		}
		25%,
		75% {
			transform: scale(1.1);
			background-color: var(--c);
			color: #081a31;
			box-shadow:
				0 0 0 4px color-mix(in srgb, var(--c) 35%, transparent),
				0 0 22px color-mix(in srgb, var(--c) 55%, transparent);
		}
		100% {
			transform: scale(1);
			background-color: color-mix(in srgb, var(--c) 18%, transparent);
			color: #ffffff;
			box-shadow:
				0 0 0 0 transparent,
				0 0 0 0 transparent;
		}
	}

	@keyframes p3-chip-ultimo {
		0% {
			transform: scale(1);
			background-color: color-mix(in srgb, var(--c) 18%, transparent);
			color: #ffffff;
			box-shadow:
				0 0 0 0 transparent,
				0 0 0 0 transparent;
		}
		33.33%,
		100% {
			transform: scale(1.1);
			background-color: var(--c);
			color: #081a31;
			box-shadow:
				0 0 0 4px color-mix(in srgb, var(--c) 35%, transparent),
				0 0 22px color-mix(in srgb, var(--c) 55%, transparent);
		}
	}

	@keyframes p3-beat-b-entra {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@keyframes p3-beat-a-sale {
		from {
			opacity: 1;
			transform: translateY(0);
		}
		to {
			opacity: 0;
			transform: translateY(-3rem);
		}
	}

	@supports (animation-timeline: scroll(root)) {
		.p3-slide,
		.p3-chip {
			animation-timing-function: linear;
			animation-fill-mode: both;
			animation-timeline: --como-lo-hace;
		}
		.p3-slide {
			opacity: 0;
		}
		.p3-slide--primero {
			opacity: 1;
			animation-name: p3-slide-primero;
		}
		.p3-slide--medio {
			animation-name: p3-slide-medio;
		}
		.p3-slide--ultimo {
			animation-name: p3-slide-ultimo;
		}
		.p3-chip--primero {
			animation-name: p3-chip-primero;
		}
		.p3-chip--medio {
			animation-name: p3-chip-medio;
		}
		.p3-chip--ultimo {
			animation-name: p3-chip-ultimo;
		}
		.p3-beat-a {
			animation: p3-beat-a-sale linear both;
			animation-timeline: --como-lo-hace;
			animation-range: contain 44% contain 52%;
		}
		/* HALLAZGO DEL EJECUTOR, corregido acá: Beat B (el carril + subtítulo) nunca tenía entrada
		 * propia — solo la FILA del carril se animaba (traslado horizontal), no el beat en sí. Con
		 * `animation-range` en `both`, antes de `contain 40%` el carril está en su estado "from"
		 * (`translateX(0)`), que dentro de la ventana `56vw` recortada YA muestra los primeros 2
		 * pasos — visibles simultáneo con Beat A (que recién sale en 30-38%), un solapamiento real
		 * confirmado con capturas (no lo detecta C2: ese chequeo solo mide contra el celular/banda,
		 * no entre bloques de contenido de la misma pantalla). Mismo rango que la salida de A, para
		 * que el cruce se lea como una transición, no un salto. */
		.p3-beat-b {
			opacity: 0;
			animation: p3-beat-b-entra linear both;
			animation-timeline: --como-lo-hace;
			animation-range: contain 44% contain 52%;
		}
	}

	/* === Movimiento reducido — DECISIÓN DEL EJECUTOR, marcada para revisión de Ale/arquitecto ===
	 * La superposición `grid-area: 1/1` de los 2 beats es NUEVA de este bloque. Primer intento
	 * (envolver el carril con `flex-wrap` y mostrar los 2 beats a la vez): descartado con
	 * evidencia — `.seccion__pin` tiene `overflow: clip` y alto fijo `100svh` (base.css), así que
	 * "mostrar todo sin recortar" en realidad NO mostraba todo: lo que no entraba en 100svh se
	 * recortaba igual, y encima los 2 beats quedaban superpuestos entre sí. Verificado con el
	 * verificador: 8 FAIL nuevos en vez de 0. Se vuelve al criterio literal de escenario.ts
	 * ("estado final" = el de Beat B, el último de los dos) — Beat A se saca del todo
	 * (`display:none`, no solo opacidad: con opacidad sola seguiría siendo "hit-testable" y
	 * contando como candidato de solapamiento) y el carril de Beat B queda en su posición FINAL
	 * (recortada, como siempre) en vez de a mitad de camino. */
	@media (prefers-reduced-motion: reduce) {
		.p3-beat-a {
			display: none;
		}
		.p3-beat-b {
			animation: none !important;
			opacity: 1;
		}
		.p3-carril-fila {
			animation: none !important;
			/* AJUSTE DEL EJECUTOR (E13): mismo valor que el "to" de @keyframes p3-carril-escritorio
			 * (ver ese comentario) — -70vw → -80vw. */
			transform: translateX(-80vw);
		}
	}

	@media (prefers-reduced-motion: reduce) and (width < 900px) {
		.p3-carril-fila {
			/* AJUSTE DEL EJECUTOR (E13): mismo valor que el "to" de @keyframes p3-carril-movil (ver
			 * ese comentario) — -308vw → -328vw. */
			transform: translateX(-328vw);
		}
	}

	/* === Beat B — 5 pasos === */
	.p3-subtitulo {
		margin: 0;
		font-family: var(--fuente-display);
		font-weight: 500;
