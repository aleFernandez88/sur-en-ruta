<script>
	// Click en una pastilla del Beat A: cambia DIRECTO a esa herramienta, sin pasar por las
	// intermedias. Como las láminas están atadas al scroll, se hace así: fundido a 0 de la escena →
	// salto instantáneo del scroll hasta la ENTRADA de la lámina elegida → fundido de vuelta, y desde
	// ahí un avance corto hasta su punto final (así se ven sus animaciones: río, sello, carteles).
	// Los % son del tramo pineado de la sección (el mismo de `animation-range: contain`).
	// Si el usuario mueve la rueda, toca la pantalla o usa el teclado, se cancela.
	const seccion = document.getElementById('como-lo-hace');
	const escenaA = document.querySelector<HTMLElement>('.p3-escena'); // láminas del Beat A
	const escenaB = document.querySelector<HTMLElement>('.p3-pasos'); // láminas del Beat B
	let cancelar: (() => void) | null = null;

	const posicion = (porcentaje: number) => {
		if (!seccion) return 0;
		const arriba = seccion.getBoundingClientRect().top + window.scrollY;
		const tramo = seccion.offsetHeight - window.innerHeight;
		return arriba + (tramo * porcentaje) / 100;
	};
	const saltar = (y: number) => window.scrollTo({ top: y, behavior: 'instant' });

	function cambiarA(escena: HTMLElement | null, inicio: number, destino: number, reducido: boolean) {
		cancelar?.();
		if (!escena || reducido) {
			saltar(posicion(destino));
			return;
		}
		let id = 0;
		let espera = 0;
		const parar = () => {
			clearTimeout(espera);
			cancelAnimationFrame(id);
			escena.style.opacity = '';
			cancelar = null;
			['wheel', 'touchstart', 'keydown'].forEach((e) => window.removeEventListener(e, parar));
		};
		cancelar = parar;
		['wheel', 'touchstart', 'keydown'].forEach((e) => window.addEventListener(e, parar, { passive: true }));

		escena.style.opacity = '0'; // 1) se desvanece la lámina actual
		espera = window.setTimeout(() => {
			saltar(posicion(inicio)); // 2) salto directo a la entrada de la elegida (nadie lo ve)
			id = requestAnimationFrame(() => {
				escena.style.opacity = ''; // 3) aparece la elegida…
				const origen = posicion(inicio);
				const delta = posicion(destino) - origen;
				const duracion = 900;
				const t0 = performance.now();
				const paso = (ahora: number) => {
					const t = Math.min(1, (ahora - t0) / duracion);
					saltar(origen + delta * (1 - Math.pow(1 - t, 3))); // …y avanza hasta su punto final
					if (t < 1) id = requestAnimationFrame(paso);
					else parar();
				};
				id = requestAnimationFrame(paso);
			});
		}, 170);
	}

	// Nodos 01-05 del Beat B: el paso se ve completo y quieto en su centro, así que entrada = llegada.
	document.querySelectorAll<HTMLButtonElement>('.p3-nodo').forEach((nodo) => {
		nodo.addEventListener('click', () => {
			const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const centro = Number(nodo.dataset.centro);
			cambiarA(escenaB, centro, centro, reducido);
		});
	});

	document.querySelectorAll<HTMLButtonElement>('.p3-chip').forEach((chip) => {
		chip.addEventListener('click', () => {
			const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			cambiarA(escenaA, Number(chip.dataset.inicio), Number(chip.dataset.destino), reducido);
		});
	});
</script>
