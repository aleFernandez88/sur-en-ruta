---
/**
 * P3ComoLoHace.astro — P3 · ¿Cómo lo hace? (`como-lo-hace`), 3ª de las 5 secciones del escenario
 * vertical. Reescrita sobre `<Seccion>` en Bloque E, E9
 * (docs/planes/2026-09-23-bloque-e-secciones-chrome.md §5). Copy literal de
 * `docs/landing-contenido.md` § P3 (deck `pag-07-herramientas.png` + `pag-04-como-funciona.png`).
 *
 * === Dos beats superpuestos en la misma caja ===
 * Beat A (`contain 0% → 35%`, herramientas) y Beat B (`contain 32% → 100%`, los 5 pasos) ocupan el
 * MISMO `grid-area: 1/1` — se cruzan (Beat A sale con fade+translate entre 30%-38% mientras Beat B
 * ya está ahí), igual patrón de superposición que usa P4 para sus 6 rutas.
 *
 * === Contenido a la derecha (celular en x −25%) ===
 * `margin-left: 40vw` en desktop dentro de `.seccion__caja` — el celular de esta sección queda
 * centro-izquierda (`escenario.ts`, `TELEFONO['como-lo-hace'].escritorio.x = -25`). En mobile el
 * contenido va arriba, sin margen.
 *
 * === Numerales 01-05 ===
 * Antes vivían en nodos SEPARADOS sobre una ruta ondulada SVG (posicionados en `left:%`,
 * sincronizados a mano con la tarjeta de abajo). Ahora cada numeral es HIJO de su propia tarjeta:
 * "viajan con la fila", no se animan aparte (E9 del plan). Se borra la ruta ondulada SVG y sus
 * nodos con *pop*.
 *
 * === Qué se borra respecto de la versión "cinta" ===
 * `<Pantalla>`/`<Lamina>` (y su cuña diagonal — D-F: en la Opción 3 solo se rescata la onda, banda
 * de E12), la ruta ondulada SVG, los nodos con *pop* sueltos, los imports de `cinta.ts` y todo
 * `--hz-progreso`.
 */
import Seccion from '../Seccion.astro';
import Icono from '../Icono.astro';
import { herramientas } from '../../data/herramientas.ts';
import { pasos } from '../../data/pasos.ts';

// Rango contain-relativo de un elemento escalonado — mismo criterio que `escalonado()` de
// escenario.ts, pero expresado como "contain X% contain Y%" (relativo al tramo pineado de ESTA
// sección, restricción 4: animation-range nunca con var(), literal calculado acá).
const rangoEscalonadoContain = (inicio: number, i: number, paso: number, duracion: number): string =>
	`contain ${inicio + i * paso}% contain ${inicio + i * paso + duracion}%`;

const RANGO_HERRAMIENTA = (i: number) => rangoEscalonadoContain(2, i, 4, 8);
---

<Seccion id="como-lo-hace">
	<div class="p3 seccion__caja">
		<div class="p3-caja">
			<!-- Beat A — 4 herramientas -->
			<div class="p3-beat-a">
				<h2 class="p3-titular">Herramientas que conectan la experiencia</h2>
				<p class="p3-idea">Con herramientas que trabajan juntas.</p>
				<div class="p3-herramientas">
					{
						herramientas.map((h, i) => (
							<div class="p3-herramienta" style={`animation-range: ${RANGO_HERRAMIENTA(i)}`}>
								<span class="p3-herramienta-icono">
									<Icono nombre={h.icono} tamano={28} acento="var(--color-verde)" />
								</span>
								<div class="p3-herramienta-texto">
									<p class="p3-herramienta-nombre">{h.nombre}</p>
									<p class="p3-herramienta-que">{h.que}</p>
								</div>
							</div>
						))
					}
				</div>
				<p class="p3-beat-a-cierre">Tecnología, comunidad y comunicación al servicio del viaje.</p>
			</div>

			<!-- Beat B — 5 pasos -->
			<div class="p3-beat-b">
				<p class="p3-subtitulo">Una experiencia simple, organizada y conectada.</p>
				<div class="p3-carril">
					<div class="p3-carril-fila">
						{
							pasos.map((p, k) => (
								<div class="p3-paso">
									<span class="p3-paso-numeral" aria-hidden="true">
										{String(k + 1).padStart(2, '0')}
									</span>
									<span class="p3-paso-icono">
										<Icono nombre={p.icono} tamano={34} acento="var(--color-verde)" />
									</span>
									<h3 class="p3-paso-titulo">{p.titulo}</h3>
									<p class="p3-paso-frase">{p.frase}</p>
								</div>
							))
						}
					</div>
				</div>
				<p class="p3-beat-b-cierre">
					Una red que <strong>organiza el viaje</strong> y <strong>potencia los destinos</strong>.
				</p>
			</div>
		</div>
	</div>
</Seccion>

<style>
	.p3 {
		align-content: center;
	}

	.p3-caja {
		display: grid;
		margin-left: 40vw;
	}

	@media (width < 900px) {
		.p3 {
			align-content: start;
		}
		.p3-caja {
			margin-left: 0;
		}
	}

	.p3-beat-a,
	.p3-beat-b {
		grid-area: 1 / 1;
		display: flex;
		flex-direction: column;
		gap: var(--espacio-sm);
	}

	/* === Beat A — 4 herramientas === */
	.p3-titular {
		margin: 0;
		font-family: var(--fuente-display);
		font-weight: 800;
		font-size: clamp(2rem, 1.2rem + 3vw, 4rem);
		line-height: 1.05;
		max-width: 22ch;
		color: var(--color-texto-sobre-foto);
	}

	.p3-idea {
		margin: 0;
		font-family: var(--fuente-texto);
		font-weight: 600;
		font-size: var(--texto-base);
		color: var(--color-verde-vivo);
	}

	.p3-herramientas {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(0.75rem, 1.6vw, 1.25rem);
		perspective: 900px;
	}

	@media (width < 900px) {
		.p3-herramientas {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.p3-herramienta {
		display: flex;
		align-items: center;
		gap: var(--espacio-xs);
		padding: clamp(0.7rem, 1.6vh, 1rem) clamp(0.85rem, 1.8vw, 1.25rem);
		background: var(--color-superficie);
		border-radius: var(--radio-md);
		box-shadow: 0 10px 22px -14px rgba(15, 43, 77, 0.28);
		transform-origin: top center;
	}

	.p3-herramienta-icono {
		flex-shrink: 0;
		display: grid;
		place-items: center;
		width: 2.6rem;
		height: 2.6rem;
		border-radius: 50%;
		background: color-mix(in srgb, var(--color-verde) 12%, var(--color-superficie));
		color: var(--color-marino);
	}

	.p3-herramienta-nombre {
		margin: 0;
		font-family: var(--fuente-fina);
		font-weight: 500;
		font-size: clamp(0.85rem, 0.78rem + 0.35vw, 1rem);
		line-height: 1.2;
		color: var(--color-marino);
	}

	.p3-herramienta-que {
		margin: 0.15rem 0 0;
		font-family: var(--fuente-texto);
		font-weight: 400;
		font-size: clamp(0.7rem, 0.66rem + 0.2vw, 0.8rem);
		line-height: 1.25;
		color: var(--color-tinta-suave);
	}

	.p3-beat-a-cierre {
		margin: 0;
		font-family: var(--fuente-texto);
		font-size: var(--texto-sm);
		color: color-mix(in srgb, var(--color-texto-sobre-foto) 80%, transparent);
	}

	/* === Mobile: Beat A más compacto — AJUSTE DEL EJECUTOR sobre el plan (E9), con evidencia:
	 * en 390×844/369×698 el cierre del beat A quedaba superpuesto con `.telefono__marco`
	 * (confirmado con elementFromPoint, overlap real, ~30-40px). Gaps y paddings más chicos,
	 * ningún texto se saca. */
	@media (width < 900px) {
		.p3-beat-a,
		.p3-beat-b {
			gap: 0.6rem;
		}
		.p3-titular {
			font-size: clamp(1.6rem, 1.1rem + 2.5vw, 2.5rem);
		}
		.p3-herramientas {
			gap: 0.55rem;
		}
		.p3-herramienta {
			padding: 0.5rem 0.75rem;
		}
		.p3-herramienta-icono {
			width: 2.15rem;
			height: 2.15rem;
		}
	}

	@keyframes p3-herramienta-despliega {
		from {
			opacity: 0;
			transform: rotateX(-78deg);
		}
		to {
			opacity: 1;
			transform: rotateX(0deg);
		}
	}

	@keyframes p3-beat-b-entra {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@keyframes p3-beat-a-sale {
		from {
			opacity: 1;
			transform: translateY(0);
		}
		to {
			opacity: 0;
			transform: translateY(-3rem);
		}
	}

	@supports (animation-timeline: scroll(root)) {
		.p3-herramienta {
			opacity: 0;
			transform: rotateX(-78deg);
			animation: p3-herramienta-despliega linear both;
			animation-timeline: --como-lo-hace;
		}
		.p3-beat-a {
			animation: p3-beat-a-sale linear both;
			animation-timeline: --como-lo-hace;
			animation-range: contain 30% contain 38%;
		}
		/* HALLAZGO DEL EJECUTOR, corregido acá: Beat B (el carril + subtítulo) nunca tenía entrada
		 * propia — solo la FILA del carril se animaba (traslado horizontal), no el beat en sí. Con
		 * `animation-range` en `both`, antes de `contain 40%` el carril está en su estado "from"
		 * (`translateX(0)`), que dentro de la ventana `56vw` recortada YA muestra los primeros 2
		 * pasos — visibles simultáneo con Beat A (que recién sale en 30-38%), un solapamiento real
		 * confirmado con capturas (no lo detecta C2: ese chequeo solo mide contra el celular/banda,
		 * no entre bloques de contenido de la misma pantalla). Mismo rango que la salida de A, para
		 * que el cruce se lea como una transición, no un salto. */
		.p3-beat-b {
			opacity: 0;
			animation: p3-beat-b-entra linear both;
			animation-timeline: --como-lo-hace;
			animation-range: contain 30% contain 38%;
		}
	}

	/* === Movimiento reducido — DECISIÓN DEL EJECUTOR, marcada para revisión de Ale/arquitecto ===
	 * La superposición `grid-area: 1/1` de los 2 beats es NUEVA de este bloque. Primer intento
	 * (envolver el carril con `flex-wrap` y mostrar los 2 beats a la vez): descartado con
	 * evidencia — `.seccion__pin` tiene `overflow: clip` y alto fijo `100svh` (base.css), así que
	 * "mostrar todo sin recortar" en realidad NO mostraba todo: lo que no entraba en 100svh se
	 * recortaba igual, y encima los 2 beats quedaban superpuestos entre sí. Verificado con el
	 * verificador: 8 FAIL nuevos en vez de 0. Se vuelve al criterio literal de escenario.ts
	 * ("estado final" = el de Beat B, el último de los dos) — Beat A se saca del todo
	 * (`display:none`, no solo opacidad: con opacidad sola seguiría siendo "hit-testable" y
	 * contando como candidato de solapamiento) y el carril de Beat B queda en su posición FINAL
	 * (recortada, como siempre) en vez de a mitad de camino. */
	@media (prefers-reduced-motion: reduce) {
		.p3-herramienta {
			animation: none !important;
			opacity: 1;
			transform: none;
		}
		.p3-beat-a {
			display: none;
		}
		.p3-beat-b {
			animation: none !important;
			opacity: 1;
		}
		.p3-carril-fila {
			animation: none !important;
			transform: translateX(-70vw);
		}
	}

	@media (prefers-reduced-motion: reduce) and (width < 900px) {
		.p3-carril-fila {
			transform: translateX(-308vw);
		}
	}

	/* === Beat B — 5 pasos === */
	.p3-subtitulo {
		margin: 0;
		font-family: var(--fuente-display);
		font-weight: 500;
		font-size: clamp(1.15rem, 1rem + 0.6vw, 1.5rem);
		color: var(--color-texto-sobre-foto);
	}

	.p3-carril {
		overflow: clip;
		width: 56vw;
	}

	@media (width < 900px) {
		.p3-carril {
			width: 88vw;
		}
	}

	.p3-carril-fila {
		display: flex;
		gap: 2vw;
	}

	@media (width < 900px) {
		.p3-carril-fila {
			gap: 4vw;
		}
	}

	.p3-paso {
		flex: 0 0 24vw;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: clamp(0.4rem, 1.2vh, 0.65rem);
		padding: clamp(1rem, 2.2vw, 1.6rem) clamp(0.85rem, 1.8vw, 1.25rem);
		background: var(--color-superficie);
		border-radius: clamp(0.9rem, 1.8vw, 1.5rem);
		box-shadow: 0 14px 28px -16px rgba(15, 43, 77, 0.22);
		text-align: center;
	}

	@media (width < 900px) {
		.p3-paso {
			flex-basis: 76vw;
		}
	}

	.p3-paso-numeral {
		font-family: var(--fuente-display);
		font-weight: 800;
		font-size: clamp(2.5rem, 2rem + 2vw, 4rem);
		line-height: 1;
		-webkit-text-stroke: 1.5px var(--color-arena);
		color: transparent;
	}

	.p3-paso-icono {
		color: var(--color-marino);
	}

	.p3-paso-titulo {
		margin: 0;
		font-family: var(--fuente-texto);
		font-weight: 700;
		font-size: clamp(0.95rem, 0.85rem + 0.4vw, 1.15rem);
		line-height: 1.25;
		color: var(--color-marino);
	}

	.p3-paso-frase {
		margin: 0;
		font-family: var(--fuente-texto);
		font-weight: 400;
		font-size: clamp(0.8rem, 0.75rem + 0.2vw, 0.9rem);
		line-height: 1.35;
		color: var(--color-tinta-suave);
	}

	.p3-beat-b-cierre {
		margin: 0;
		font-family: var(--fuente-texto);
		font-size: clamp(1.05rem, 0.9rem + 0.5vw, 1.25rem);
		line-height: 1.35;
		max-width: 42ch;
		color: var(--color-texto-sobre-foto);
	}

	.p3-beat-b-cierre strong {
		color: var(--color-verde-vivo);
	}

	@keyframes p3-carril-escritorio {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-70vw);
		}
	}

	@keyframes p3-carril-movil {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-308vw);
		}
	}

	@keyframes p3-beat-b-cierre-entra {
		from {
			opacity: 0;
			transform: translateY(1rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@supports (animation-timeline: scroll(root)) {
		.p3-carril-fila {
			animation: p3-carril-escritorio linear both;
			animation-timeline: --como-lo-hace;
			animation-range: contain 40% contain 95%;
		}

		@media (width < 900px) {
			.p3-carril-fila {
				animation-name: p3-carril-movil;
			}
		}

		.p3-beat-b-cierre {
			opacity: 0;
			transform: translateY(1rem);
			animation: p3-beat-b-cierre-entra linear both;
			animation-timeline: --como-lo-hace;
			animation-range: contain 92% contain 100%;
		}
	}

	/* .p3-carril-fila NO se pisa acá (ver el bloque de arriba: queda en su posición final
	 * trasladada, no en `transform:none` — ese sería el punto de PARTIDA, no el final). */
	@media (prefers-reduced-motion: reduce) {
		.p3-carril-fila {
			animation: none !important;
		}
		.p3-beat-b-cierre {
			animation: none !important;
			opacity: 1;
			transform: none;
		}
	}
</style>
