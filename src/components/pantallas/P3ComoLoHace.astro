	@keyframes p3-carril-escritorio {
		from {
			transform: translateX(0);
		}
		to {
			/* AJUSTE DEL EJECUTOR (E13): -70vw → -80vw, espejo del cambio de `.p3-carril` de 56vw a
			 * 46vw. Fila de 5 tarjetas de 24vw + 4 huecos de 2vw = 128vw; ventana de 46vw; recorrido
			 * hasta el borde = 128-46 = 82vw, menos 2vw (mismo margen que dejaba el valor viejo:
			 * 128-56=72 contra el -70 real) = 80vw. */
			transform: translateX(-80vw);
		}
	}

	@keyframes p3-carril-movil {
		from {
			transform: translateX(0);
		}
		to {
			/* AJUSTE DEL EJECUTOR (E13): -308vw → -328vw, espejo del cambio de `.p3-carril` mobile de
			 * 88vw a 68vw. Fila de 5 tarjetas de 76vw + 4 huecos de 4vw = 396vw; ventana de 68vw;
			 * recorrido exacto hasta el borde = 396-68 = 328vw (mismo criterio "exacto, sin margen"
			 * que ya usaba el valor viejo: 396-88=308). */
			transform: translateX(-328vw);
		}
	}

	@keyframes p3-beat-b-cierre-entra {
		from {
			opacity: 0;
			transform: translateY(1rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@supports (animation-timeline: scroll(root)) {
		.p3-carril-fila {
			animation: p3-carril-escritorio linear both;
			animation-timeline: --como-lo-hace;
			animation-range: contain 54% contain 96%;
		}

		@media (width < 900px) {
			.p3-carril-fila {
				animation-name: p3-carril-movil;
			}
		}

		.p3-beat-b-cierre {
			opacity: 0;
			transform: translateY(1rem);
			animation: p3-beat-b-cierre-entra linear both;
			animation-timeline: --como-lo-hace;
			animation-range: contain 94% contain 100%;
		}
	}

	/* .p3-carril-fila NO se pisa acá (ver el bloque de arriba: queda en su posición final
	 * trasladada, no en `transform:none` — ese sería el punto de PARTIDA, no el final). */
	@media (prefers-reduced-motion: reduce) {
		.p3-carril-fila {
			animation: none !important;
		}
		.p3-beat-b-cierre {
			animation: none !important;
			opacity: 1;
			transform: none;
		}
	}

	/* Va al FINAL de la hoja a propósito: pisa reglas base del mismo peso que están más arriba. */
	/* Sin animation-timeline (Firefox estable): los dos beats se apilan en flujo en vez de
	 * superponerse en la misma celda — nada los alterna, así que se leen uno tras otro. */
	@supports not (animation-timeline: scroll(root)) {
		.p3-beat-a,
		.p3-beat-b {
			grid-area: auto;
		}
		/* Las 4 láminas se apilan en flujo (todas visibles, sin indicador de progreso). */
		.p3-escena {
			gap: var(--espacio-md);
		}
		.p3-slide {
			grid-area: auto;
		}
		.p3-chips {
			display: none;
		}
		.p3-caja {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--espacio-lg);
			margin-left: 0; /* el celular no se dibuja en este modo: no hay nada que esquivar */
		}
		/* Los 5 pasos eran un carril horizontal que se desplazaba con el scroll; sin eso, se
		 * acomodan en filas y se ven todos. */
		.p3-carril {
			width: auto;
			overflow: visible;
		}
		.p3-carril-fila {
			flex-wrap: wrap;
			gap: var(--espacio-sm);
		}
		.p3-paso {
			flex: 1 1 12rem;
		}
	}
</style>

<script>
	// Click en una pastilla del Beat A: cambia DIRECTO a esa herramienta, sin pasar por las
	// intermedias. Como las láminas están atadas al scroll, se hace así: fundido a 0 de la escena →
	// salto instantáneo del scroll hasta la ENTRADA de la lámina elegida → fundido de vuelta, y desde
	// ahí un avance corto hasta su punto final (así se ven sus animaciones: río, sello, carteles).
	// Los % son del tramo pineado de la sección (el mismo de `animation-range: contain`).
	// Si el usuario mueve la rueda, toca la pantalla o usa el teclado, se cancela.
	const seccion = document.getElementById('como-lo-hace');
	const escena = document.querySelector<HTMLElement>('.p3-escena');
	let cancelar: (() => void) | null = null;

	const posicion = (porcentaje: number) => {
		if (!seccion) return 0;
		const arriba = seccion.getBoundingClientRect().top + window.scrollY;
		const tramo = seccion.offsetHeight - window.innerHeight;
		return arriba + (tramo * porcentaje) / 100;
	};
	const saltar = (y: number) => window.scrollTo({ top: y, behavior: 'instant' });

	function cambiarA(inicio: number, destino: number, reducido: boolean) {
		cancelar?.();
		if (!escena || reducido) {
			saltar(posicion(destino));
			return;
		}
		let id = 0;
		let espera = 0;
		const parar = () => {
			clearTimeout(espera);
			cancelAnimationFrame(id);
			escena.style.opacity = '';
			cancelar = null;
			['wheel', 'touchstart', 'keydown'].forEach((e) => window.removeEventListener(e, parar));
		};
		cancelar = parar;
		['wheel', 'touchstart', 'keydown'].forEach((e) => window.addEventListener(e, parar, { passive: true }));

		escena.style.opacity = '0'; // 1) se desvanece la lámina actual
		espera = window.setTimeout(() => {
			saltar(posicion(inicio)); // 2) salto directo a la entrada de la elegida (nadie lo ve)
			id = requestAnimationFrame(() => {
				escena.style.opacity = ''; // 3) aparece la elegida…
				const origen = posicion(inicio);
				const delta = posicion(destino) - origen;
				const duracion = 900;
				const t0 = performance.now();
				const paso = (ahora: number) => {
					const t = Math.min(1, (ahora - t0) / duracion);
					saltar(origen + delta * (1 - Math.pow(1 - t, 3))); // …y avanza hasta su punto final
					if (t < 1) id = requestAnimationFrame(paso);
					else parar();
				};
				id = requestAnimationFrame(paso);
			});
		}, 170);
	}

	document.querySelectorAll<HTMLButtonElement>('.p3-chip').forEach((chip) => {
		chip.addEventListener('click', () => {
			const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			cambiarA(Number(chip.dataset.inicio), Number(chip.dataset.destino), reducido);
		});
	});
</script>
