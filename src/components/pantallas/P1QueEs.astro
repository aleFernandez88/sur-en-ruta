---
/**
 * P1QueEs.astro — P1 · ¿Qué es Sur en Ruta? (`que-es`), primera de las 5 secciones del escenario
 * vertical. Reescrita sobre `<Seccion>` en Bloque E, E7
 * (docs/planes/2026-09-23-bloque-e-secciones-chrome.md §5). Copy literal de
 * `docs/landing-contenido.md` § P1.
 *
 * === Qué se borra respecto de la versión "cinta" ===
 * el shell `Pantalla` (reemplazado por `<Seccion id="que-es">`), `.p1-escena` (el celular ya vive en
 * `Escenario.astro`, chrome fijo para las 5 secciones — E4), `.p1-rotulo` (el rótulo "Vista
 * conceptual de la app" es chrome permanente desde E4, mismo string, no se pierde contenido), el
 * fondo de `.p1` (lo pinta `.escenario`, con el mismo glow radial, mudado a `Escenario.astro` en
 * E4) y las dos animaciones atadas al progreso horizontal de la cinta (esa línea de tiempo ya no existe).
 *
 * === Qué se conserva literal ===
 * La entrada TEMPORAL de los 4 textos (titular, respuesta, bajada, marca), disparada por
 * `:root.entrada` — sin Hero de apertura (CLAUDE.md §1: "mostrar rápido para retener"), P1 está en
 * pantalla apenas carga la página, así que ningún `animation-range` puede animar su entrada. Mismos
 * delays (120/300/460/610ms) que ya estaban aprobados.
 *
 * === Qué cambia ===
 * La permanencia scroll-driven (antes tramo `0%→8%` del progreso horizontal de la cinta, el velo se afloja + el
 * texto se corre) pasa a `animation-timeline: --que-es` con `animation-range: contain 0% contain
 * 100%` (literal, E7 del plan) — el tramo pineado completo de esta sección en vez de un % fijo del
 * scroll del documento entero.
 */
import Seccion from '../Seccion.astro';
import Icono from '../Icono.astro';
import logoSvg from '../../assets/logo/isotipo-bandera.svg?raw';

/**
 * Isotipo en línea para animar cada pieza por separado: cada <path> entra desde un lugar distinto
 * (dx/dy en unidades del viewBox, rot en grados, d = retardo en ms) y se arma en su sitio. Los
 * índices son el orden de los 19 paths del SVG (0 carrocería, 1-3/13/16 detalles del motorhome, 4 y
 * 6 ruta, 5/7/9 colina y pasto, 8/14 sol, 10 pin, 11/12 ruedas, 15/17/18 pájaros).
 */
const PIEZAS: Record<number, [number, number, number, number, string?]> = {
	5: [-1500, 300, 0, 0],
	7: [1500, -300, 0, 90],
	4: [-1400, -200, 0, 160],
	6: [1500, 100, 0, 240],
	9: [-1800, 700, 0, 330],
	8: [0, -1300, 0, 420],
	14: [0, -1300, 0, 440],
	0: [1600, 300, 0, 520],
	1: [1500, 200, 0, 640],
	2: [1500, 200, 0, 660],
	3: [1500, 200, 0, 680],
	13: [0, 900, 0, 700],
	16: [0, 900, 0, 720],
	11: [-500, 900, -540, 820],
	12: [500, 900, 540, 860],
	10: [0, -1500, 0, 1000, 'pin'],
	15: [1200, -800, 0, 1120],
	17: [1200, -800, 0, 1140],
	18: [1200, -800, 0, 1160],
};
let n = -1;
const interior = (logoSvg.match(/<svg[^>]*>([\s\S]*)<\/svg>/) ?? [])[1] ?? '';
const isotipoPiezas = interior.replace(/<path /g, () => {
	n += 1;
	const [dx, dy, rot, d, tipo] = PIEZAS[n] ?? [0, 0, 0, 0];
	return `<path class="p1-pieza${tipo ? ' p1-pieza--' + tipo : ''}" style="--dx:${dx};--dy:${dy};--rot:${rot};--d:${d}ms" `;
});
---

<Seccion id="que-es">
	<div class="p1 seccion__caja">
		<div class="p1-velo"></div>

		<div class="p1-texto">
			<div class="p1-texto__cuerpo">
				<div class="p1-titular-caja">
					<h1 class="p1-titular">
						<span class="p1-linea"><span class="marca">Sur en Ruta</span></span>
					</h1>
				</div>
				<p class="p1-respuesta">
					Una forma nueva de recorrer <span class="realce p1-realce--grande">Uruguay</span>: <strong>por etapas, conectada, a tu ritmo.</strong>
				</p>
				<p class="p1-bajada">
					<span class="realce">La app</span> y la red que conecta a quien viaja con los puntos, servicios y rutas del país.
				</p>
				<div class="p1-promesa">
					<div class="p1-promesa__logo">
						<svg class="p1-isotipo" viewBox="0 0 1830 1670" aria-hidden="true" set:html={isotipoPiezas} />
					</div>
					<div class="p1-promesa__texto">
						<p class="p1-marca">Explorá. Conectá. Viví.</p>
						<ul class="p1-iconos" aria-hidden="true">
							<li><Icono nombre="ubicacion" tamano={26} /></li>
							<li><Icono nombre="comunidad" tamano={26} /></li>
							<li><Icono nombre="experiencias" tamano={26} /></li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</div>
</Seccion>

<style>
	/* Sin `position: relative`: pisaba el `position: absolute; inset: 0` de `.seccion__caja` y la caja
	 * medía solo su contenido (≈570px) en vez de toda la sección — el texto quedaba pegado arriba y
	 * el velo cortaba el fondo con una costura. Con la caja completa, `align-content: center` centra
	 * el texto a la altura del celular. */
	.p1 {
		align-content: center;
	}

	/* Marco de composición: en pantallas más anchas que `--marco-max` el padding lateral crece para
	 * que el texto quede encuadrado en el mismo ancho que a 1440 (ver tokens.css). A ≤1440 los dos
	 * términos de max() dan 4vw → no cambia nada. Mismo padding vertical que `.seccion__caja`. */
	@media (width >= 900px) {
		.p1 {
			padding-inline: max(
				clamp(1.25rem, 4vw, 4rem),
				calc((100% - var(--marco-max)) / 2 + clamp(1.25rem, 4vw, 4rem))
			);
		}
	}

	/* Mobile: texto arriba y centrado (§4.3 — el celular asoma abajo, y aunque acá no se ve el
	 * `.seccion__caja` compartido define el padding, ver base.css). */
	@media (width < 900px) {
		.p1 {
			align-content: start;
		}
	}

	/* === Velo de contraste (scrim direccional, nunca parejo: taparía el escenario de fondo) ===
	 * Mínimo, red de seguridad de contraste sobre la parte más clara del glow (#163a5c, 11,8:1) —
	 * no una necesidad, el fondo real ya da contraste de sobra (ver Escenario.astro). */
	.p1-velo {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background: linear-gradient(
			100deg,
			color-mix(in srgb, var(--color-marino-noche) 38%, transparent) 0%,
			color-mix(in srgb, var(--color-marino-noche) 22%, transparent) 34%,
			transparent 58%
		);
	}

	@media (width < 900px) {
		.p1-velo {
			background: linear-gradient(
				180deg,
				color-mix(in srgb, var(--color-marino-noche) 42%, transparent) 0%,
				color-mix(in srgb, var(--color-marino-noche) 24%, transparent) 36%,
				transparent 56%
			);
		}
	}

	/* === Texto ===
	 * Dos elementos: .p1-texto (posicionamiento, sin animación) y .p1-texto__cuerpo (la columna
	 * real, que SÍ anima `transform` en la permanencia scroll-driven) — separados para que el
	 * centrado de .seccion__caja y el corrimiento por scroll no compitan por la misma propiedad. */
	.p1-texto {
		position: relative;
		z-index: 1;
		max-width: min(38rem, 46vw);
	}

	.p1-texto__cuerpo {
		display: flex;
		flex-direction: column;
		gap: var(--espacio-sm);
		text-shadow: 0 1px 16px color-mix(in srgb, var(--color-marino-noche) 70%, transparent);
	}

	@media (width < 900px) {
		.p1-texto {
			max-width: none;
			text-align: center;
			justify-self: center;
		}
		.p1-texto__cuerpo {
			align-items: center;
			/* AJUSTE DEL EJECUTOR sobre el plan (E7), con evidencia: en 369×698 la bajada quedaba
			 * ~24px superpuesta con `.telefono__marco` (confirmado con elementFromPoint, overlap
			 * real). Gap más chico en mobile para ganar el margen que hace falta. */
			gap: 0.65rem;
		}
	}

	/* Titular en dos líneas: "¿Qué es" chico (Archivo 800) y el nombre de la marca grande, SIEMPRE en
	 * una sola línea (`nowrap`). El tamaño del titular es el del nombre; la pregunta y los signos
	 * son .52em de eso. */
	.p1-titular {
		margin: 0;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		/* `max-content`: el nombre (nowrap) puede ser más ancho que `.p1-texto` (34rem) y el recorte de la
		 * entrada (clip-path sobre este h1) se comía el "?" que sobresalía. */
		width: max-content;
		gap: 0.12em;
		font-family: var(--fuente-display);
		font-weight: 800;
		font-size: clamp(2.8rem, 0.9rem + 5vw, 5.4rem);
		line-height: 1.05;
		color: var(--color-texto-sobre-foto);
	}

	.p1-pregunta {
		font-size: 0.52em;
		line-height: 1;
	}

	.p1-linea {
		white-space: nowrap;
		display: flex;
		align-items: baseline;
		gap: 0.08em;
	}

	@media (width < 900px) {
		.p1-titular {
			align-items: center;
			/* El nombre mide ≈7,4em: a 11,5vw entra en 390px con aire (≈332px de 390). */
			font-size: min(12vw, 3.5rem);
		}
	}

	/* Isotipo dentro de la promesa: a la izquierda del texto, en la misma línea (desktop). Colores
	 * sólidos de la variante «Bandera». En mobile no se muestra (el celular ocupa ese lugar). */
	.p1-promesa__logo {
		display: none;
	}

	@media (width >= 900px) {
		.p1-promesa__logo {
			display: flex;
			align-items: center;
		}
		.p1-isotipo {
			display: block;
			width: clamp(6rem, 8.5vw, 8rem);
			height: auto;
			pointer-events: none;
		}
	}

	.p1-titular {
		position: relative;
		z-index: 1;
	}

	/* Entrada del isotipo: cada pieza llega desde un lado distinto y se arma en su lugar (transición,
	 * no @keyframes: así `calc()` con `var()` funciona en Chrome). Arranca con :root.entrada, después
	 * de los textos. Sin JS o con movimiento reducido, el isotipo se ve armado. */
	.p1-isotipo :global(.p1-pieza) {
		transform-box: fill-box;
		transform-origin: center;
	}

	:global(:root.js:not(.entrada)) .p1-isotipo :global(.p1-pieza) {
		opacity: 0;
		transform: translate(calc(var(--dx) * 1px), calc(var(--dy) * 1px)) rotate(calc(var(--rot) * 1deg)) scale(0.5);
	}

	:global(:root.entrada) .p1-isotipo :global(.p1-pieza) {
		transition:
			transform 1100ms cubic-bezier(0.16, 1, 0.3, 1) calc(900ms + var(--d)),
			opacity 450ms ease-out calc(900ms + var(--d));
	}

	:global(:root.entrada) .p1-isotipo :global(.p1-pieza--pin) {
		transition:
			transform 900ms cubic-bezier(0.34, 1.56, 0.64, 1) calc(900ms + var(--d)),
			opacity 300ms ease-out calc(900ms + var(--d));
	}

	@media (prefers-reduced-motion: reduce) {
		:global(:root.js:not(.entrada)) .p1-isotipo :global(.p1-pieza) {
			opacity: 1;
			transform: none;
		}
		:global(:root.entrada) .p1-pieza,
		:global(:root.entrada) .p1-isotipo :global(.p1-pieza--pin) {
			transition: none;
		}
	}

	.p1-realce--grande {
		font-size: 1.14em;
	}

	.p1-respuesta {
		margin: 0;
		font-family: var(--fuente-display);
		font-weight: 200;
		font-size: clamp(1.35rem, 1.1rem + 1vw, 1.85rem);
		line-height: 1.3;
		color: color-mix(in srgb, var(--color-texto-sobre-foto) 92%, transparent);
	}

	@media (width < 900px) {
		.p1-respuesta {
			font-size: clamp(1.05rem, 0.95rem + 0.6vw, 1.35rem);
		}
	}

	.p1-respuesta strong {
		display: block;
		font-weight: 800;
		/* --color-verde (#5a6b2e) da 3,36:1 sobre #050b14 y falla AA para texto normal;
		 * --color-verde-vivo da 6,56:1 — existe en tokens.css exactamente para "acentos sobre
		 * fondo oscuro". */
		color: var(--color-verde-vivo);
	}

	.p1-bajada {
		margin: var(--espacio-xs) 0 0;
		font-family: var(--fuente-texto);
		font-weight: 400;
		font-size: var(--texto-lg);
		line-height: 1.45;
		max-width: 32ch;
		color: color-mix(in srgb, var(--color-texto-sobre-foto) 80%, transparent);
	}

	@media (width < 900px) {
		.p1-bajada {
			max-width: none;
			font-size: var(--texto-base);
		}
	}

	.p1-marca {
		margin: 0;
		font-family: var(--fuente-display);
		font-weight: 800;
		font-size: var(--texto-sm);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-celeste);
	}

	/* Promesa (frase + íconos): único bloque centrado, respecto del ancho de la columna de texto de la
	 * izquierda y con el mismo aire arriba y abajo. El resto del texto queda alineado a la izquierda. */
	.p1-promesa {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		gap: 1.5rem;
		margin-block: var(--espacio-md);
	}

	.p1-promesa__texto {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.9rem;
	}

	/* Íconos de la promesa (Explorá / Conectá / Viví), en el mismo orden que la frase. Decorativos. */
	.p1-iconos {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		gap: 0.85rem;
	}

	.p1-iconos li {
		display: grid;
		place-items: center;
		width: 3.25rem;
		height: 3.25rem;
		border-radius: 50%;
		color: var(--color-texto-sobre-foto);
		border: 1.5px solid var(--color-texto-sobre-foto);
		background: color-mix(in srgb, var(--color-marino-noche) 45%, transparent);
	}

	@media (width < 900px) {
		.p1-iconos {
			justify-content: center;
		}
	}

	/* ============================================================================
	 * Entrada TEMPORAL, disparada por :root.entrada — igual mecanismo que ya usaba Hero.astro y la
	 * versión "cinta" de esta pantalla. Delays y timings literales, sin cambios.
	 * ============================================================================ */

	@keyframes p1-texto-centro {
		from {
			clip-path: inset(0 50% 0 50%);
		}
		to {
			clip-path: inset(0 0 0 0);
		}
	}
	:global(:root.js) .p1-titular {
		clip-path: inset(0 50% 0 50%);
		animation: p1-texto-centro 720ms cubic-bezier(0.2, 0.7, 0.2, 1) 120ms both paused;
	}
	:global(:root.entrada) .p1-titular {
		animation-play-state: running;
	}

	@keyframes p1-texto-sube {
		from {
			opacity: 0;
			transform: translateY(0.9rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	:global(:root.js) .p1-respuesta {
		opacity: 0;
		transform: translateY(0.9rem);
		animation: p1-texto-sube 620ms cubic-bezier(0.2, 0.7, 0.2, 1) 300ms both paused;
	}
	:global(:root.entrada) .p1-respuesta {
		animation-play-state: running;
	}

	:global(:root.js) .p1-bajada,
	:global(:root.js) .p1-marca,
	:global(:root.js) .p1-iconos {
		opacity: 0;
		transform: translateY(0.9rem);
	}
	:global(:root.js) .p1-bajada {
		animation: p1-texto-sube 620ms cubic-bezier(0.2, 0.7, 0.2, 1) 460ms both paused;
	}
	:global(:root.js) .p1-marca {
		animation: p1-texto-sube 620ms cubic-bezier(0.2, 0.7, 0.2, 1) 610ms both paused;
	}
	:global(:root.js) .p1-iconos {
		animation: p1-texto-sube 620ms cubic-bezier(0.2, 0.7, 0.2, 1) 760ms both paused;
	}
	:global(:root.entrada) .p1-bajada,
	:global(:root.entrada) .p1-marca,
	:global(:root.entrada) .p1-iconos {
		animation-play-state: running;
	}

	@media (prefers-reduced-motion: reduce) {
		:global(:root.js) .p1-titular {
			animation: none !important;
			clip-path: none;
		}
		:global(:root.js) .p1-respuesta,
		:global(:root.js) .p1-bajada,
		:global(:root.js) .p1-marca,
		:global(:root.js) .p1-iconos {
			animation: none !important;
			opacity: 1;
			transform: none;
		}
	}

	/* ============================================================================
	 * Permanencia SCROLL-DRIVEN — nada de esto es una entrada: ocurre con P1 ya pineada, mientras
	 * el usuario la lee. Rango: TODO el tramo pineado de esta sección (E7 del plan).
	 * Default FUERA de @supports = estado FINAL/visible (restricción 1 de escenario.ts).
	 * ============================================================================ */

	.p1-velo {
		opacity: 1;
	}

	@supports (animation-timeline: scroll(root)) {
		@keyframes p1-velo-afloja {
			from {
				opacity: 1;
			}
			to {
				opacity: 0.7;
			}
		}
		.p1-velo {
			animation: p1-velo-afloja linear both;
			animation-timeline: --que-es;
			animation-range: contain 0% contain 100%;
		}

		@keyframes p1-texto-corre {
			from {
				transform: translateY(0);
			}
			to {
				transform: translateY(-0.9rem);
			}
		}
		.p1-texto__cuerpo {
			animation: p1-texto-corre linear both;
			animation-timeline: --que-es;
			animation-range: contain 0% contain 100%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.p1-velo {
			animation: none !important;
			opacity: 1;
		}
		.p1-texto__cuerpo {
			animation: none !important;
			transform: none;
		}
	}
</style>
