---
/**
 * P1QueEs.astro — P1 · ¿Qué es Sur en Ruta? (`que-es`), primera de las 5 secciones del escenario
 * vertical. Reescrita sobre `<Seccion>` en Bloque E, E7
 * (docs/planes/2026-09-23-bloque-e-secciones-chrome.md §5). Copy literal de
 * `docs/landing-contenido.md` § P1.
 *
 * === Qué se borra respecto de la versión "cinta" ===
 * el shell `Pantalla` (reemplazado por `<Seccion id="que-es">`), `.p1-escena` (el celular ya vive en
 * `Escenario.astro`, chrome fijo para las 5 secciones — E4), `.p1-rotulo` (el rótulo "Vista
 * conceptual de la app" es chrome permanente desde E4, mismo string, no se pierde contenido), el
 * fondo de `.p1` (lo pinta `.escenario`, con el mismo glow radial, mudado a `Escenario.astro` en
 * E4) y las dos animaciones atadas al progreso horizontal de la cinta (esa línea de tiempo ya no existe).
 *
 * === Qué se conserva literal ===
 * La entrada TEMPORAL de los 4 textos (titular, respuesta, bajada, marca), disparada por
 * `:root.entrada` — sin Hero de apertura (CLAUDE.md §1: "mostrar rápido para retener"), P1 está en
 * pantalla apenas carga la página, así que ningún `animation-range` puede animar su entrada. Mismos
 * delays (120/300/460/610ms) que ya estaban aprobados.
 *
 * === Qué cambia ===
 * La permanencia scroll-driven (antes tramo `0%→8%` del progreso horizontal de la cinta, el velo se afloja + el
 * texto se corre) pasa a `animation-timeline: --que-es` con `animation-range: contain 0% contain
 * 100%` (literal, E7 del plan) — el tramo pineado completo de esta sección en vez de un % fijo del
 * scroll del documento entero.
 */
import Seccion from '../Seccion.astro';
---

<Seccion id="que-es">
	<div class="p1 seccion__caja">
		<div class="p1-velo"></div>

		<div class="p1-texto">
			<div class="p1-texto__cuerpo">
				<h1 class="p1-titular">¿Qué es <span class="marca">Sur en Ruta</span>?</h1>
				<p class="p1-respuesta">
					Una forma nueva de recorrer Uruguay: <strong>por etapas, conectada, a tu ritmo.</strong>
				</p>
				<p class="p1-bajada">
					La app y la red que conecta a quien viaja con los puntos, servicios y rutas del país.
				</p>
				<p class="p1-marca">Explorá. Conectá. Viví.</p>
			</div>
		</div>
	</div>
</Seccion>

<style>
	.p1 {
		position: relative;
		align-content: center;
	}

	/* Mobile: texto arriba y centrado (§4.3 — el celular asoma abajo, y aunque acá no se ve el
	 * `.seccion__caja` compartido define el padding, ver base.css). */
	@media (width < 900px) {
		.p1 {
			align-content: start;
		}
	}

	/* === Velo de contraste (scrim direccional, nunca parejo: taparía el escenario de fondo) ===
	 * Mínimo, red de seguridad de contraste sobre la parte más clara del glow (#163a5c, 11,8:1) —
	 * no una necesidad, el fondo real ya da contraste de sobra (ver Escenario.astro). */
	.p1-velo {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background: linear-gradient(
			100deg,
			color-mix(in srgb, var(--color-marino-noche) 38%, transparent) 0%,
			color-mix(in srgb, var(--color-marino-noche) 22%, transparent) 34%,
			transparent 58%
		);
	}

	@media (width < 900px) {
		.p1-velo {
			background: linear-gradient(
				180deg,
				color-mix(in srgb, var(--color-marino-noche) 42%, transparent) 0%,
				color-mix(in srgb, var(--color-marino-noche) 24%, transparent) 36%,
				transparent 56%
			);
		}
	}

	/* === Texto ===
	 * Dos elementos: .p1-texto (posicionamiento, sin animación) y .p1-texto__cuerpo (la columna
	 * real, que SÍ anima `transform` en la permanencia scroll-driven) — separados para que el
	 * centrado de .seccion__caja y el corrimiento por scroll no compitan por la misma propiedad. */
	.p1-texto {
		position: relative;
		z-index: 1;
		max-width: min(34rem, 42vw);
	}

	.p1-texto__cuerpo {
		display: flex;
		flex-direction: column;
		gap: var(--espacio-sm);
		text-shadow: 0 1px 16px color-mix(in srgb, var(--color-marino-noche) 70%, transparent);
	}

	@media (width < 900px) {
		.p1-texto {
			max-width: none;
			text-align: center;
			justify-self: center;
		}
		.p1-texto__cuerpo {
			align-items: center;
			/* AJUSTE DEL EJECUTOR sobre el plan (E7), con evidencia: en 369×698 la bajada quedaba
			 * ~24px superpuesta con `.telefono__marco` (confirmado con elementFromPoint, overlap
			 * real). Gap más chico en mobile para ganar el margen que hace falta. */
			gap: 0.65rem;
		}
	}

	.p1-titular {
		margin: 0;
		font-family: var(--fuente-display);
		font-weight: 800;
		font-size: clamp(2.75rem, 1.4rem + 4.6vw, 6rem);
		line-height: 1.02;
		color: var(--color-texto-sobre-foto);
	}

	@media (width < 900px) {
		.p1-titular {
			font-size: clamp(2.1rem, 1.2rem + 4vw, 3.5rem);
		}
	}

	.p1-respuesta {
		margin: 0;
		font-family: var(--fuente-display);
		font-weight: 500;
		font-size: clamp(1.35rem, 1.1rem + 1vw, 1.85rem);
		line-height: 1.3;
		color: color-mix(in srgb, var(--color-texto-sobre-foto) 92%, transparent);
	}

	@media (width < 900px) {
		.p1-respuesta {
			font-size: clamp(1.05rem, 0.95rem + 0.6vw, 1.35rem);
		}
	}

	.p1-respuesta strong {
		font-weight: 700;
		/* --color-verde (#5a6b2e) da 3,36:1 sobre #050b14 y falla AA para texto normal;
		 * --color-verde-vivo da 6,56:1 — existe en tokens.css exactamente para "acentos sobre
		 * fondo oscuro". */
		color: var(--color-verde-vivo);
	}

	.p1-bajada {
		margin: var(--espacio-xs) 0 0;
		font-family: var(--fuente-texto);
		font-weight: 400;
		font-size: var(--texto-lg);
		line-height: 1.45;
		max-width: 32ch;
		color: color-mix(in srgb, var(--color-texto-sobre-foto) 80%, transparent);
	}

	@media (width < 900px) {
		.p1-bajada {
			max-width: none;
			font-size: var(--texto-base);
		}
	}

	.p1-marca {
		margin: var(--espacio-xs) 0 0;
		font-family: var(--fuente-display);
		font-weight: 800;
		font-size: var(--texto-sm);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-celeste);
	}

	/* ============================================================================
	 * Entrada TEMPORAL, disparada por :root.entrada — igual mecanismo que ya usaba Hero.astro y la
	 * versión "cinta" de esta pantalla. Delays y timings literales, sin cambios.
	 * ============================================================================ */

	@keyframes p1-texto-centro {
		from {
			clip-path: inset(0 50% 0 50%);
		}
		to {
			clip-path: inset(0 0 0 0);
		}
	}
	:global(:root.js) .p1-titular {
		clip-path: inset(0 50% 0 50%);
		animation: p1-texto-centro 720ms cubic-bezier(0.2, 0.7, 0.2, 1) 120ms both paused;
	}
	:global(:root.entrada) .p1-titular {
		animation-play-state: running;
	}

	@keyframes p1-texto-sube {
		from {
			opacity: 0;
			transform: translateY(0.9rem);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	:global(:root.js) .p1-respuesta {
		opacity: 0;
		transform: translateY(0.9rem);
		animation: p1-texto-sube 620ms cubic-bezier(0.2, 0.7, 0.2, 1) 300ms both paused;
	}
	:global(:root.entrada) .p1-respuesta {
		animation-play-state: running;
	}

	:global(:root.js) .p1-bajada,
	:global(:root.js) .p1-marca {
		opacity: 0;
		transform: translateY(0.9rem);
	}
	:global(:root.js) .p1-bajada {
		animation: p1-texto-sube 620ms cubic-bezier(0.2, 0.7, 0.2, 1) 460ms both paused;
	}
	:global(:root.js) .p1-marca {
		animation: p1-texto-sube 620ms cubic-bezier(0.2, 0.7, 0.2, 1) 610ms both paused;
	}
	:global(:root.entrada) .p1-bajada,
	:global(:root.entrada) .p1-marca {
		animation-play-state: running;
	}

	@media (prefers-reduced-motion: reduce) {
		:global(:root.js) .p1-titular {
			animation: none !important;
			clip-path: none;
		}
		:global(:root.js) .p1-respuesta,
		:global(:root.js) .p1-bajada,
		:global(:root.js) .p1-marca {
			animation: none !important;
			opacity: 1;
			transform: none;
		}
	}

	/* ============================================================================
	 * Permanencia SCROLL-DRIVEN — nada de esto es una entrada: ocurre con P1 ya pineada, mientras
	 * el usuario la lee. Rango: TODO el tramo pineado de esta sección (E7 del plan).
	 * Default FUERA de @supports = estado FINAL/visible (restricción 1 de escenario.ts).
	 * ============================================================================ */

	.p1-velo {
		opacity: 1;
	}

	@supports (animation-timeline: scroll(root)) {
		@keyframes p1-velo-afloja {
			from {
				opacity: 1;
			}
			to {
				opacity: 0.7;
			}
		}
		.p1-velo {
			animation: p1-velo-afloja linear both;
			animation-timeline: --que-es;
			animation-range: contain 0% contain 100%;
		}

		@keyframes p1-texto-corre {
			from {
				transform: translateY(0);
			}
			to {
				transform: translateY(-0.9rem);
			}
		}
		.p1-texto__cuerpo {
			animation: p1-texto-corre linear both;
			animation-timeline: --que-es;
			animation-range: contain 0% contain 100%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.p1-velo {
			animation: none !important;
			opacity: 1;
		}
		.p1-texto__cuerpo {
			animation: none !important;
			transform: none;
		}
	}
</style>
