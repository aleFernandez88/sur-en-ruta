---
/**
 * Inversion.astro — Sección 5. Etapa 1: validar el sistema en 90 días. Cierre y pedido.
 *
 * Copy real cargado el 2026-08-24. Etapas, rubros y equivalente en USD salen de
 * src/data/etapas.ts y src/data/inversion.ts, verificados contra el documento de propuesta
 * original (secc. 10, 11, 11.3, 11.4 y 11.5).
 *
 * REGLA DE MONEDA (ver CLAUDE.md): el monto y el equivalente se arman acá con el campo `moneda`
 * de inversion.ts — nunca se imprime un `$` sin la moneda al lado. No se hardcodea el símbolo
 * suelto en ningún lugar de este archivo.
 *
 * CartelSeccion (2026-08-24): mismo poste indicador que Hero, con el nombre "La Inversión" — ver
 * comentario de cabecera de src/components/CartelSeccion.astro para el porqué de la forma.
 */
import { etapas } from '../data/etapas';
import { rubrosInversion, totalEtapa1UYU, equivalenteUSDEtapa1 } from '../data/inversion';
import CartelSeccion from './CartelSeccion.astro';

const formatoUYU = new Intl.NumberFormat('es-UY');
const formatoPorcentaje = (valor: number) => valor.toLocaleString('es-UY', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const fechaEquivalente = new Date(`${equivalenteUSDEtapa1.fecha}T00:00:00`).toLocaleDateString('es-UY');

const rubroPrincipal = rubrosInversion[0];

const indicadoresCierre = [
	'Puntos adheridos.',
	'Viajeros y vehículos registrados.',
	'Consumo en comercios adheridos.',
	'Distribución por departamento.',
];
---

<section id="inversion" aria-labelledby="inversion-titulo">
	<CartelSeccion numero={5} nombre="La Inversión" />
	<h2 id="inversion-titulo">Etapa 1: validar el sistema en 90 días.</h2>

	<ol class="inversion-timeline">
		{etapas.map((etapa) => (
			<li class:list={['etapa', { destacada: etapa.orden === 1 }]}>
				<strong>{etapa.nombre}</strong>
				<span>{etapa.descripcion}</span>
			</li>
		))}
	</ol>

	<div class="inversion-reparto">
		<h3>El reparto de la Etapa 1</h3>
		<ul class="grafico-barras">
			{rubrosInversion.map((rubro) => (
				<li class="barra-rubro">
					<span class="barra-etiqueta">{rubro.rubro}</span>
					<span class="barra-visual" style={`--pct: ${rubro.porcentaje}%`} aria-hidden="true"></span>
					<span class="barra-valor">{formatoPorcentaje(rubro.porcentaje)}%</span>
				</li>
			))}
		</ul>
		<p class="inversion-titular">
			Más de la mitad (<strong>{formatoPorcentaje(rubroPrincipal.porcentaje)}%</strong>) va a
			producto digital, no a obra.
		</p>
	</div>

	<div class="inversion-monto">
		<p class="monto-total">$U {formatoUYU.format(totalEtapa1UYU)}</p>
		<p class="monto-equivalente">
			≈ USD {formatoUYU.format(equivalenteUSDEtapa1.valor)} (tipo de cambio {equivalenteUSDEtapa1.tipoDeCambio}, {fechaEquivalente}, fuente: {equivalenteUSDEtapa1.fuente})
		</p>
	</div>

	<div class="inversion-cierre">
		<h3>Qué se compra con esto: los indicadores que la Etapa 1 deja medidos</h3>
		<ul>
			{indicadoresCierre.map((indicador) => (
				<li>{indicador}</li>
			))}
		</ul>
	</div>

	<a href="mailto:" class="cta cta-primario">Solicitar el dossier completo</a>
</section>

<style>
	section {
		padding: var(--espacio-2xl) var(--espacio-md);
		display: grid;
		gap: var(--espacio-lg);
	}

	h2 {
		font-size: var(--texto-2xl);
		max-width: 22ch;
	}

	.inversion-timeline {
		display: grid;
		grid-auto-flow: column;
		gap: var(--espacio-sm);
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.etapa {
		padding: var(--espacio-sm);
		background-color: var(--color-superficie);
		border-radius: var(--radio-md);
		text-align: center;
		display: grid;
		gap: var(--espacio-2xs);
	}

	.etapa span {
		font-size: var(--texto-sm);
	}

	.etapa.destacada {
		background-color: var(--color-acento);
		color: var(--color-fondo);
		font-weight: 700;
	}

	.grafico-barras {
		display: grid;
		gap: var(--espacio-xs);
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.barra-rubro {
		display: grid;
		grid-template-columns: 12rem 1fr 4rem;
		align-items: center;
		gap: var(--espacio-sm);
	}

	.barra-etiqueta {
		font-size: var(--texto-sm);
	}

	.barra-visual {
		display: block;
		height: 0.75rem;
		border-radius: var(--radio-full);
		background-color: var(--color-acento);
		width: var(--pct);
	}

	.inversion-titular {
		font-size: var(--texto-lg);
		max-width: 40ch;
	}

	.monto-total {
		font-size: var(--texto-lg);
		font-weight: 700;
		/* Deliberadamente sobrio: no es el elemento más grande de la sección (ver plan, punto f.2). */
	}

	.monto-equivalente {
		font-size: var(--texto-sm);
	}

	.cta {
		display: inline-block;
		padding: var(--espacio-xs) var(--espacio-md);
		border-radius: var(--radio-md);
		text-decoration: none;
		font-weight: 700;
		justify-self: start;
	}

	.cta-primario {
		background-color: var(--color-acento);
		color: var(--color-fondo);
	}
</style>
