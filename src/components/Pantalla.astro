---
/**
 * Pantalla.astro — una de las 5 paradas del recorrido, mecánica "cinta" (2026-08-26, reemplaza
 * a la versión anterior "hoja que tapa y descubre" — ver base.css y la memoria del proyecto).
 *
 * Cada pantalla es una tarjeta que mide MENOS que la pantalla completa (82%, ver
 * .hz-tarjeta en base.css) — el borde de la vecina ya se asoma mientras la actual todavía está
 * completa, sin cortes duros. `completa` es la excepción: pantalla completa, sin bordes ni
 * sombra, pensada para el Hero (pega fuerte como primera impresión).
 *
 * A diferencia de la mecánica anterior, esta SÍ vive dentro de .hz-track (no fixed afuera) — es
 * más parecida en espíritu a la vieja HzSlide.astro, con el agregado de que la tarjeta no llena
 * el bloque entero. El mecanismo real (medidas intercambiadas, rotación) vive en base.css, no
 * acá — este componente solo pone la estructura.
 *
 * Ver docs/planes/2026-08-26-pivot-audiencia-general.md y la memoria del proyecto
 * (proyecto-renamu-slide-horizontal) para el porqué de esta mecánica.
 */
interface Props {
	id: string;
	completa?: boolean;
	/** true = el bloque de esta pantalla queda transparente para dejar ver la capa .fondo-fijo
	 * (foto fija al viewport, ver Base.astro). Solo Pantalla 1 lo usa hoy. */
	transparente?: boolean;
}

const { id, completa = false, transparente = false } = Astro.props;
const claseTarjeta = completa ? 'hz-tarjeta hz-tarjeta--completa' : 'hz-tarjeta';
---

<div class:list={['hz-bloque', { 'hz-bloque--transparente': transparente }]}>
	<section class={claseTarjeta} id={id}>
		<div class="hz-tarjeta__contenido">
			<slot />
		</div>
	</section>
</div>
