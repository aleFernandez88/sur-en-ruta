---
/**
 * Escenario.astro — la capa fija que nunca se desmonta (docs/planes/2026-09-22-recomposicion-
 * ui-vertical.md §14.7 paso 10 — Paso 1.3 de §5). `position: fixed; inset: 0` funciona acá porque
 * cuelga directo de `<body>` (vía Base.astro), sin ningún ancestro transformado — ese era
 * exactamente el bloqueo de `.hz-track { transform: rotate(-90deg) }` que forzó todo este
 * rediseño (§1.2).
 *
 * Dos sub-capas:
 * - `.escenario__fondo` — una por sección, superpuestas, cada una con su propia opacidad atada al
 *   `view-timeline` LOCAL de esa sección (declarado en `Seccion.astro`, visible acá gracias al
 *   `timeline-scope` de `:root`, ver base.css) — cross-fade entre fondos sin JS.
 *   **Color PLACEHOLDER** (`--color-fondo` para las 5): la paleta real por sección (§11.3 — marino-
 *   noche / oliva / negro / color de ruta que muta / arena) es contenido, se fija en el paso 17
 *   (Bloque E) junto con el resto de cada pantalla. Este paso solo prueba que el mecanismo de
 *   cross-fade funciona.
 * - `.escenario__telefono` — el celular, con UNA sola animación continua atada a
 *   `scroll(root block)` (§3.2 opción C: nunca varias animaciones sobre el mismo `transform` con
 *   `fill:both` — la última de la lista "gana" también fuera de su rango, es la trampa de la
 *   opción B, descartada). Composición del transform con custom properties registradas
 *   (`--tel-x`, `--tel-y`, `--tel-escala`, `--tel-rot`, Paso 1.3 de §5) — los `calc()` van en la
 *   declaración del `transform`, JAMÁS dentro del `@keyframes` (restricción 3 de `escenario.ts`).
 *   **Posición/escala por sección PLACEHOLDER** (`ESTADOS` acá abajo) — mismo motivo que el fondo,
 *   se afina en el paso 17.
 *
 * === Por qué la rotación 3D (P1) no es una animación aparte ===
 * `--tel-rot` viaja en LA MISMA animación que `--tel-x/--tel-y/--tel-escala` (un solo
 * `@keyframes`, un solo `animation-timeline`) — nunca vale nada fuera del rango de `que-es`
 * (arranca y termina en 0° en todas las demás secciones), así que no hace falta un segundo
 * `animation-timeline` atado a `--que-es` para "activarla solo ahí": ya sale así de los propios
 * stops. Lo que SÍ es condicional es si esa rotación se nota en pantalla: `transform` fuera de
 * `@media (pointer:fine) and (min-width:900px)` NO incluye `rotate(var(--tel-rot))` — mobile
 * nunca entra en el riesgo de iframe-en-3D de §14.1 (N1, "la rotación 3D existe solo donde tiene
 * sentido, y esto se aplica SIEMPRE, pase o falle la prueba").
 */
import Telefono from './Telefono.astro';
import { offsets } from '../lib/escenario.ts';

interface Estado {
	x: number; // %, eje X
	y: number; // %, eje Y
	escala: number;
	rot: number; // grados — solo tiene valor distinto de 0 dentro de "que-es", ver frontmatter
}

// PLACEHOLDER (ver comentario grande de arriba) — Paso 17 define los valores reales junto con el
// contenido de cada pantalla (§11.3).
const ESTADOS: Record<string, Estado> = {
	'que-es': { x: 0, y: 0, escala: 1, rot: 0 },
	'que-hace': { x: 16, y: 0, escala: 0.82, rot: 0 },
	'como-lo-hace': { x: 0, y: 0, escala: 0.72, rot: 0 },
	donde: { x: -10, y: 0, escala: 0.8, rot: 0 },
	cierre: { x: 0, y: 0, escala: 1, rot: 0 },
};

const off = offsets();

// Un stop al INICIO y otro al FIN de cada sección → plateau mientras la sección está pineada (el
// celular no se mueve mientras se lee), transición instantánea en el borde entre dos secciones
// (los dos stops comparten el mismo %, con valores distintos). Es una simplificación deliberada
// del andamiaje — Paso 17 puede angostar el plateau para suavizar el corte si hace falta, es un
// cambio de números, no de mecanismo.
const stops = off.flatMap((o) => {
	const e = ESTADOS[o.id];
	const rotDesde = o.id === 'que-es' ? -14 : e.rot;
	const rotHasta = o.id === 'que-es' ? 14 : e.rot;
	return [
		{ pct: o.desdePct, x: e.x, y: e.y, escala: e.escala, rot: rotDesde },
		{ pct: o.hastaPct, x: e.x, y: e.y, escala: e.escala, rot: rotHasta },
	];
});

const telKeyframes = `@keyframes tel-anima {
${stops
	.map(
		(s) =>
			`  ${s.pct.toFixed(3)}% { --tel-x: ${s.x}%; --tel-y: ${s.y}%; --tel-escala: ${s.escala}; --tel-rot: ${s.rot}deg; }`,
	)
	.join('\n')}
}`;

const secciones = off.map((o) => o.id);
---

<div class="escenario" aria-hidden="true">
	{secciones.map((id) => <div class="escenario__fondo" data-seccion={id} />)}
	<div class="escenario__telefono">
		<Telefono modo="vivo" />
	</div>
</div>

<style is:global set:html={telKeyframes} />

<style>
	@property --tel-x {
		syntax: '<length-percentage>';
		inherits: false;
		initial-value: 0%;
	}
	@property --tel-y {
		syntax: '<length-percentage>';
		inherits: false;
		initial-value: 0%;
	}
	@property --tel-escala {
		syntax: '<number>';
		inherits: false;
		initial-value: 1;
	}
	@property --tel-rot {
		syntax: '<angle>';
		inherits: false;
		initial-value: 0deg;
	}

	.escenario {
		position: fixed;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		/* Decorativo de punta a punta (§14.3): todo el contenido informativo vive en el copy de
		 * las secciones, nunca hace falta entrar acá — ni con foco, ni con lectores de pantalla. */
		pointer-events: none;
	}

	.escenario__fondo {
		position: absolute;
		inset: 0;
		/* PLACEHOLDER — ver comentario grande del frontmatter. */
		background: var(--color-fondo);
		opacity: 0;
	}

	/* Estado final/visible por defecto FUERA de @supports (restricción 1 de escenario.ts): sin
	 * scroll-driven animations (Firefox estable), se ve la última sección declarada — mejor que
	 * una pantalla en blanco, y de cualquier forma en ese navegador cada <Seccion> mide `auto`
	 * (ver Seccion.astro), así que el fondo fijo ya no acompaña visualmente al contenido real. */
	.escenario__fondo:last-child {
		opacity: 1;
	}

	@supports (animation-timeline: view()) {
		@keyframes escenario-fondo-crossfade {
			from {
				opacity: 0;
			}
			10% {
				opacity: 1;
			}
			90% {
				opacity: 1;
			}
			to {
				opacity: 0;
			}
		}

		.escenario__fondo {
			opacity: 0;
			animation: escenario-fondo-crossfade linear both;
			animation-range: cover 0% cover 100%;
		}
		.escenario__fondo:last-child {
			opacity: 0;
		}
	}

	/* Un selector por sección — timeline-scope de :root (base.css) los hace visibles acá aunque
	 * .escenario sea hermano de <main>, no descendiente de las <Seccion>. */
	.escenario__fondo[data-seccion='que-es'] {
		animation-timeline: --que-es;
	}
	.escenario__fondo[data-seccion='que-hace'] {
		animation-timeline: --que-hace;
	}
	.escenario__fondo[data-seccion='como-lo-hace'] {
		animation-timeline: --como-lo-hace;
	}
	.escenario__fondo[data-seccion='donde'] {
		animation-timeline: --donde;
	}
	.escenario__fondo[data-seccion='cierre'] {
		animation-timeline: --cierre;
	}

	.escenario__telefono {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		/* Base (mobile/táctil, o sin soporte): sin rotación — N1 de §14.1, siempre activo. */
		transform: translate(var(--tel-x), var(--tel-y)) scale(var(--tel-escala));
	}

	@supports (animation-timeline: scroll(root)) {
		.escenario__telefono {
			animation: tel-anima linear both;
			animation-timeline: scroll(root block);
		}
	}

	/* Rotación 3D: SOLO desktop + puntero fino (N1, §14.1) — el riesgo del iframe dentro de un
	 * transform 3D (§14.1) nunca se corre en mobile, pase lo que pase con --tel-rot. */
	@media (pointer: fine) and (min-width: 900px) {
		@supports (animation-timeline: scroll(root)) {
			.escenario__telefono {
				transform: translate(var(--tel-x), var(--tel-y)) scale(var(--tel-escala))
					rotate(var(--tel-rot));
			}
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.escenario__fondo {
			animation: none !important;
			opacity: 0;
		}
		.escenario__fondo:last-child {
			opacity: 1;
		}
		.escenario__telefono {
			animation: none !important;
			transform: none;
		}
	}
</style>

<script>
	import { iniciar } from '../lib/telefono.ts';

	// Ajusta el iframe/imagen de adentro del celular a 390px lógicos escalados al tamaño real de
	// la pantalla del marco — mismo mecanismo que ya prueba public/app-demo/showcase.html y
	// prototipos/pruebas/iframe-3d/ (Paso 2 del plan). Un solo <Telefono> activo a la vez, así que
	// un solo observer alcanza.
	const pantalla = document.querySelector<HTMLElement>('.telefono__pantalla');
	const contenido = document.querySelector<HTMLElement>('.telefono__iframe, .telefono__imagen');

	if (pantalla && contenido) {
		const ajustar = () => {
			const ancho = pantalla.clientWidth;
			if (!ancho) return;
			contenido.style.setProperty('--fit', String(ancho / 390));
		};
		new ResizeObserver(ajustar).observe(pantalla);
		ajustar();
	}

	// Comanda el demo por scroll (§14.2.a, paso 15 del plan) — solo tiene sentido en modo 'vivo'
	// (hay un iframe real del otro lado); en modo 'imagen' no hay nada que postear.
	const iframeVivo = document.querySelector<HTMLIFrameElement>('.telefono__iframe');
	if (iframeVivo) iniciar(iframeVivo);
</script>
