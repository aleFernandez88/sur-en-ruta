---
/**
 * Escenario.astro — la capa fija que nunca se desmonta (docs/planes/2026-09-22-recomposicion-
 * ui-vertical.md §14.7 paso 10 — Paso 1.3 de §5; reescrito sobre el modelo en Bloque E, E4,
 * docs/planes/2026-09-23-bloque-e-secciones-chrome.md §5). `position: fixed; inset: 0` funciona
 * acá porque cuelga directo de `<body>` (vía Base.astro), sin ningún ancestro transformado — ese
 * era exactamente el bloqueo de `.hz-track { transform: rotate(-90deg) }` que forzó todo este
 * rediseño (§1.2).
 *
 * === Qué cambia respecto de la versión de Bloque C/D (E1-E3) ===
 * Antes había 5 `.escenario__fondo` superpuestos con cross-fade por `view-timeline` LOCAL de cada
 * sección (uno de los hallazgos de Bloque E, H3: quedaba desalineado del celular). Ahora es UNA
 * sola capa: `.escenario` anima `--escenario-fondo` (un `@property <color>`) sobre
 * `scroll(root block)`, con el hex ya resuelto en build time por `escenario-keyframes.ts` — nunca
 * `var()` dentro de `@keyframes` (restricción 3). Fondo, celular y rótulo salen del mismo
 * generador y la misma tabla (`escenario.ts`), así que quedan alineados por construcción (H3
 * resuelto). La "meseta/transición" de cada sección (H2, "transición instantánea") también se
 * deriva de esa misma tabla — ver `escenario.ts` §4.2.
 *
 * === Dos sub-capas dentro de `.escenario__ancla` ===
 * - `.escenario__telefono` — el celular, con transform `scale(var(--tel-escala))`. El ANCLA
 *   (`.escenario__ancla`) es quien se traslada (`translate(var(--tel-x), var(--tel-y))`) con UNA
 *   sola animación continua atada a `scroll(root block)` (§3.2 opción C: nunca varias animaciones
 *   sobre el mismo `transform` con `fill:both` — la última de la lista "gana" también fuera de su
 *   rango, es la trampa de la opción B, descartada). Separar ancla/celular en dos elementos
 *   distintos es lo que permite que el rótulo (hermano del celular, ver abajo) también viaje con
 *   el ancla sin pelear por la misma propiedad `transform`.
 * - `.escenario__rotulo` — "Vista conceptual de la app", chrome PERMANENTE (antes vivía adentro de
 *   P1QueEs.astro como `.p1-rotulo`, con el mismo string — no se pierde contenido, se muda acá
 *   porque ahora es la misma pieza en las 5 secciones, no solo P1).
 *
 * === Por qué la rotación 3D (P1) no es una animación aparte ===
 * `--tel-rot` viaja en LA MISMA animación que `--tel-x/--tel-y/--tel-escala` (un solo
 * `@keyframes` por breakpoint, un solo `animation-timeline`) — nunca vale nada fuera del rango de
 * `que-es` (arranca y termina en 0° en todas las demás secciones), así que no hace falta un
 * segundo `animation-timeline` atado a `--que-es` para "activarla solo ahí": ya sale así de los
 * propios stops (`escenario-keyframes.ts`, `keyframesTelefono`). Lo que SÍ es condicional es si esa
 * rotación se nota en pantalla: fuera de `@media (pointer:fine) and (min-width:900px) and
 * (prefers-reduced-motion:no-preference)` NO se aplica `rotateY(var(--tel-rot))` sobre
 * `.telefono__marco` — mobile y movimiento reducido nunca entran en el riesgo de iframe-en-3D de
 * §14.1 (N1, "la rotación 3D existe solo donde tiene sentido, y esto se aplica SIEMPRE").
 * H1 (Bloque E) queda resuelto acá: antes era `rotate()` (2D, como la aguja de un reloj); ahora es
 * `perspective(1700px) rotateY()`, con `perspective` explícito.
 */
import Telefono from './Telefono.astro';
import Icono from './Icono.astro';
import tokensCss from '../styles/tokens.css?raw';
import { keyframesFondo, keyframesGlow, keyframesTelefono, parsearTokens } from '../lib/escenario-keyframes.ts';

const tokens = parsearTokens(tokensCss);
const keyframes = [
	keyframesTelefono('escritorio'),
	keyframesTelefono('movil'),
	keyframesFondo(tokens),
	keyframesGlow(),
].join('\n\n');
---

<div class="escenario" aria-hidden="true">
	<div class="escenario__glow"></div>
	<div class="escenario__ancla">
		<div class="escenario__entrada">
			<div class="escenario__telefono">
				<Telefono modo="vivo" />
			</div>
		</div>
		<p class="escenario__rotulo">
			<Icono nombre="app" tamano={12} />
			Vista conceptual de la app
		</p>
	</div>
</div>

<style is:global set:html={keyframes} />

<style>
	@property --tel-x {
		syntax: '<length-percentage>';
		inherits: true;
		initial-value: 0%;
	}
	@property --tel-y {
		syntax: '<length-percentage>';
		inherits: true;
		initial-value: 0%;
	}
	@property --tel-escala {
		syntax: '<number>';
		inherits: true;
		initial-value: 1;
	}
	@property --tel-rot {
		syntax: '<angle>';
		inherits: true;
		initial-value: 0deg;
	}
	/* Color resuelto en build time por escenario-keyframes.ts (hex literal, nunca var() dentro de
	 * @keyframes — restricción 3). El valor inicial es el fondo de "que-es", la primera sección. */
	@property --escenario-fondo {
		syntax: '<color>';
		inherits: false;
		initial-value: #050b14;
	}
	/* 0 = rótulo oscuro (sobre fondo claro/medio), 1 = rótulo claro (sobre fondo oscuro/oliva) —
	 * §4.1. Number, no boolean, porque .escenario__rotulo lo usa en un color-mix() continuo. */
	@property --rotulo-claro {
		syntax: '<number>';
		inherits: true;
		initial-value: 0;
	}

	.escenario {
		position: fixed;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		/* Decorativo de punta a punta (§14.3): todo el contenido informativo vive en el copy de
		 * las secciones, nunca hace falta entrar acá — ni con foco, ni con lectores de pantalla. */
		pointer-events: none;
		background: var(--escenario-fondo);
	}

	@supports (animation-timeline: scroll(root)) {
		.escenario {
			animation: escenario-fondo linear both;
			animation-timeline: scroll(root block);
		}
	}

	/* Glow radial de "que-es" — literal de la escena vieja de P1QueEs.astro:85, mudado acá porque
	 * ahora es chrome del escenario, no de una pantalla puntual. */
	.escenario__glow {
		position: absolute;
		inset: 0;
		background: radial-gradient(140% 100% at 50% 38%, #163a5c 0%, #0a2036 46%, #050b14 100%);
		opacity: 1;
	}

	@supports (animation-timeline: scroll(root)) {
		.escenario__glow {
			animation: escenario-glow linear both;
			animation-timeline: scroll(root block);
		}
	}

	/* `100svh`, NO `inset:0`: en iOS un `fixed` con `inset:0` cambia de alto cuando se esconde la
	 * barra de URL, y el celular cambiaría de tamaño en pleno scroll. */
	.escenario__ancla {
		position: absolute;
		left: 0;
		top: 0;
		width: 100%;
		height: 100svh;
		transform: translate(var(--tel-x), var(--tel-y));
	}

	@supports (animation-timeline: scroll(root)) {
		.escenario__ancla {
			animation: tel-escritorio linear both;
			animation-timeline: scroll(root block);
		}

		@media (width < 900px) {
			.escenario__ancla {
				animation-name: tel-movil;
			}
		}
	}

	.escenario__entrada {
		position: absolute;
		inset: 0;
	}

	.escenario__telefono {
		position: absolute;
		inset: 0;
		transform: scale(var(--tel-escala));
	}

	/* Rotación 3D: SOLO desktop + puntero fino + sin movimiento reducido (N1, §14.1) — el riesgo
	 * del iframe dentro de un transform 3D nunca se corre en mobile ni con `steps()` (§3.5),
	 * pase lo que pase con --tel-rot. H1 (Bloque E) resuelto: `perspective()` explícito +
	 * `rotateY()`, no `rotate()` (2D). */
	@media (pointer: fine) and (min-width: 900px) and (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: scroll(root)) {
			:global(.telefono__marco) {
				transform: perspective(1700px) rotateY(var(--tel-rot));
			}
		}
	}

	/* ============================================================================
	 * Entrada TEMPORAL del celular, disparada por :root.entrada — mismo mecanismo que ya usaban
	 * Hero.astro y P1QueEs.astro (`.p1-escena`, que se borra en E7: esta es su reemplazante única
	 * para las 5 secciones, no solo P1). Usa la propiedad individual `scale`, no `transform`, para
	 * no pelear con el `transform: scale(var(--tel-escala))` de `.escenario__telefono` (mismo
	 * elemento sería un problema; acá son dos elementos distintos, pero se mantiene la convención).
	 * ============================================================================ */
	@keyframes escenario-entrada-enciende {
		from {
			opacity: 0;
			scale: 1.06;
		}
		to {
			opacity: 1;
			scale: 1;
		}
	}
	:global(:root.js) .escenario__entrada {
		opacity: 0;
		scale: 1.06;
		animation: escenario-entrada-enciende 1100ms cubic-bezier(0.2, 0.7, 0.2, 1) both paused;
	}
	:global(:root.entrada) .escenario__entrada {
		animation-play-state: running;
	}

	/* ============================================================================
	 * Rótulo "Vista conceptual de la app" (§14.4) — chrome permanente, viaja con el ancla.
	 * ============================================================================ */
	.escenario__rotulo {
		position: absolute;
		left: 50%;
		top: calc(50% + 28svh * var(--tel-escala) + 0.75rem);
		translate: -50% 0;
		margin: 0;
		display: flex;
		align-items: center;
		gap: var(--espacio-2xs);
		padding: 0.3rem 0.7rem;
		border-radius: var(--radio-full);
		font: var(--texto-xs) var(--fuente-texto);
		letter-spacing: 0.02em;
		white-space: nowrap;
		opacity: 0.75;
		color: color-mix(
			in srgb,
			var(--color-tinta) calc(var(--rotulo-claro) * 100%),
			color-mix(in srgb, var(--color-texto-sobre-foto) 85%, transparent)
		);
		background: color-mix(
			in srgb,
			color-mix(in srgb, var(--color-superficie) 88%, transparent) calc(var(--rotulo-claro) * 100%),
			color-mix(in srgb, var(--color-marino-noche) 72%, transparent)
		);
		backdrop-filter: blur(6px);
		transition: opacity 200ms ease-out;
	}

	/* La pone E5 (telefono.ts): un pulso corto cuando cambia la sección activa. */
	.escenario__rotulo--pulso {
		opacity: 1;
	}

	@keyframes escenario-rotulo-entra {
		from {
			opacity: 0;
		}
		to {
			opacity: 0.75;
		}
	}
	:global(:root.js) .escenario__rotulo {
		opacity: 0;
		animation: escenario-rotulo-entra 500ms cubic-bezier(0.2, 0.7, 0.2, 1) 760ms both paused;
	}
	:global(:root.entrada) .escenario__rotulo {
		animation-play-state: running;
	}

	/* ============================================================================
	 * Movimiento reducido (§3.5 opción B, §4.5 — arregla H4): la MISMA animación de fondo/celular,
	 * sin interpolación (cada tramo de transición "salta" a la mitad) — nunca animation:none, que
	 * dejaría el fallback roto de H4 (celular clavado al centro tapando el texto) y violaría
	 * §14.3 ("reducir movimiento no es congelar el producto"). Pisa la regla global de
	 * base.css:137 (`animation-duration: 0.01ms !important`) por especificidad de clase.
	 * ============================================================================ */
	@media (prefers-reduced-motion: reduce) {
		.escenario,
		.escenario__glow,
		.escenario__ancla {
			animation-timing-function: steps(2, jump-none);
			animation-duration: auto !important;
		}
	}

	/* Sin animation-timeline (Firefox estable): el celular decorativo desaparece del todo — mejor
	 * que uno clavado al centro tapando el texto (H4). Cada <Seccion> pinta su propio fondo sólido
	 * (ver base.css, E6) y la página se lee como un sitio vertical normal (§3.4 opción B, §9 del
	 * plan padre). */
	@supports not (animation-timeline: scroll(root)) {
		.escenario__ancla,
		.escenario__glow {
			display: none;
		}
	}
</style>

<script>
	import { iniciar } from '../lib/telefono.ts';

	// Ajusta el iframe/imagen de adentro del celular a 390px lógicos escalados al tamaño real de
	// la pantalla del marco — mismo mecanismo que ya prueba public/app-demo/showcase.html y
	// prototipos/pruebas/iframe-3d/ (Paso 2 del plan). Un solo <Telefono> activo a la vez, así que
	// un solo observer alcanza.
	const pantalla = document.querySelector<HTMLElement>('.telefono__pantalla');
	const contenido = document.querySelector<HTMLElement>('.telefono__iframe, .telefono__imagen');

	if (pantalla && contenido) {
		const ajustar = () => {
			const ancho = pantalla.clientWidth;
			if (!ancho) return;
			contenido.style.setProperty('--fit', String(ancho / 390));
		};
		new ResizeObserver(ajustar).observe(pantalla);
		ajustar();
	}

	// Comanda el demo por scroll (§14.2.a, paso 15 del plan). Siempre se llama (E5, Bloque E): en
	// modo 'imagen' (fallback N3, sin iframe) `iniciar(null)` sigue haciendo pulsar el rótulo al
	// cambiar de sección, solo que no postea nada — no hay nada del otro lado que escuche.
	const iframeVivo = document.querySelector<HTMLIFrameElement>('.telefono__iframe');
	iniciar(iframeVivo ?? null);
</script>
