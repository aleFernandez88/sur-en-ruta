---
/**
 * Problema.astro — Sección 2. Tesis de riesgo bajo: la actividad ya existe, falta el sistema.
 *
 * Copy real cargado el 2026-08-24 desde docs/landing-inversores-contenido.md, verificado contra
 * el documento de propuesta original (secc. 2 y 11.1) — la cita central y el bloque de honestidad
 * son casi literales del PDF.
 *
 * Pendiente, fuera de este paso: el SVG real del mapa (paso 9 del plan) reemplaza a
 * MapaPlaceholder cuando exista, y la transformación por scroll entre los dos estados es
 * comportamiento (paso 12), no estructura.
 *
 * CartelSeccion (2026-08-24): mismo poste indicador que Hero, con el nombre "La Oportunidad" —
 * ver comentario de cabecera de src/components/CartelSeccion.astro para el porqué de la forma.
 */
import MapaPlaceholder from './MapaPlaceholder.astro';
import CartelSeccion from './CartelSeccion.astro';

const friccion = [
	'El viajero no sabe dónde parar ni qué normas rigen.',
	'Los comercios no tienen forma de captar ese público.',
	'El Estado no tiene datos para planificar.',
	'El pernocte y los residuos ocurren sin control.',
];
---

<section id="problema" aria-labelledby="problema-titulo">
	<CartelSeccion numero={2} nombre="La Oportunidad" />
	<h2 id="problema-titulo">La actividad ya existe. Lo que falta es el sistema.</h2>

	<p class="problema-tesis">
		La actividad ya existe. La oportunidad está en ordenarla, profesionalizarla, conectarla y
		medirla.
	</p>

	<div class="problema-mapa">
		<!-- TODO: mismo mapa en dos estados (hoy disperso / con la red), transformación por scroll -->
		<MapaPlaceholder etiqueta="mapa — estado hoy: puntos dispersos, sin conexión" />
		<MapaPlaceholder etiqueta="mapa — estado con la red: corredores y puntos categorizados" />
	</div>

	<ul class="problema-tarjetas">
		{friccion.map((linea) => (
			<li class="tarjeta">{linea}</li>
		))}
	</ul>

	<p class="problema-honestidad">
		El documento admite que no existe un número público nacional de motorhomes registrados en
		Uruguay. Se usa como argumento, no se esconde: <strong>hoy nadie mide esta actividad. Quien
		la ordena, la mide.</strong>
	</p>
</section>

<style>
	section {
		padding: var(--espacio-2xl) var(--espacio-md);
		display: grid;
		gap: var(--espacio-lg);
	}

	h2 {
		font-size: var(--texto-2xl);
		max-width: 20ch;
	}

	.problema-tesis {
		font-size: var(--texto-lg);
		max-width: 50ch;
	}

	.problema-mapa {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: var(--espacio-md);
	}

	.problema-tarjetas {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: var(--espacio-sm);
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.tarjeta {
		padding: var(--espacio-md);
		background-color: var(--color-superficie);
		border-radius: var(--radio-md);
	}

	.problema-honestidad {
		font-style: italic;
		max-width: 60ch;
	}
</style>
