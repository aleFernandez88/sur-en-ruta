---
/**
 * HzSlide.astro — una "parada" del recorrido horizontal. Envuelve una sección para que:
 * 1. ocupe exactamente una pantalla completa dentro de .hz-track (ver base.css), sin desbordar
 *    para ningún lado — `overflow: hidden` a propósito, cada sección tiene que entrar sola;
 * 2. cancele la rotación -90° de .hz-track (ver base.css) para que el contenido se lea derecho;
 * 3. sea un destino de scroll-snap (`scroll-snap-align: start` en la geometría LOCAL de
 *    .hz-track, que es lo que .hz-slide representa — no en .hz-slide__contenido, que ya está
 *    contrarrotado a la orientación visual normal).
 *
 * Un solo lugar para tocar la mecánica del slide horizontal — las secciones (Hero, Problema...)
 * no saben nada de rotación, solo tienen que entrar en 100vw x 100vh.
 *
 * `id` es el ancla de navegación (los cartelitos de HiloRuta van a apuntar acá con
 * `href="#id"`) — currently sin cablear, ver memoria del proyecto.
 */
interface Props {
	id: string;
}

const { id } = Astro.props;
---

<div class="hz-slide" id={id}>
	<div class="hz-slide__contenido">
		<slot />
	</div>
</div>

<style>
	.hz-slide {
		/* Medidas en el espacio LOCAL de .hz-track (antes de su propia rotación): el ancho acá
		 * equivale al alto real de pantalla, y el alto acá equivale a un "avance" de una pantalla
		 * de ancho — ver el comentario largo en base.css para la explicación completa del truco. */
		width: 100vh;
		height: 100vw;
		scroll-snap-align: start;
		scroll-snap-stop: always;
		position: relative;
	}

	.hz-slide__contenido {
		/* Contrarrota +90° para cancelar la rotación -90° de .hz-track — el tamaño (100vw x
		 * 100vh, no 100vh x 100vw) es a propósito: son las medidas ANTES de esta rotación, así que
		 * después de rotar coinciden exactas con el .hz-slide padre (mismo truco matemático que la
		 * rotación de .hz-track, aplicado en sentido inverso). */
		position: absolute;
		width: 100vw;
		height: 100vh;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%) rotate(90deg);
		overflow: hidden;
	}
</style>
