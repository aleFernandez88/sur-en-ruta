---
/**
 * Rutas.astro — Sección 4. Seis rutas temáticas + Uruguay como hub regional.
 *
 * Copy real cargado el 2026-08-24. Las 6 rutas salen de src/data/rutas.ts y las 4 ferias de
 * src/data/ferias.ts, ambos verificados contra el documento de propuesta original (secc. 4.4, 6 y
 * 6.2).
 *
 * IMPORTANTE (se mantiene desde la cáscara vacía): el rótulo obligatorio y literal sigue acá tal
 * cual lo exige el plan — sin él, el mapa insinúa una red que todavía no existe.
 *
 * También según el plan: esta sección es "la única isla interactiva" (selector de rutas,
 * hidratación client:visible). Esa interactividad no se cablea todavía — es comportamiento, no
 * estructura — y el selector queda deshabilitado con las 6 rutas reales como TODO de cableado.
 */
import MapaPlaceholder from './MapaPlaceholder.astro';
import { rutas } from '../data/rutas';
import { ferias } from '../data/ferias';
---

<section id="rutas" aria-labelledby="rutas-titulo">
	<h2 id="rutas-titulo">Seis rutas. Y una posición que ningún vecino tiene.</h2>

	<div class="rutas-mapa-interactivo">
		<!-- TODO: mapa a pantalla completa con las 6 rutas dibujables; hidratar con client:visible -->
		<MapaPlaceholder etiqueta="mapa interactivo de rutas" />

		<div class="rutas-selector" role="group" aria-label="Rutas temáticas">
			{/* TODO: cablear selección (client:visible) — hoy es solo estructura y color de trazo */}
			{rutas.map((ruta) => (
				<button type="button" disabled style={`--color-ruta: ${ruta.colorTrazo}`}>
					{ruta.nombre}
				</button>
			))}
		</div>

		<p class="rutas-rotulo">Rutas propuestas. El relevamiento territorial es parte de la Etapa 1.</p>
	</div>

	<div class="rutas-hub-regional">
		<h3>Uruguay como hub regional</h3>
		<!-- TODO: mapa del Cono Sur con Uruguay como puerta de entrada -->
		<MapaPlaceholder etiqueta="mapa del Cono Sur" />

		<p>
			Base segura para iniciar o finalizar recorridos por Sudamérica, entre Argentina y Brasil:
			un destino de escala, ordenado y preparado para el turismo itinerante internacional.
		</p>
		<p>
			Las guarderías de motorhomes suman una línea de ingreso recurrente y de estadía larga, más
			allá de la pernocta: un viajero puede dejar su unidad en Uruguay por temporadas.
		</p>

		<ul class="rutas-ferias">
			{ferias.map((feria) => (
				<li>{feria.nombre}{feria.ciudad ? `, ${feria.ciudad}` : ''} ({feria.pais})</li>
			))}
		</ul>
	</div>
</section>

<style>
	section {
		padding: var(--espacio-2xl) var(--espacio-md);
		display: grid;
		gap: var(--espacio-lg);
	}

	h2 {
		font-size: var(--texto-2xl);
		max-width: 22ch;
	}

	.rutas-mapa-interactivo {
		display: grid;
		gap: var(--espacio-sm);
	}

	.rutas-selector {
		display: flex;
		flex-wrap: wrap;
		gap: var(--espacio-xs);
	}

	.rutas-selector button {
		padding: var(--espacio-xs) var(--espacio-sm);
		border-radius: var(--radio-full);
		border: 2px solid var(--color-ruta, var(--color-tinta));
		background: transparent;
		color: var(--color-tinta);
		font: inherit;
	}

	.rutas-rotulo {
		font-size: var(--texto-sm);
		font-style: italic;
	}

	.rutas-hub-regional {
		display: grid;
		gap: var(--espacio-sm);
	}

	.rutas-ferias {
		display: flex;
		flex-wrap: wrap;
		gap: var(--espacio-sm);
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.rutas-ferias li {
		padding: var(--espacio-xs) var(--espacio-sm);
		background-color: var(--color-superficie);
		border-radius: var(--radio-sm);
	}
</style>
