---
/**
 * Marcador.astro — pin de mapa de Sur en Ruta (la fila de marcadores del board 1 de identidad).
 *
 * Gota rellena de un color de categoría con el glifo en blanco adentro. El glifo reusa el set de
 * Icono.astro (no se redibuja acá). Pensado para la sección "Mapa y servicios" y para cualquier
 * leyenda de tipos de punto.
 *
 * Uso:
 *   <Marcador nombre="ubicacion" color="var(--color-terracota)" titulo="Punto territorial" />
 *   <Marcador nombre="agua" color="var(--color-marino)" />
 */
import Icono from './Icono.astro';

interface Props {
  /** Glifo interior — cualquier clave de Icono.astro. */
  nombre: Parameters<typeof Icono>[0]['nombre'];
  /** Relleno de la gota. Default: marino. */
  color?: string;
  /** Alto del pin en px. Default 44. */
  tamano?: number;
  /** Texto accesible. Sin esto el marcador queda decorativo. */
  titulo?: string;
}

const { nombre, color = 'var(--color-marino)', tamano = 44, titulo } = Astro.props;
const glifo = Math.round(tamano * 0.36);
---

<span
  class="marcador"
  style={`--marcador-color: ${color}; --marcador-alto: ${tamano}px; --marcador-glifo: ${glifo}px`}
  role={titulo ? 'img' : undefined}
  aria-hidden={titulo ? undefined : 'true'}
  aria-label={titulo}
>
  <svg class="marcador__gota" viewBox="0 0 32 42" aria-hidden="true">
    <path
      d="M16 1.5C8 1.5 2 7.6 2 15.6 2 26 16 40.5 16 40.5S30 26 30 15.6C30 7.6 24 1.5 16 1.5Z"
    ></path>
  </svg>
  <span class="marcador__glifo"><Icono nombre={nombre} tamano={glifo} /></span>
</span>

<style>
  .marcador {
    position: relative;
    display: inline-block;
    width: calc(var(--marcador-alto) * 0.762);
    height: var(--marcador-alto);
    line-height: 0;
  }

  .marcador__gota {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 2px 3px rgba(15, 43, 77, 0.28));
  }

  .marcador__gota path {
    fill: var(--marcador-color);
  }

  /* Glifo blanco, centrado en el bulbo de la gota (≈ 37% del alto). */
  .marcador__glifo {
    position: absolute;
    top: 37%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: #fff;
  }
</style>
