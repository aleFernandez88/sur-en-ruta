---
/**
 * Lamina.astro — shell de las pantallas que siguen el mazo de Ana (ver docs/landing-contenido.md).
 * Se arma por partes, guiado por Ale. Estado actual (2026-08-28):
 *   1. Fondo claro cálido (--color-fondo), a pantalla completa.
 *   2. Footer con **degradé animado** (--color-marino-noche → --color-marino → --color-celeste,
 *      ver más abajo) con el **borde superior ondulado y CONTINUO entre pantallas**. Pedido de
 *      Ale (2026-08-28): dinamismo en el COLOR, no en la forma de la onda (esa sigue igual).
 *
 * Cómo es continuo: la onda es UNA sola función `banda(x)` definida sobre el ancho de todas las
 * pantallas del mazo. Cada lámina recibe su `indice` y dibuja solo su tramo `[indice, indice+1]`.
 * La pantalla vecina evalúa la misma función en el límite → la altura coincide exacto, la costura
 * es invisible. Sin llevar cuenta a mano.
 *
 * Todavía NO tiene: textura topo, línea de ruta con nodos, isotipo, eyebrow de puntos.
 * Se agregan en pasos siguientes.
 *
 * Va dentro de <Pantalla completa> en index.astro.
 *
 * === Foto lateral con corte en curva S (2026-08-28) ===
 * Slot opcional `foto` — no todas las pantallas del mazo llevan foto (la de "¿Qué es RENAMU?" es
 * más esquema que foto, ver docs/landing-contenido.md). Si no se pasa nada al slot, no se renderiza
 * el contenedor (Astro.slots.has, ver abajo) — así no queda un recorte vacío en las que no la usan.
 * El corte es UNA sola curva S (pedido de Ale: "curva", no varias ondas) hecha con clip-path +
 * <clipPath clipPathUnits="objectBoundingBox">, en fracciones 0–1 — a diferencia del viewBox de la
 * onda del footer (que necesita userSpaceOnUse + recalculo por JS para que los círculos salgan
 * redondos, ver HiloRuta), acá no hay nada que deba salir "redondo": una curva un poco estirada de
 * más en un eje no se nota, así que objectBoundingBox (se adapta solo al tamaño real, sin JS) alcanza.
 *
 * === Parallax de la foto (2026-08-28) ===
 * La foto se mueve más lento/rápido que el scroll mientras esta pantalla está en pantalla, usando
 * el mismo scroll-timeline compartido `--hz-progreso` que ya usa HiloRuta (scope en `body`, ver
 * base.css) — no uno nuevo. Como esa timeline recorre TODO el recorrido (todas las Pantallas), hay
 * que decirle a esta lámina en qué tramo (%) vive ELLA, si no el parallax se dispara en cualquier
 * otro momento del scroll. Prop `ventanaScroll` — OJO, gotcha real: en pantallas `completa` la
 * mecánica "cinta" NO tiene pausa/settle, la tarjeta se desliza 1:1 con el scroll TODO el tiempo.
 * Hay un instante EXACTO donde queda centrada (medido con getBoundingClientRect en varios %, no
 * con la fórmula de "N bloques iguales" — esa da un punto de partida, no el real) y se mantiene
 * sustancialmente visible (>60-80% del viewport) en un rango alrededor de ese instante. Hoy
 * [18, 34] para Pantalla 1 (centrada en 26%, visible ~17%–35%). OJO: esto se recalcula cuando el
 * esqueleto deje de tener 5 pantallas iguales (el plan real es ~10) — siempre en vivo, no a ojo.
 */
interface Props {
  /** Posición de esta pantalla entre las del mazo (0 = primera). Fija la fase de la onda. */
  indice?: number;
  /** % [inicio, fin] de --hz-progreso en que ESTA pantalla está en foco, para el parallax de la
   * foto. Ver nota de arriba — default asume la 2ª de 5 pantallas iguales, ajustado en vivo. */
  ventanaScroll?: [number, number];
}
const { indice = 0, ventanaScroll = [18, 34] } = Astro.props;
const [ventanaDesde, ventanaHasta] = ventanaScroll;
const tieneFoto = Astro.slots.has('foto');

/* Onda del footer — spec de Ale (2026-08-27):
 *  - En el borde de la pantalla (la costura) el navy tiene BASE px de alto.
 *  - De ahí sube a una cresta, después baja a un valle: UNA subida y UNA bajada por pantalla.
 *  - Al final vuelve a subir y el borde derecho de la pantalla la corta EN LA MITAD de esa
 *    subida — que es justo la altura BASE otra vez → engancha con la pantalla siguiente.
 * Es un período de seno completo por pantalla con fase 0 (cruce ascendente en cada costura).
 * Todas las pantallas dibujan la misma forma; las costuras coinciden exacto. `indice` no cambia
 * la forma (seno entero) pero se deja por si algún día se quiere que derive. */
const BASE = 100; // px — alto del navy en la costura
const AMP = 42; // px — cuánto sube/baja respecto de BASE
const AIRE = 14; // px — margen arriba de la cresta
const ALTO = BASE + AMP + AIRE; // alto del <svg>/footer en px

const alto = (t: number): number => BASE + AMP * Math.sin(2 * Math.PI * (indice + t));
const yv = (t: number): string => (ALTO - alto(t)).toFixed(2);

const N = 44;
let d = `M 0 ${yv(0)}`;
for (let k = 1; k <= N; k++) {
  d += ` L ${((k / N) * 100).toFixed(2)} ${yv(k / N)}`;
}
d += ` L 100 ${ALTO} L 0 ${ALTO} Z`;
---

<div class="lamina" style={`--footer-alto: ${ALTO}px`}>
  {tieneFoto && (
    <div class="lamina__foto">
      <svg width="0" height="0" aria-hidden="true">
        <defs>
          <clipPath id={`lamina-foto-recorte-${indice}`} clipPathUnits="objectBoundingBox">
            <path d="M0.4,0 C0.05,0.33 0.65,0.67 0.3,1 L1,1 L1,0 Z" />
          </clipPath>
        </defs>
      </svg>
      <div
        class="lamina__foto-recorte"
        style={`clip-path: url(#lamina-foto-recorte-${indice}); --ventana-desde: ${ventanaDesde}%; --ventana-hasta: ${ventanaHasta}%`}
      >
        <slot name="foto" />
      </div>
    </div>
  )}
  <div class="lamina__cuerpo">
    <slot />
  </div>
  <footer class="lamina__footer" aria-hidden="true">
    <svg class="lamina__onda" viewBox={`0 0 100 ${ALTO}`} preserveAspectRatio="none">
      <defs>
        <linearGradient
          id={`lamina-degrade-${indice}`}
          gradientUnits="userSpaceOnUse"
          x1="0"
          y1={ALTO}
          x2="100"
          y2="0"
        >
          <stop class="lamina__stop lamina__stop--1" offset="0%" style="stop-color: var(--color-marino-noche)" />
          <stop class="lamina__stop lamina__stop--2" offset="50%" style="stop-color: var(--color-marino)" />
          <stop class="lamina__stop lamina__stop--3" offset="100%" style="stop-color: var(--color-celeste)" />
        </linearGradient>
      </defs>
      <path d={d} fill={`url(#lamina-degrade-${indice})`}></path>
    </svg>
    <div class="lamina__footer-contenido"><slot name="footer" /></div>
  </footer>
</div>

<style>
  .lamina {
    position: relative;
    height: 100%;
    background-color: var(--color-fondo);
    color: var(--color-tinta);
    overflow: hidden;
  }

  .lamina__cuerpo {
    position: relative;
    z-index: 1;
    height: 100%;
    /* Deja libre la zona del footer (incluida la cresta de la onda) para que el contenido no
     * quede tapado. --footer-alto lo fija el componente (px). */
    padding: clamp(3rem, 8vh, 5.5rem) clamp(1.5rem, 5vw, 4rem)
      calc(var(--footer-alto) + clamp(1rem, 3vh, 2rem));
  }

  /* Foto lateral: pegada al borde derecho/superior de LA LÁMINA entera (no de .lamina__cuerpo,
   * que tiene su propio padding) — por eso es hermana de .lamina__cuerpo, no hija. z-index 0:
   * siempre detrás del texto. Baja hasta el borde de ABAJO (bottom:0, no var(--footer-alto)) —
   * pasa por detrás del footer a propósito: el footer tiene z-index 2 (más que la foto), así que
   * donde se superponen gana el footer, sin necesidad de recortar la foto arriba de esa línea. */
  .lamina__foto {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 50%;
    z-index: 0;
  }

  .lamina__foto-recorte {
    width: 100%;
    height: 100%;
  }

  .lamina__foto-recorte :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* scale(1.15) de base: le da a la foto margen de sobra para que la traslación del parallax
     * (±1.5%, ver @keyframes) nunca deje ver un borde vacío dentro del recorte en curva S. */
    transform: scale(1.15);
  }

  /* Parallax (2026-08-28): la foto se traslada dentro de su propio recorte mientras esta pantalla
   * está en foco — usa --hz-progreso (el mismo scroll-timeline que ya comparte HiloRuta, scope en
   * `body`, ver base.css), acotado a la ventana de ESTA pantalla vía animation-range con las
   * variables --ventana-desde/--ventana-hasta (puestas en el wrapper, ver arriba). */
  @supports (animation-timeline: scroll(root)) {
    .lamina__foto-recorte :global(img) {
      animation: lamina-foto-parallax linear both;
      animation-timeline: --hz-progreso;
      animation-range: var(--ventana-desde) var(--ventana-hasta);
    }
  }

  /* Horizontal, no vertical (2026-08-28, pedido de Ale) — sigue el mismo sentido que la cinta:
   * a medida que avanza el scroll, las pantallas se van hacia la IZQUIERDA (la nueva entra por la
   * derecha), así que la foto también deriva de derecha a izquierda (empieza corrida a la
   * derecha, termina corrida a la izquierda) — mismo sentido de flujo que el resto del sitio.
   * ±1.5% (no ±6%, 2026-08-28): pedido de Ale de que la foto quede "pegada al fondo", casi fija,
   * con apenas un roce de movimiento — no un desplazamiento notorio. */
  @keyframes lamina-foto-parallax {
    from {
      transform: scale(1.15) translateX(1.5%);
    }
    to {
      transform: scale(1.15) translateX(-1.5%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lamina__foto-recorte :global(img) {
      animation: none !important;
      transform: scale(1.15);
    }
  }

  .lamina__footer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    height: var(--footer-alto);
  }

  .lamina__onda {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .lamina__footer-contenido {
    position: relative;
    z-index: 1;
    height: 100%;
  }

  /* === Degradé animado del footer (2026-08-28, pedido de Ale) ===
   * Dinamismo en el COLOR, no en la forma de la onda. Técnica: en vez de animar la POSICIÓN o
   * geometría del degradé (gradientTransform sobre un <linearGradient> no es fiable vía CSS entre
   * navegadores), se anima el `stop-color` de cada <stop> por separado — es una propiedad CSS real
   * y animable. Los 3 stops recorren la MISMA paleta de 3 colores pero desfasados 1/3 de ciclo
   * entre sí (-6s / -12s de animation-delay sobre un ciclo de 18s) — mientras uno pasa de oscuro a
   * marino, otro pasa de marino a celeste, y el tercero de celeste a oscuro: da sensación de flujo
   * continuo sin mover ningún punto en el espacio. */
  @keyframes lamina-degrade-1 {
    0%,
    100% {
      stop-color: var(--color-marino-noche);
    }
    50% {
      stop-color: var(--color-marino);
    }
  }

  @keyframes lamina-degrade-2 {
    0%,
    100% {
      stop-color: var(--color-marino);
    }
    50% {
      stop-color: var(--color-celeste);
    }
  }

  @keyframes lamina-degrade-3 {
    0%,
    100% {
      stop-color: var(--color-celeste);
    }
    50% {
      stop-color: var(--color-marino-noche);
    }
  }

  .lamina__stop--1 {
    animation: lamina-degrade-1 18s ease-in-out infinite;
  }

  .lamina__stop--2 {
    animation: lamina-degrade-2 18s ease-in-out infinite;
    animation-delay: -6s;
  }

  .lamina__stop--3 {
    animation: lamina-degrade-3 18s ease-in-out infinite;
    animation-delay: -12s;
  }

  /* Reduced motion: el estado "0%" de cada keyframe YA es un degradé estático correcto (oscuro →
   * marino → celeste), así que apagar la animación alcanza — no hace falta redeclarar colores. */
  @media (prefers-reduced-motion: reduce) {
    .lamina__stop--1,
    .lamina__stop--2,
    .lamina__stop--3 {
      animation: none;
    }
  }
</style>
