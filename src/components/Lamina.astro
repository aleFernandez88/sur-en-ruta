---
/**
 * Lamina.astro — shell de las pantallas que siguen el mazo de Ana (ver docs/landing-contenido.md).
 * Se arma por partes, guiado por Ale. Estado actual (2026-08-28):
 *   1. Fondo claro cálido (--color-fondo), a pantalla completa.
 *   2. Footer con **degradé VERTICAL animado** (--color-marino-noche abajo → --color-marino →
 *      --color-celeste arriba, ver más abajo) con el **borde superior ondulado y CONTINUO entre
 *      pantallas**. Pedido de Ale (2026-08-28): dinamismo en el COLOR, no en la forma de la onda.
 *      El degradé es vertical (no diagonal) a propósito, 2026-08-31: así el color es idéntico a lo
 *      ancho y no hay escalón en la costura entre pantallas (ver el <linearGradient>).
 *
 * Cómo es continuo: la onda es UNA sola función `banda(x)` definida sobre el ancho de todas las
 * pantallas del mazo. Cada lámina recibe su `indice` y dibuja solo su tramo `[indice, indice+1]`.
 * La pantalla vecina evalúa la misma función en el límite → la altura coincide exacto, la costura
 * es invisible. Sin llevar cuenta a mano.
 *
 * Todavía NO tiene: textura topo, línea de ruta con nodos, isotipo, eyebrow de puntos.
 * Se agregan en pasos siguientes.
 *
 * Va dentro de <Pantalla completa> en index.astro.
 *
 * === Fondo beige recortado + foto FIJA por detrás (2026-08-28) ===
 * Pedido de Ale: "la foto 100% fija, fixed, que todo el sitio se mueva". La foto NO vive acá —
 * vive en la capa `.fondo-fijo` de Base.astro (fuera de `.hz-track`, ver ahí; un `position: fixed`
 * dentro de la cinta quedaría relativo al ancestro rotado). Lo que hace ESTA lámina es dejar su
 * mitad derecha TRANSPARENTE para que esa foto fija se vea por detrás: el fondo beige
 * (`--color-fondo`) ya no llena toda la lámina, es un panel `.lamina__fondo` recortado en curva S
 * a la IZQUIERDA. Beige + texto + footer se siguen deslizando con la cinta; solo la foto queda
 * quieta, y el panel beige la va "descubriendo" a medida que se corre.
 *
 * El corte es UNA sola curva S (pedido de Ale: "curva", no varias ondas) con clip-path +
 * `clipPathUnits="objectBoundingBox"` en fracciones 0–1 — es exactamente la curva de antes
 * (`M0.4,0 C0.05,0.33 0.65,0.67 0.3,1` sobre un contenedor al 50%) pero mapeada a ancho completo
 * (×0.5 + 0.5) y quedándose con la MITAD IZQUIERDA en vez de la derecha. objectBoundingBox se
 * adapta solo al tamaño real sin JS; una curva un poco estirada de más en un eje no se nota.
 */
interface Props {
  /** Posición de esta pantalla entre las del mazo (0 = primera). Fija la fase de la onda. */
  indice?: number;
  /** true = esta lámina tiene una foto FIJA por detrás (capa .fondo-fijo de Base.astro): el fondo
   * beige pasa a ser un panel recortado en curva S a la izquierda y la mitad derecha queda
   * transparente para dejarla ver. false (default) = fondo beige lleno, como el resto. */
  fondoRecortado?: boolean;
  /** Distribución del contenido dentro de la lámina.
   *  - 'centrado' (default): el bloque se centra en los dos ejes del espacio disponible (portada).
   *  - 'columna': alineado arriba-izquierda y crece hacia abajo — para las pantallas de contenido
   *    denso del mazo (título + bloques + chips + cierre ocupan toda la columna). */
  distribucion?: 'centrado' | 'columna';
  /** true = agrega la cuña diagonal ondulada que se funde con el navy del footer (Pantalla 3,
   * 2026-09-01, pedido de Ale) — clara arriba-izquierda, navy abajo-derecha. Independiente de
   * `fondoRecortado` (ese es el corte-S para una foto fija; esto es una pieza de color propia,
   * sin foto). Ver el comentario largo más abajo, antes de `DIAG_TOPE_IZQ`. */
  fondoDiagonal?: boolean;
}
const {
  indice = 0,
  fondoRecortado = false,
  distribucion = 'centrado',
  fondoDiagonal = false,
} = Astro.props;

/* Onda del footer — spec de Ale (2026-08-27):
 *  - En el borde de la pantalla (la costura) el navy tiene BASE px de alto.
 *  - De ahí sube a una cresta, después baja a un valle: UNA subida y UNA bajada por pantalla.
 *  - Al final vuelve a subir y el borde derecho de la pantalla la corta EN LA MITAD de esa
 *    subida — que es justo la altura BASE otra vez → engancha con la pantalla siguiente.
 * Es un período de seno completo por pantalla con fase 0 (cruce ascendente en cada costura).
 * Todas las pantallas dibujan la misma forma; las costuras coinciden exacto. `indice` no cambia
 * la forma (seno entero) pero se deja por si algún día se quiere que derive. */
const BASE = 100; // px — alto del navy en la costura
const AMP = 42; // px — cuánto sube/baja respecto de BASE
const AIRE = 14; // px — margen arriba de la cresta
const ALTO = BASE + AMP + AIRE; // alto del <svg>/footer en px

const alto = (t: number): number => BASE + AMP * Math.sin(2 * Math.PI * (indice + t));
const yv = (t: number): string => (ALTO - alto(t)).toFixed(2);

const N = 44;
let d = `M 0 ${yv(0)}`;
for (let k = 1; k <= N; k++) {
  d += ` L ${((k / N) * 100).toFixed(2)} ${yv(k / N)}`;
}
d += ` L 100 ${ALTO} L 0 ${ALTO} Z`;

/* === Cuña diagonal ondulada (prop `fondoDiagonal`, 2026-09-01) ===
 * A diferencia de la onda de arriba (banda FIJA de `ALTO` px), esta cuña ocupa TODA la altura de
 * la lámina en fracciones 0-100 (`viewBox="0 0 100 100"` + `preserveAspectRatio="none"`, mismo
 * truco que `.lamina__onda` pero sin depender de un alto fijo en px — a la lámina no le queda un
 * alto fijo como al footer). Clara arriba-izquierda, se mezcla con el navy del footer
 * abajo-derecha: el borde de arriba de la cuña es una diagonal (sube de izq a der) con un ripple
 * senoidal encima ("unas ondas", pedido de Ale) — mismo espíritu que la onda del footer, pendiente
 * en vez de plana. El relleno reusa el MISMO degradé animado del footer: el `<linearGradient>` es
 * propio (id distinto, para no chocar con el del footer) pero sus `<stop>` llevan las MISMAS
 * clases `.lamina__stop--1/2/3` — las `@keyframes lamina-degrade-1/2/3` animan por CLASE, no por
 * instancia de SVG, así que quedan sincronizados con el footer real sin duplicar la animación. El
 * borde inferior de la cuña (y=100, toda la base) queda detrás del `<footer>` real (z-index 2,
 * pinta encima) — ahí está la costura invisible. */
const DIAG_TOPE_IZQ = 95; // % de alto del borde arriba en x=0 — casi todo claro
const DIAG_TOPE_DER = 30; // % de alto del borde arriba en x=100 — el navy sube mucho acá
const DIAG_ONDA_AMP = 3.5;
const DIAG_ONDA_FRECUENCIA = 2.5; // ciclos completos de la ondulación a lo ancho
const diagY = (t: number): number =>
  DIAG_TOPE_IZQ -
  (DIAG_TOPE_IZQ - DIAG_TOPE_DER) * t +
  DIAG_ONDA_AMP * Math.sin(2 * Math.PI * DIAG_ONDA_FRECUENCIA * t);
let dDiagonal = `M 0 ${diagY(0).toFixed(2)}`;
for (let k = 1; k <= N; k++) {
  dDiagonal += ` L ${((k / N) * 100).toFixed(2)} ${diagY(k / N).toFixed(2)}`;
}
dDiagonal += ` L 100 100 L 0 100 Z`;
---

<div
  class:list={[
    'lamina',
    { 'lamina--fondo-recortado': fondoRecortado, 'lamina--columna': distribucion === 'columna' },
  ]}
  style={`--footer-alto: ${ALTO}px`}
>
  {fondoRecortado && (
    <div class="lamina__fondo" style={`clip-path: url(#lamina-fondo-recorte-${indice})`}>
      <svg width="0" height="0" aria-hidden="true">
        <defs>
          <clipPath id={`lamina-fondo-recorte-${indice}`} clipPathUnits="objectBoundingBox">
            <path d="M0,0 L0.7,0 C0.525,0.33 0.825,0.67 0.65,1 L0,1 Z" />
          </clipPath>
        </defs>
      </svg>
    </div>
  )}
  {fondoDiagonal && (
    <svg class="lamina__diagonal" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient
          id={`lamina-diagonal-degrade-${indice}`}
          gradientUnits="userSpaceOnUse"
          x1="0"
          y1="100"
          x2="0"
          y2="0"
        >
          <stop class="lamina__stop lamina__stop--1" offset="0%" style="stop-color: var(--color-marino-noche)" />
          <stop class="lamina__stop lamina__stop--2" offset="50%" style="stop-color: var(--color-marino)" />
          <stop class="lamina__stop lamina__stop--3" offset="100%" style="stop-color: var(--color-celeste)" />
        </linearGradient>
      </defs>
      <path d={dDiagonal} fill={`url(#lamina-diagonal-degrade-${indice})`}></path>
    </svg>
  )}
  <div class="lamina__cuerpo">
    <slot />
  </div>
  {Astro.slots.has('galeria') && (
    <div class="lamina__galeria">
      <slot name="galeria" />
    </div>
  )}
  <footer class="lamina__footer" aria-hidden="true">
    <svg class="lamina__onda" viewBox={`0 0 100 ${ALTO}`} preserveAspectRatio="none">
      <defs>
        {/* VERTICAL (x1==x2), no diagonal — 2026-08-31. Con el degradé diagonal (x2=100) cada
           footer tenía su propia rampa izquierda→derecha, así que en la costura entre pantallas
           el borde derecho de una (claro) chocaba con el borde izquierdo de la siguiente (oscuro):
           un escalón de color visible, y la Pantalla 2 "empezaba" su degradé de cero. Vertical: el
           color solo varía de abajo (stop 1) a arriba (stop 3), es idéntico a lo ancho, y como las
           animaciones de los 3 stops arrancan en el load y son iguales en todas las láminas, la
           costura queda invisible — el footer se lee como UNA banda continua. */}
        <linearGradient
          id={`lamina-degrade-${indice}`}
          gradientUnits="userSpaceOnUse"
          x1="0"
          y1={ALTO}
          x2="0"
          y2="0"
        >
          <stop class="lamina__stop lamina__stop--1" offset="0%" style="stop-color: var(--color-marino-noche)" />
          <stop class="lamina__stop lamina__stop--2" offset="50%" style="stop-color: var(--color-marino)" />
          <stop class="lamina__stop lamina__stop--3" offset="100%" style="stop-color: var(--color-celeste)" />
        </linearGradient>
      </defs>
      <path d={d} fill={`url(#lamina-degrade-${indice})`}></path>
    </svg>
    <div class="lamina__footer-contenido"><slot name="footer" /></div>
  </footer>
</div>

<style>
  .lamina {
    position: relative;
    height: 100%;
    background-color: var(--color-fondo);
    color: var(--color-tinta);
    overflow: hidden;
  }

  /* Con foto fija por detrás: la lámina no pinta fondo propio — lo hace .lamina__fondo, recortado
   * a la izquierda. La mitad derecha queda transparente → se ve la capa .fondo-fijo de Base.astro
   * (que es opaca por debajo, atravesando .hz-tarjeta--completa, que no tiene fondo). */
  .lamina--fondo-recortado {
    background-color: transparent;
  }

  .lamina__fondo {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-color: var(--color-fondo);
  }

  /* Cuña diagonal (prop `fondoDiagonal`) — z-index 0, mismo nivel que `.lamina__fondo` pero
   * declarada DESPUÉS en el DOM, así pinta encima del beige plano y por debajo de
   * `.lamina__cuerpo` (z-index 1, siempre arriba sin importar el orden). */
  .lamina__diagonal {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Sin soporte de scroll-driven / movimiento reducido, la capa .fondo-fijo queda invisible
   * (opacidad 0, ver index.astro) — sacar el recorte para que el beige llene la lámina y no se
   * vea una curva "a la nada" (la mitad derecha mostraría el fondo del body, mismo color pero con
   * la costura del clip-path marcada). */
  @media (prefers-reduced-motion: reduce) {
    .lamina__fondo {
      clip-path: none !important;
    }
  }

  .lamina__cuerpo {
    position: relative;
    z-index: 1;
    height: 100%;
    /* El contenido se centra en el espacio disponible (los dos ejes) en vez de anclarse
     * arriba-izquierda — en monitores grandes, anclado, quedaba un aire muerto enorme entre el
     * texto y el borde. `align-content: center` = centrado vertical; `justify-items: center` =
     * centrado horizontal del bloque de contenido (que toma el ancho de su línea más ancha).
     * Deja libre la zona del footer (cresta de la onda incluida) con el padding inferior;
     * --footer-alto lo fija el componente (px). */
    display: grid;
    /* `minmax(0, 1fr)` explícito (2026-09-01) — sin esto, la única columna del grid se
     * autodimensiona por el contenido más ancho (comportamiento "auto" de grid), no por el
     * espacio disponible. Sin problema mientras todo el contenido era más angosto que la lámina,
     * pero P3 con `width: 100%` en `.op-chips`/`.op-bloques` (pedido de Ale: "las cards de lado a
     * lado") entraba en un círculo: el 100% se resolvía contra un track que a su vez se agrandaba
     * para hacerle lugar al 100% — la card 6 terminaba desbordando la lámina entera (invisible,
     * cortada por el `overflow:hidden`). Acotando el track a `minmax(0, 1fr)` el 100% pasa a
     * resolverse contra el espacio real. */
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    justify-items: center;
    padding: clamp(2rem, 5vh, 3.5rem) clamp(1.5rem, 5vw, 4rem)
      calc(var(--footer-alto) + clamp(1rem, 3vh, 2rem));
  }

  /* Con foto fija a la derecha: la zona útil es solo la franja beige (izquierda de la curva S
   * de .lamina__fondo, que llega a ~x=62–67% según la altura). Se reserva esa franja a la
   * derecha y el bloque se centra en lo que queda — así queda en el medio del beige, no pegado
   * al borde. El `min()` evita que en pantallas más chicas la franja de texto baje de ~50rem
   * (ancho de "SUR EN RUTA" + margen) y el título tenga que partirse. Por debajo de 1200px se
   * desactiva el reservado (ver más abajo): ahí ya no sobra espacio para centrar. */
  .lamina--fondo-recortado .lamina__cuerpo {
    padding-right: min(36vw, 100vw - 50rem);
  }

  @media (max-width: 1200px) {
    .lamina--fondo-recortado .lamina__cuerpo {
      justify-items: start;
      padding-right: clamp(1.5rem, 5vw, 4rem);
    }
  }

  /* Contenido en columna (pantallas de contenido denso del mazo): arriba-izquierda, crece hacia
   * abajo. Se DESPEGA del borde izquierdo (ahí vive HiloRuta, la barra de nav) y se RESERVA la
   * franja derecha para las foto-cards del mazo — así el contenido queda en el medio-izquierda, no
   * encimado con el nav ni con las fotos.
   *
   * `pointer-events: none` (2026-09-01) — aunque el `padding-right` deja esa franja derecha SIN
   * contenido visible, la caja de `.lamina__cuerpo` sigue ocupando ese espacio (z-index 1, por
   * ENCIMA de `.lamina__galeria`, z-index 0) y de forma invisible se comía el mouse: el hover-zoom
   * de las foto-cards nunca se disparaba porque el puntero nunca llegaba a tocarlas. Como hoy el
   * contenido de esta columna es todo texto no interactivo (sin links/botones), apagar el puntero
   * acá es seguro — si en algún momento se agrega algo clickeable adentro, esa pieza puntual
   * necesita su propio `pointer-events: auto`. */
  .lamina--columna .lamina__cuerpo {
    align-content: start;
    justify-items: start;
    padding-left: clamp(2.5rem, 8vw, 7rem);
    /* Reservado para la galería de foto-cards SOLO si esta lámina realmente tiene una — sin
     * galería (P3, "esquema" sin fotos), dejar la franja grande vacía por las dudas iba en contra
     * de "el contenido que se oriente al medio" (pedido de Ale 2026-09-01): con `:has()` el
     * padding se reduce solo, sin necesitar un prop nuevo ni tocar P1/P2. */
    padding-right: clamp(2.5rem, 8vw, 7rem);
    pointer-events: none;
  }

  .lamina--columna:has(.lamina__galeria) .lamina__cuerpo {
    padding-right: min(42vw, 100vw - 44rem);
  }

  @media (max-width: 1100px) {
    .lamina--columna .lamina__cuerpo {
      padding-left: clamp(2rem, 6vw, 4rem);
      padding-right: clamp(1.5rem, 5vw, 4rem);
    }
  }

  /* Zona de foto-cards del mazo — pegada al borde derecho de la lámina, sangra por ahí (la
   * lámina tiene overflow:hidden). z-index 0: por debajo del contenido de texto (.lamina__cuerpo
   * es z-index 1). El contenido en columna ya reserva su franja con padding-right, así que no se
   * enciman. */
  .lamina__galeria {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(46vw, 100vw - 40rem);
    z-index: 0;
  }

  @media (max-width: 1100px) {
    .lamina__galeria {
      display: none;
    }
  }

  .lamina__footer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    height: var(--footer-alto);
  }

  .lamina__onda {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .lamina__footer-contenido {
    position: relative;
    z-index: 1;
    height: 100%;
  }

  /* === Degradé animado del footer (2026-08-28, pedido de Ale) ===
   * Dinamismo en el COLOR, no en la forma de la onda. Técnica: en vez de animar la POSICIÓN o
   * geometría del degradé (gradientTransform sobre un <linearGradient> no es fiable vía CSS entre
   * navegadores), se anima el `stop-color` de cada <stop> por separado — es una propiedad CSS real
   * y animable. Los 3 stops recorren la MISMA paleta de 3 colores pero desfasados 1/3 de ciclo
   * entre sí (-6s / -12s de animation-delay sobre un ciclo de 18s) — mientras uno pasa de oscuro a
   * marino, otro pasa de marino a celeste, y el tercero de celeste a oscuro: da sensación de flujo
   * continuo sin mover ningún punto en el espacio. */
  @keyframes lamina-degrade-1 {
    0%,
    100% {
      stop-color: var(--color-marino-noche);
    }
    50% {
      stop-color: var(--color-marino);
    }
  }

  @keyframes lamina-degrade-2 {
    0%,
    100% {
      stop-color: var(--color-marino);
    }
    50% {
      stop-color: var(--color-celeste);
    }
  }

  @keyframes lamina-degrade-3 {
    0%,
    100% {
      stop-color: var(--color-celeste);
    }
    50% {
      stop-color: var(--color-marino-noche);
    }
  }

  .lamina__stop--1 {
    animation: lamina-degrade-1 18s ease-in-out infinite;
  }

  .lamina__stop--2 {
    animation: lamina-degrade-2 18s ease-in-out infinite;
    animation-delay: -6s;
  }

  .lamina__stop--3 {
    animation: lamina-degrade-3 18s ease-in-out infinite;
    animation-delay: -12s;
  }

  /* Reduced motion: el estado "0%" de cada keyframe YA es un degradé estático correcto (oscuro →
   * marino → celeste), así que apagar la animación alcanza — no hace falta redeclarar colores. */
  @media (prefers-reduced-motion: reduce) {
    .lamina__stop--1,
    .lamina__stop--2,
    .lamina__stop--3 {
      animation: none;
    }
  }
</style>
