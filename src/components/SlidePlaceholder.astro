---
/**
 * SlidePlaceholder.astro — relleno descartable para armar el esqueleto de slides horizontales
 * antes de cargar el contenido real de cada una (2026-08-25, migración a slide horizontal).
 *
 * Se reemplaza sección por sección por el componente real correspondiente (Problema.astro,
 * Sistema.astro partido en dos, etc.) a medida que ese contenido se recorta para entrar en una
 * sola pantalla — ver la nota de cabecera de src/pages/index.astro. No es parte del diseño final.
 *
 * `color` reusa a propósito los tokens --color-ruta-* (tokens.css) que hoy están sin usar en
 * ningún lado más que como asignación de las 6 rutas temáticas: son colores ya pensados para
 * distinguirse entre sí, evita inventar hex sueltos para algo temporal.
 */
interface Props {
	color: string;
	etiqueta: string;
}

const { color, etiqueta } = Astro.props;
---

<div class="placeholder" style={`background-color: ${color}`}>
	<p>{etiqueta}</p>
</div>

<style>
	.placeholder {
		width: 100%;
		height: 100%;
		display: grid;
		place-items: center;
		padding: var(--espacio-md);
	}

	.placeholder p {
		color: #fff;
		font-family: var(--fuente-titular);
		font-size: var(--texto-xl);
		font-weight: 700;
		text-align: center;
		max-width: 30ch;
	}
</style>
